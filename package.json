{
  "description": "Complete portfolio cum personal website solution for your digital personality.",
  "engines": {
    "node": ">=24.15.0"
  },
  "homepage": "https://soymadip.github.io/portosaur",
  "license": "GPL-3.0-only",
  "name": "portosaur",
  "packageManager": "bun@1.4.4",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/soymadip/portosaur"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p packages/app",
    "schema": "bun packages/cli/bin/porto.ts schema -o packages/cli/config-schema.json",
    "test:all": "bun run tests/run-all.ts",
    "test:smoke": "bun run tests/smoke/smoke-test.ts"
  },
  "type": "module",
  "version": "0.26.0",
  "workspaces": [
    "docs",
    "packages/*"
  ],
  "devDependencies": {
    "@types/node": "^26.6.6",
    "bun-types": "^1.4.4",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2"
  }
}
