{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    // A React/Next.js component library typechecks like a Next.js
    // project: `moduleResolution: bundler` (Next's own default).
    // The root config's NodeNext cannot resolve `next/link` or
    // `next/navigation` — Next ships no `exports` map, only legacy
    // subpath files — and it demands `with { type: "json" }` on the
    // icon-set JSON imports. Bundler resolution handles both.
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true
  },
  "include": ["src", "tests"]
}
