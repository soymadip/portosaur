---
// Search page (`/search`) — minimal working search (the full search UI
// is Phase 5).
//
// Reads `?q=`, loads the Pagefind index client-side, runs the query,
// and renders result links. The Pagefind index is built at `build:done`,
// so search works in built output; in dev the index is absent and the
// page says so instead of failing. The title is the bare string
// "Search the documentation" (no `| Site` suffix — the golden title).
import config from "porto:config";
import BaseLayout from "../layouts/BaseLayout.astro";

const base = config.site.baseUrl ?? "/";
const basePrefix = base === "/" ? "" : base.replace(/\/+$/, "");
const pagefindUrl = `${basePrefix}/pagefind/pagefind.js`;
---

<BaseLayout title="Search the documentation">
  <div class="search-page">
    <h1>Search the documentation</h1>
    <div class="search-input-wrap">
      <input
        id="porto-search-input"
        type="search"
        placeholder="Search the documentation…"
        aria-label="Search the documentation"
        autocomplete="off"
        class="search-input"
      />
    </div>
    <div id="porto-search-results" class="porto-search__results" role="status">
      <p class="porto-search__hint">Type to search the documentation.</p>
    </div>
  </div>

  <script define:vars={{ pagefindUrl, basePrefix }}>
    const input = document.getElementById("porto-search-input");
    const resultsEl = document.getElementById("porto-search-results");

    // Pagefind is loaded lazily (the index only exists in built output).
    let pagefind = null;
    let loadFailed = false;

    async function loadPagefind() {
      if (pagefind || loadFailed) {
        return pagefind;
      }
      try {
        pagefind = await import(pagefindUrl);
        if (basePrefix) {
          pagefind.options({ baseUrl: `${basePrefix}/` });
        }
      } catch {
        loadFailed = true;
        pagefind = null;
      }
      return pagefind;
    }

    function renderResults(results, query) {
      if (!resultsEl) {
        return;
      }
      if (results.length === 0) {
        resultsEl.textContent = `No results found for "${query}".`;
        return;
      }
      const list = document.createElement("ul");
      list.className = "porto-search-results__list";
      results.forEach((result) => {
        const item = document.createElement("li");
        const link = document.createElement("a");
        link.href = result.url;
        link.textContent = result.title || result.url;
        item.appendChild(link);
        if (result.excerpt) {
          const excerpt = document.createElement("p");
          // The excerpt is Pagefind-generated from the site's own
          // content (with <mark> highlights) — safe to inject.
          excerpt.innerHTML = result.excerpt;
          item.appendChild(excerpt);
        }
        list.appendChild(item);
      });
      resultsEl.replaceChildren(list);
    }

    async function runSearch(query) {
      if (!resultsEl) {
        return;
      }
      if (!query) {
        resultsEl.innerHTML =
          '<p class="porto-search__hint">Type to search the documentation.</p>';
        return;
      }
      const index = await loadPagefind();
      if (!index) {
        resultsEl.textContent =
          "Search index is not available yet. Build the site to enable search.";
        return;
      }
      const response = await index.search(query);
      const results = [];
      for (const result of response.results) {
        const data = await result.data();
        results.push({
          url: data.url,
          title: data.meta?.title,
          excerpt: data.excerpt,
        });
      }
      renderResults(results, query);
    }

    let debounce = 0;
    if (input instanceof HTMLInputElement) {
      // Prefill from ?q= and search on load.
      const params = new URLSearchParams(window.location.search);
      const initialQuery = params.get("q") ?? "";
      if (initialQuery) {
        input.value = initialQuery;
        runSearch(initialQuery);
      }
      input.addEventListener("input", () => {
        const query = input.value.trim();
        const url = new URL(window.location.href);
        if (query) {
          url.searchParams.set("q", query);
        } else {
          url.searchParams.delete("q");
        }
        window.history.replaceState(null, "", url);
        window.clearTimeout(debounce);
        debounce = window.setTimeout(() => {
          runSearch(query);
        }, 200);
      });
    }
  </script>
</BaseLayout>

<style>
  @layer porto.core {
    .search-page {
      width: 100%;
      max-width: 80rem;
      margin-inline: auto;
      padding: 1rem;
    }

    .search-page h1 {
      margin: 0;
      font-size: var(--porto-text-h1);
      line-height: var(--porto-line-height-headings);
      font-weight: 600;
      color: var(--porto-color-white);
    }

    .search-input-wrap {
      margin-block: 1.5rem;
    }

    .search-input {
      width: 100%;
      border-radius: 0.5rem;
      border: 1px solid var(--porto-color-gray-5);
      background-color: var(--porto-color-black);
      padding: 0.75rem 1rem;
      font-size: 1.1rem;
      color: var(--porto-color-text);
    }
    .search-input:focus {
      border-color: var(--porto-color-accent);
      outline: none;
    }

    /* Kept as plain CSS: both classes are set by the client script
       (`porto-search__hint` via innerHTML when the query clears,
       `porto-search-results__list` on the JS-created results list), so
       they cannot be utilities on static markup. */
    .porto-search__hint {
      color: var(--porto-color-gray-3);
    }

    .porto-search-results__list {
      list-style: none;
      margin: 0;
      padding: 0;
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
    }

    .porto-search-results__list a {
      color: var(--porto-color-text-accent);
      font-size: 1.1rem;
      font-weight: 600;
      text-decoration: none;
    }

    .porto-search-results__list a:hover {
      text-decoration: underline;
    }

    .porto-search-results__list p {
      color: var(--porto-color-gray-3);
      margin: 0.25rem 0 0;
    }
  }
</style>
