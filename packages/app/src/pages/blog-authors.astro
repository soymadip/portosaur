---
// Blog authors index (`/${blogRoute}/authors`).
//
// One h2 per author, linked to the author page when the author has
// `page: true`, with title and URL beneath (plain text when there is
// no page). Renders nothing but the h1 when `authors.yml` is absent.
import { getCollection } from "astro:content";
import config from "porto:config";
import BaseLayout from "../layouts/BaseLayout.astro";
import { pageTitle } from "../utils/content.ts";

const siteTitle = config.site.title;
const blogRoute = config.site.blogRoute;
const title = pageTitle("Authors", siteTitle);

let authors = [];
try {
  authors = await getCollection("authors");
} catch {
  authors = [];
}
---

<BaseLayout title={title}>
  <div class="porto-blog-list-page porto-blog-list-page--tight">
    <h1 class="porto-blog-list-title porto-blog-list-title--tight">Authors</h1>
    {authors.length === 0 ? (
      <p class="porto-blog-empty-text">No authors yet.</p>
    ) : (
      authors.map((author) => {
        const name = author.data.name ?? author.id;
        const hasPage = author.data.page === true;
        return (
          <section>
            <h2 class="porto-blog-author-entry-title">
              {hasPage ? (
                <a href={`/${blogRoute}/authors/${author.id}/`}>{name}</a>
              ) : (
                name
              )}
            </h2>
            {author.data.title && (
              <p class="porto-blog-author-title">{author.data.title}</p>
            )}
            {author.data.url && (
              <p class="porto-blog-author-url">
                <a
                  href={author.data.url}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {author.data.url}
                </a>
              </p>
            )}
          </section>
        );
      })
    )}
  </div>
</BaseLayout>
