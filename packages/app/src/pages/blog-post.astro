---
// Blog post (`/${blogRoute}/[...slug]`).
//
// Title, date, authors (avatar + name + title, linked to their author
// page when one exists, else to their URL), the full MDX content, a
// tags footer, and prev/next post navigation (newest first: "Newer
// post" is the previous item in date order, "Older post" the next).
// Post slugs follow the Docusaurus blog rule (frontmatter `slug` wins,
// else the file base with a `YYYY-MM-DD-` date prefix stripped).
//
// Author avatars go through Astro's `<Image />` when they are local
// files the build can size; remote URLs and unsizable files keep a
// plain `<img>` (same rule as the hero profile picture).
//
// Dates resolve in `getStaticPaths` (frontmatter `date` → git date →
// mtime, the same chain as the list pages) so newer/older ordering
// follows resolved dates; the post's date and the sidebar data ride
// along as props.
import { Image } from "astro:assets";
import { getCollection, render } from "astro:content";
import config from "porto:config";
import BaseLayout from "../layouts/BaseLayout.astro";
import BlogSidebar from "../components/BlogSidebar.astro";
import { mdxComponents } from "../components/mdx/index.ts";
import { pageTitle, blogSlug, postDate } from "../utils/content.ts";
import {
  localImageDimensions,
  staticDirsForConfig,
} from "../utils/imageSize.ts";

export async function getStaticPaths() {
  const datedPosts = (await getCollection("blog"))
    .map((post) => ({ post, date: postDate(post) }))
    .sort((a, b) => {
      if (a.date && b.date) {
        return b.date.getTime() - a.date.getTime();
      }
      if (a.date) {
        return -1;
      }
      if (b.date) {
        return 1;
      }
      return a.post.id.localeCompare(b.post.id);
    });

  const blogRoute = config.site.blogRoute;
  const sidebarPosts = datedPosts.map(({ post, date }) => ({
    url: `/${blogRoute}/${blogSlug(post)}/`,
    title: post.data.title ?? post.id,
    date: date ? date.toISOString() : null,
  }));

  return datedPosts.map(({ post, date }, index) => ({
    params: { slug: blogSlug(post) },
    props: {
      post,
      date: date ? date.toISOString() : null,
      sidebarPosts,
      // Newest first: the previous item is the newer post.
      newer: index > 0 ? datedPosts[index - 1].post : null,
      older: index < datedPosts.length - 1 ? datedPosts[index + 1].post : null,
    },
  }));
}

const {
  post,
  date: dateProp,
  sidebarPosts: sidebarPostProps,
  newer,
  older,
} = Astro.props;
const { Content } = await render(post);

const siteTitle = config.site.title;
const blogRoute = config.site.blogRoute;
const heading = post.data.title ?? post.id;
const title = pageTitle(heading, siteTitle);
const date = dateProp ? new Date(dateProp) : null;
const tags = post.data.tags ?? [];
const currentUrl = `/${blogRoute}/${blogSlug(post)}/`;
const sidebarPosts = sidebarPostProps.map((sidebarPost) => ({
  ...sidebarPost,
  date: sidebarPost.date ? new Date(sidebarPost.date) : null,
}));

async function loadAuthors() {
  try {
    return await getCollection("authors");
  } catch {
    return [];
  }
}

// Resolves an author ref (a string key into `authors.yml`, or an inline
// `{ key?, name?, title?, url?, image_url? }` object) to a display
// author, including the title and avatar for the author block.
function resolveAuthor(ref, authors) {
  if (typeof ref === "string") {
    const found = authors.find((author) => author.id === ref);
    if (found) {
      return {
        key: found.id,
        name: found.data.name ?? found.id,
        title: found.data.title,
        url: found.data.url,
        image: found.data.image_url,
        hasPage: found.data.page === true,
      };
    }
    return {
      key: ref,
      name: ref,
      title: undefined,
      url: undefined,
      image: undefined,
      hasPage: false,
    };
  }
  const key = ref?.key;
  const found = key ? authors.find((author) => author.id === key) : undefined;
  if (found) {
    return {
      key: found.id,
      name: ref.name ?? found.data.name ?? found.id,
      title: ref.title ?? found.data.title,
      url: ref.url ?? found.data.url,
      image: ref.image_url ?? found.data.image_url,
      hasPage: found.data.page === true,
    };
  }
  return {
    key: key ?? ref?.name ?? "",
    name: ref?.name ?? key ?? "",
    title: ref?.title,
    url: ref?.url,
    image: ref?.image_url,
    hasPage: false,
  };
}

// An author avatar URL: absolute and remote URLs pass through, a
// relative path resolves against the site base URL (the Docusaurus
// `image_url` rule).
function resolveAuthorImage(image) {
  if (!image) {
    return undefined;
  }
  if (/^(https?:)?\/\//.test(image) || image.startsWith("/")) {
    return image;
  }
  const base = (config.site.baseUrl ?? "/").replace(/\/+$/, "");
  return `${base}/${image}`;
}

const authors = await loadAuthors();
// Avatar dimensions for <Image /> (public images need width/height).
// Null for remote or unsizable avatars, which keep a plain <img>.
const postAuthors = await Promise.all(
  (post.data.authors ?? []).map(async (ref) => {
    const author = resolveAuthor(ref, authors);
    const dims = author.image
      ? await localImageDimensions(author.image, staticDirsForConfig(config))
      : null;
    return { ...author, dims };
  }),
);

function formatPostDate(value) {
  return value.toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
}

function postUrl(other) {
  return `/${blogRoute}/${blogSlug(other)}/`;
}
---

<BaseLayout title={title} description={post.data.description}>
  <div class="porto-blog-layout">
    <BlogSidebar posts={sidebarPosts} currentUrl={currentUrl} />
    <article class="porto-blog-article">
      <header>
        <h1 class="porto-blog-article-title">{heading}</h1>
        {date && (
          <time class="porto-blog-article-date" datetime={date.toISOString()}>
            {formatPostDate(date)}
          </time>
        )}
        {postAuthors.length > 0 && (
          <div class="porto-blog-article-authors">
            {postAuthors.map((author) => (
              <div class="porto-blog-article-author">
                {author.image &&
                  (author.dims ? (
                    <Image
                      class="porto-blog-article-avatar"
                      src={resolveAuthorImage(author.image)}
                      alt=""
                      width={author.dims.width}
                      height={author.dims.height}
                    />
                  ) : (
                    <img
                      class="porto-blog-article-avatar"
                      src={resolveAuthorImage(author.image)}
                      alt=""
                    />
                  ))}
                <div class="porto-blog-article-author-info">
                  <span class="porto-blog-article-author-name">
                    {author.hasPage ? (
                      <a
                        class="porto-blog-article-author-name"
                        href={`/${blogRoute}/authors/${author.key}/`}
                      >
                        {author.name}
                      </a>
                    ) : author.url ? (
                      <a
                        class="porto-blog-article-author-name"
                        href={author.url}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        {author.name}
                      </a>
                    ) : (
                      author.name
                    )}
                  </span>
                  {author.title && (
                    <span class="porto-blog-article-author-title">
                      {author.title}
                    </span>
                  )}
                </div>
              </div>
            ))}
          </div>
        )}
      </header>

      <div class="porto-markdown-content">
        <Content components={mdxComponents} />
      </div>

      {tags.length > 0 && (
        <footer class="porto-blog-article-tags">
          <span>Tags:</span>
          <ul class="porto-blog-tag-list">
            {tags.map((tag) => (
              <li>
                <a class="porto-blog-tag" href={`/${blogRoute}/tags/${tag}/`}>
                  {tag}
                </a>
              </li>
            ))}
          </ul>
        </footer>
      )}

      {(newer || older) && (
        <nav class="porto-blog-article-nav" aria-label="Blog posts">
          {newer ? (
            <a
              class="porto-blog-article-nav-link"
              href={postUrl(newer)}
              rel="prev"
            >
              <span class="porto-blog-article-nav-label">Newer post</span>
              <span class="porto-blog-article-nav-title">
                {newer.data.title ?? newer.id}
              </span>
            </a>
          ) : (
            <span />
          )}
          {older ? (
            <a
              class="porto-blog-article-nav-link porto-blog-article-nav-link--next"
              href={postUrl(older)}
              rel="next"
            >
              <span class="porto-blog-article-nav-label">Older post</span>
              <span class="porto-blog-article-nav-title">
                {older.data.title ?? older.id}
              </span>
            </a>
          ) : (
            <span />
          )}
        </nav>
      )}
    </article>
  </div>
</BaseLayout>
