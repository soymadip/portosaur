---
// Blog tag page (`/${blogRoute}/tags/[tag]`).
//
// Heading wording is the Docusaurus blog-tag rule verbatim ("One post
// tagged with ..." / "N posts tagged with ..."), so the golden heading
// `One post tagged with "welcome"` survives.
import { getCollection } from "astro:content";
import config from "porto:config";
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  pageTitle,
  blogSlug,
  postDate,
  sortPostsByDateDesc,
} from "../utils/content.ts";

export async function getStaticPaths() {
  const posts = sortPostsByDateDesc(await getCollection("blog"));
  const byTag = new Map();
  for (const post of posts) {
    for (const tag of post.data.tags ?? []) {
      if (!byTag.has(tag)) {
        byTag.set(tag, []);
      }
      byTag.get(tag).push(post);
    }
  }
  return [...byTag.entries()].map(([tag, taggedPosts]) => ({
    params: { tag },
    props: { tag, posts: taggedPosts },
  }));
}

const { tag, posts } = Astro.props;
const siteTitle = config.site.title;
const blogRoute = config.site.blogRoute;
const heading =
  posts.length === 1
    ? `One post tagged with "${tag}"`
    : `${posts.length} posts tagged with "${tag}"`;
// Docusaurus used the heading text as the page title too.
const title = pageTitle(heading, siteTitle);

function formatPostDate(date) {
  return date.toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
}
---

<BaseLayout title={title}>
  <div class="porto-blog-list-page">
    <h1 class="porto-blog-list-title">{heading}</h1>
    {posts.map((post) => {
      const date = postDate(post);
      return (
        <article>
          <h2 class="porto-blog-post-title porto-blog-post-title--plain porto-blog-post-title--sm">
            <a href={`/${blogRoute}/${blogSlug(post)}/`}>
              {post.data.title ?? post.id}
            </a>
          </h2>
          <div class="porto-blog-post-meta-line">
            {date && (
              <time datetime={date.toISOString()}>{formatPostDate(date)}</time>
            )}
          </div>
          {post.data.description && (
            <p class="porto-blog-post-desc">{post.data.description}</p>
          )}
        </article>
      );
    })}
  </div>
</BaseLayout>
