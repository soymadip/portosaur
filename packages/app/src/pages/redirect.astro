---
// Redirect interstitial (`/redirect?url=…`) — port of the old
// `pages/redirect.jsx`.
//
// The client script ports the old `useEffect` body verbatim: no `?url=`
// param → `location.replace("/")`; otherwise `window.open(url, "_blank",
// "noopener,noreferrer")` — on success `history.back()` (or `/` when
// there is no history), on block the tap-to-open fallback appears. The
// old code has no URL validation and neither does the port. The React
// `blocked` / `targetUrl` state becomes DOM updates (the heading text
// swap + unhiding the fallback block). The empty-state layout is the
// shared `.porto-empty-state` (css/portfolio.css).
import config from "porto:config";
import BaseLayout from "../layouts/BaseLayout.astro";
import { pageTitle } from "../utils/content.ts";
import { renderIcon } from "../utils/icons.ts";

const title = pageTitle("Opening in browser…", config.site.title);
---

<BaseLayout title={title} description="Opening in browser…">
  <div class="porto-empty-state">
    <div class="porto-empty-state-icon">
      <span set:html={renderIcon("md:open-in-new", { size: "3rem" })} />
    </div>
    <h2 class="porto-empty-state-title" id="redirect-title">
      Opening in browser…
    </h2>
    <div id="redirect-blocked" hidden>
      <p class="porto-empty-state-text">
        This link lives outside the portfolio app. Tap the button below to open
        it in your browser.
      </p>
      <a
        class="porto-link-button primary"
        id="redirect-link"
        target="_blank"
        rel="noopener noreferrer"
      >
        Open in browser
      </a>
    </div>
  </div>

  <script>
    const params = new URLSearchParams(window.location.search);
    const url = params.get("url");

    if (!url) {
      // No ?url= param — just go home.
      window.location.replace("/");
    } else {
      // Try to open in external browser window.
      // Works on Android standalone PWA; returns null on iOS standalone.
      const win = window.open(url, "_blank", "noopener,noreferrer");

      if (win) {
        // Opened successfully — navigate back inside the PWA.
        if (history.length > 1) {
          history.back();
        } else {
          window.location.replace("/");
        }
      } else {
        // window.open() was blocked (iOS standalone PWA).
        // Show a fallback the user can tap manually.
        const title = document.getElementById("redirect-title");
        if (title) {
          title.textContent = "This page is outside the app";
        }
        const blocked = document.getElementById("redirect-blocked");
        if (blocked) {
          blocked.hidden = false;
        }
        const link = document.getElementById("redirect-link");
        if (link instanceof HTMLAnchorElement) {
          link.href = url;
        }
      }
    }
  </script>
</BaseLayout>
