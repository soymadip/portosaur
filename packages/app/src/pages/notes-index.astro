---
// Notes/docs index (`/${notesRoute}`, docs mode only).
//
// The root index doc's page, inside the full DocLayout (sidebar,
// breadcrumbs, pagination) like the old `DocCategoryGeneratedIndexPage`:
// its title is the h1 (passed as DocLayout's `heading` prop), its
// frontmatter description renders as the intro paragraph (the index
// doc usually has no body — the docs README is frontmatter-only, so
// rendering Content alone would show nothing), then the automatic
// topic list (the sidebar's top-level items) via DocCardList. When no
// root index exists the h1 falls back to "Docs" and only the topic
// list renders.
import { getCollection, render } from "astro:content";
import config from "porto:config";
import sidebar from "porto:sidebar";
import DocLayout from "../layouts/DocLayout.astro";
import DocCardList from "../components/DocCardList.astro";
import { mdxComponents } from "../components/mdx/index.ts";
import {
  pageTitle,
  docPageTitles,
  isIndexEntry,
  contentRelativePath,
} from "../utils/content.ts";

const siteTitle = config.site.title;
const notesRoute = config.site.notesRoute;
const currentHref = `/${notesRoute}`;

const notes = await getCollection("notes");
const rootIndex = notes.find(
  (entry) => isIndexEntry(entry) && !entry.id.includes("/"),
);

const description = rootIndex?.data?.description;

const rendered = rootIndex ? await render(rootIndex) : null;
const Content = rendered?.Content ?? null;
// Same Docusaurus title rules as doc.astro: no synthetic h1 when the
// index content has its own H1 (its fallback title is "Docs").
const { heading, metaTitle } = docPageTitles(
  rootIndex,
  rendered?.headings ?? [],
  "Docs",
);
const title = pageTitle(metaTitle, siteTitle);
// The tree is the top-level items — the index cards list them directly.
const items = sidebar;

// Edit URL for the root index doc (same derivation as doc.astro): the
// project-relative file path minus the notes-dir prefix, appended to
// the configured edit base.
let editUrl;
const projectRelative = rootIndex
  ? contentRelativePath(rootIndex.filePath)
  : null;
if (projectRelative) {
  const segments = projectRelative.split("/");
  const dirSegments = config.site.notesDir.split("/").filter(Boolean);
  const matchesDir = dirSegments.every((segment, i) => segments[i] === segment);
  const relativePath = matchesDir
    ? segments.slice(dirSegments.length).join("/")
    : null;
  const editBase = config.site.editUrl;
  if (editBase && relativePath) {
    const base = editBase.endsWith("/") ? editBase : `${editBase}/`;
    editUrl = `${base}${relativePath}`;
  }
}
---

<DocLayout
  title={title}
  description={description}
  heading={heading}
  currentHref={currentHref}
  headings={[]}
  editUrl={editUrl}
>
  {description && <p>{description}</p>}
  {Content && <Content components={mdxComponents} />}
  {items.length > 0 && <DocCardList items={items} />}
</DocLayout>
