---
// Blog index (`/${blogRoute}`, page 1).
//
// Post list, newest first, 10 per page (the Docusaurus default). Each
// item shows title, date, excerpt, authors, and tags. When the blog
// has no posts, the empty state renders instead — the h2 "No posts yet"
// is verbatim (the docs site's blog has no posts — only `authors.yml`).
//
// Dates resolve via the shared `postDate` helper in `utils/content.ts`
// (frontmatter `date` → the file's last git commit date → the file's
// mtime — the Docusaurus fallback chain for undated posts).
//
// Excerpts come from the `{/* truncate */}` / `<!-- truncate -->`
// marker: the content above it, rendered through the site's own
// remark/rehype plugin list, plus a "Read more" link. Posts without a
// marker fall back to the frontmatter `description`.
import { getCollection } from "astro:content";
import { createMarkdownProcessor } from "@astrojs/markdown-remark";
import config from "porto:config";
import BaseLayout from "../layouts/BaseLayout.astro";
import BlogSidebar from "../components/BlogSidebar.astro";
import NotifyButton from "../components/NotifyButton.astro";
import { pageTitle, blogSlug, postDate } from "../utils/content.ts";
import { portosaurMdxOptions } from "../mdx.ts";
import { renderIcon } from "../utils/icons.ts";

const PAGE_SIZE = 10;

const siteTitle = config.site.title;
const blogRoute = config.site.blogRoute;
const title = pageTitle("Blog", siteTitle);

const showNotify = config.site.pwa?.enable && config.site.pwa?.notifications;

// The authors collection exists only when `<blogDir>/authors.yml`
// exists — `getCollection` throws otherwise, so the read is guarded.
async function loadAuthors() {
  try {
    return await getCollection("authors");
  } catch {
    return [];
  }
}

// Resolves an author ref (a string key into `authors.yml`, or an inline
// `{ key?, name?, title?, url? }` object) to a display author.
function resolveAuthor(ref, authors) {
  if (typeof ref === "string") {
    const found = authors.find((author) => author.id === ref);
    if (found) {
      return {
        key: found.id,
        name: found.data.name ?? found.id,
        title: found.data.title,
        url: found.data.url,
        hasPage: found.data.page === true,
      };
    }
    return {
      key: ref,
      name: ref,
      title: undefined,
      url: undefined,
      hasPage: false,
    };
  }
  const key = ref?.key;
  const found = key ? authors.find((author) => author.id === key) : undefined;
  if (found) {
    return {
      key: found.id,
      name: ref.name ?? found.data.name ?? found.id,
      title: ref.title ?? found.data.title,
      url: ref.url ?? found.data.url,
      hasPage: found.data.page === true,
    };
  }
  return {
    key: key ?? ref?.name ?? "",
    name: ref?.name ?? key ?? "",
    title: ref?.title,
    url: ref?.url,
    hasPage: false,
  };
}

function formatPostDate(date) {
  return date.toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
}

// Posts newest first by resolved date; undated posts sort last, by id
// (the `sortPostsByDateDesc` rule, applied to resolved dates).
function sortDatedPostsDesc(datedPosts) {
  return [...datedPosts].sort((a, b) => {
    if (a.date && b.date) {
      return b.date.getTime() - a.date.getTime();
    }
    if (a.date) {
      return -1;
    }
    if (b.date) {
      return 1;
    }
    return a.post.id.localeCompare(b.post.id);
  });
}

// The Docusaurus truncate marker, either form (`{/* truncate */}` in
// MDX, `<!-- truncate -->` in Markdown), tolerating inner whitespace.
const TRUNCATE_PATTERN = /\{\/\*\s*truncate\s*\*\/\}|<!--\s*truncate\s*-->/;

function splitExcerpt(body) {
  const match = TRUNCATE_PATTERN.exec(body ?? "");
  if (!match) {
    return { excerpt: null, truncated: false };
  }
  return { excerpt: body.slice(0, match.index), truncated: true };
}

const allPosts = sortDatedPostsDesc(
  (await getCollection("blog")).map((post) => ({
    post,
    date: postDate(post),
  })),
);
const pageCount = Math.ceil(allPosts.length / PAGE_SIZE);
const authors = await loadAuthors();

// The sidebar lists every post, grouped by year.
const sidebarPosts = allPosts.map(({ post, date }) => ({
  url: `/${blogRoute}/${blogSlug(post)}/`,
  title: post.data.title ?? post.id,
  date,
}));

// Excerpts render through the site's own remark/rehype plugin list
// (same options as the integration's markdown processor, Shiki themes
// included) — but the processor is only built when some post on this
// page actually has a truncate marker. No `fileURL` is passed to
// `render`: without one, Astro's image collection stays off and
// excerpt images keep their original `src` instead of being rewritten
// into unprocessed `__ASTRO_IMAGE_` blobs. A render failure falls back
// to the description, never failing the page.
const pagePosts = allPosts.slice(0, PAGE_SIZE);
const splits = pagePosts.map(({ post }) => splitExcerpt(post.body));
let excerptRenderer = null;
if (splits.some((split) => split.truncated)) {
  const mdxOptions = portosaurMdxOptions({
    userVars: config.userVars ?? {},
    colorScheme: config.theme?.colorScheme,
  });
  excerptRenderer = await createMarkdownProcessor({
    remarkPlugins: mdxOptions.remarkPlugins,
    rehypePlugins: mdxOptions.rehypePlugins,
    shikiConfig: mdxOptions.shikiConfig,
  });
}

async function renderExcerpt(excerpt) {
  if (!excerptRenderer) {
    return null;
  }
  try {
    const { code } = await excerptRenderer.render(excerpt);
    return code;
  } catch {
    return null;
  }
}

const viewPosts = await Promise.all(
  pagePosts.map(async ({ post, date }, index) => {
    const split = splits[index];
    const excerptHtml = split.truncated
      ? await renderExcerpt(split.excerpt)
      : null;
    return {
      url: `/${blogRoute}/${blogSlug(post)}/`,
      title: post.data.title ?? post.id,
      date,
      description: post.data.description,
      excerptHtml,
      truncated: split.truncated,
      authors: (post.data.authors ?? []).map((ref) =>
        resolveAuthor(ref, authors),
      ),
      tags: post.data.tags ?? [],
    };
  }),
);
---

<BaseLayout title={title}>
  {viewPosts.length === 0 ? (
    <div class="porto-empty-state">
      <div class="porto-empty-state-icon">
        <span set:html={renderIcon("md:fountain-pen-tip", { size: "3rem" })} />
      </div>
      <h2 class="porto-empty-state-title">No posts yet</h2>
      <p class="porto-empty-state-text">
        Check back later — new posts are on the way!
      </p>
    </div>
  ) : (
    <div class="porto-blog-layout">
      <BlogSidebar posts={sidebarPosts} />
      <div class="porto-blog-main">
        {showNotify && <NotifyButton />}
        {viewPosts.map((post) => (
          <article>
            <h2 class="porto-blog-post-title">
              <a href={post.url}>{post.title}</a>
            </h2>
            <div class="porto-blog-post-meta">
              {post.date && (
                <time
                  class="porto-blog-post-date"
                  datetime={post.date.toISOString()}
                >
                  {formatPostDate(post.date)}
                </time>
              )}
              {post.authors.length > 0 && (
                <div class="porto-blog-post-authors">
                  {post.authors.map((author) => (
                    <div class="porto-blog-post-author">
                      {author.hasPage ? (
                        <a
                          class="porto-blog-post-author-name"
                          href={`/${blogRoute}/authors/${author.key}/`}
                        >
                          {author.name}
                        </a>
                      ) : author.url ? (
                        <a
                          class="porto-blog-post-author-name"
                          href={author.url}
                          target="_blank"
                          rel="noopener noreferrer"
                        >
                          {author.name}
                        </a>
                      ) : (
                        <span class="porto-blog-post-author-name">
                          {author.name}
                        </span>
                      )}
                      {author.title && (
                        <div class="porto-blog-post-author-title">
                          {author.title}
                        </div>
                      )}
                    </div>
                  ))}
                </div>
              )}
            </div>
            {post.excerptHtml ? (
              <div class="porto-blog-excerpt" set:html={post.excerptHtml} />
            ) : post.description ? (
              <p class="porto-blog-post-desc">{post.description}</p>
            ) : null}
            {(post.tags.length > 0 || post.truncated) && (
              <div class="porto-blog-post-foot">
                {post.tags.length > 0 && (
                  <ul class="porto-blog-tag-list">
                    {post.tags.map((tag) => (
                      <li>
                        <a
                          class="porto-blog-tag"
                          href={`/${blogRoute}/tags/${tag}/`}
                        >
                          {tag}
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
                {post.truncated && (
                  <a class="porto-blog-read-more" href={post.url}>
                    Read more
                  </a>
                )}
              </div>
            )}
          </article>
        ))}
        {pageCount > 1 && (
          <nav class="porto-blog-pagination" aria-label="Blog pages">
            <span />
            <a
              class="porto-blog-page-link"
              href={`/${blogRoute}/page/2/`}
              rel="next"
            >
              Older
            </a>
          </nav>
        )}
      </div>
    </div>
  )}
</BaseLayout>
