---
// Tasks page (`/tasks`).
//
// Full task table from `config.tasks` (title/subtitle/list — the
// resolved engine shape; the old Docusaurus page read a `tasksPage`
// shape the engine never built, so it always rendered "disabled").
// Stats, status tabs with counts, and one table sorted by status order
// then priority; tab filtering is the shared `tasks-filter` module
// (rows carry `data-task-status`, tabs `data-task-tab`).
//
// Fixes vs the old page: the old `clsx` calls emitted the global class
// strings `task-row-completed` / `task-row-striped` / `task-tab-active`,
// which never matched the hashed CSS-module classes — here the
// completed-row strikethrough and striping are conditional classes
// and `task-tab-active` is a real class (kept because the filter
// script toggles it), so all three actually style. The old JSX
// referenced a nonexistent `tasks-subheading` class; the subheading
// uses the `porto-tasks-subtitle` styles. Unknown statuses (e.g.
// `done`) sort after the known ones and get a neutral badge with the
// raw status text instead of the old empty badge; tasks without a
// priority get no priority badge instead of an empty one.
import config from "porto:config";
import BaseLayout from "../layouts/BaseLayout.astro";
import { pageTitle } from "../utils/content.ts";
import { renderIcon } from "../utils/icons.ts";

const siteTitle = config.site.title;
const tasks = config.tasks ?? {};
const enabled = tasks.enable === true;

const heading = tasks.title || "Tasks";
const subheading = tasks.subtitle || "Roadmap & Goals";
const list = Array.isArray(tasks.list) ? tasks.list : [];

const title = enabled
  ? pageTitle(heading, siteTitle)
  : pageTitle("Tasks are Disabled", siteTitle);
const description = enabled ? subheading : "Tasks are currently disabled";

// Stats (unknown statuses count toward the total only, as before).
const total = list.length;
const completedCount = list.filter(
  (task) => task.status === "completed",
).length;
const activeCount = list.filter((task) => task.status === "active").length;
const pendingCount = list.filter((task) => task.status === "pending").length;
const percentComplete =
  total > 0 ? Math.round((completedCount / total) * 100) : 0;

// Sort: status order (active, pending, completed; unknown last), then
// priority (high, medium, low; missing last — degrades to "as listed").
const STATUS_ORDER = { active: 1, pending: 2, completed: 3 };
const PRIORITY_ORDER = { high: 1, medium: 2, low: 3 };
const sorted = [...list].sort((a, b) => {
  const statusDiff =
    (STATUS_ORDER[a.status] ?? 99) - (STATUS_ORDER[b.status] ?? 99);
  if (statusDiff !== 0) {
    return statusDiff;
  }
  return (
    (PRIORITY_ORDER[a.priority] ?? 99) - (PRIORITY_ORDER[b.priority] ?? 99)
  );
});

const tabs = [
  { id: "all", label: "All Tasks", icon: "md:clipboard-text", count: total },
  {
    id: "active",
    label: "In Progress",
    icon: "md:loading",
    spin: true,
    count: activeCount,
  },
  {
    id: "pending",
    label: "Planned",
    icon: "md:clock-outline",
    count: pendingCount,
  },
  {
    id: "completed",
    label: "Completed",
    icon: "md:check-circle",
    count: completedCount,
  },
];

const KNOWN_STATUSES = new Set(["active", "pending", "completed"]);

// Status / priority badge modifiers (css/tasks.css). Font weight is
// NOT in the base badge: the medium-priority badge is bold, the
// others semibold — the `--bold` modifier carries it.
const STATUS_BADGE: Record<string, string> = {
  completed: "porto-tasks-badge--done",
  active: "porto-tasks-badge--active",
  pending: "porto-tasks-badge--planned",
};
---

<BaseLayout title={title} description={description}>
  <div class="porto-tasks" data-porto-tasks>
    {!enabled ? (
      <div class="porto-tasks-inner">
        <div class="porto-tasks-disabled">
          <div class="porto-tasks-disabled-icon">
            <span set:html={renderIcon("ml:alert")} />
          </div>
          <h2 class="porto-tasks-disabled-title">
            Tasks are currently disabled
          </h2>
          <p class="porto-tasks-disabled-text">
            To enable tasks, set <code>tasks.enable</code> to <code>true</code>
          </p>
        </div>
      </div>
    ) : (
      <>
        <div class="porto-tasks-heading">
          <h1 class="porto-tasks-title">{heading}</h1>
          {subheading && <p class="porto-tasks-subtitle">{subheading}</p>}
        </div>
        <div class="porto-tasks-inner">
          <div class="porto-tasks-stats">
            <div class="porto-tasks-stat">
              <div class="porto-tasks-stat-label">Total Tasks</div>
              <div class="porto-tasks-stat-value">{total}</div>
            </div>
            <div class="porto-tasks-stat">
              <div class="porto-tasks-stat-label">Completed</div>
              <div class="porto-tasks-stat-value porto-tasks-stat-value--success">
                {completedCount}
              </div>
            </div>
            <div class="porto-tasks-stat">
              <div class="porto-tasks-stat-label">In Progress</div>
              <div class="porto-tasks-stat-value porto-tasks-stat-value--accent">
                {activeCount}
              </div>
            </div>
            <div class="porto-tasks-stat">
              <div class="porto-tasks-stat-label">Planned</div>
              <div class="porto-tasks-stat-value porto-tasks-stat-value--warning">
                {pendingCount}
              </div>
            </div>
            <div class="porto-tasks-stat">
              <div class="porto-tasks-stat-label">Progress</div>
              <div class="porto-tasks-stat-value">{percentComplete}%</div>
              <div class="porto-tasks-progress-track">
                <div
                  class="porto-tasks-progress-bar"
                  style={`width: ${percentComplete}%`}
                />
              </div>
            </div>
          </div>

          <div class="porto-tasks-panel">
            <div
              class="porto-tasks-tabs"
              role="tablist"
              aria-label="Task categories"
            >
              {tabs.map((tab) => (
                <button
                  type="button"
                  class={`porto-tasks-tab${tab.id === "all" ? " task-tab-active" : ""}`}
                  data-task-tab={tab.id}
                  role="tab"
                  aria-selected={tab.id === "all"}
                  aria-controls={`tab-content-${tab.id}`}
                  id={`tab-${tab.id}`}
                >
                  <span
                    class={`porto-tasks-tab-icon${tab.spin ? " spin" : ""}`}
                    aria-hidden="true"
                    set:html={renderIcon(tab.icon)}
                  />
                  <span class="porto-tasks-tab-label">{tab.label}</span>
                  <span class="task-tab-count">{tab.count}</span>
                </button>
              ))}
            </div>

            <div
              class="porto-tasks-content"
              role="tabpanel"
              data-task-panel
              id="tab-content-all"
              aria-labelledby="tab-all"
            >
              {list.length === 0 ? (
                <div class="porto-tasks-empty">
                  <span
                    class="porto-tasks-empty-icon"
                    set:html={renderIcon("md:format-list-checks")}
                  />
                  <p>No tasks available</p>
                </div>
              ) : (
                <>
                  <div class="porto-tasks-table" data-task-table>
                    <div class="porto-tasks-table-head">
                      <div class="porto-tasks-table-head-cell">Status</div>
                      <div class="porto-tasks-table-head-cell porto-tasks-table-head-cell--details">
                        Task Details
                      </div>
                      <div class="porto-tasks-table-head-cell porto-tasks-table-head-cell--priority">
                        Priority
                      </div>
                    </div>
                    <div>
                      {sorted.map((task, index) => (
                        <div
                          class={`porto-tasks-row${index % 2 === 1 ? " porto-tasks-row--striped" : ""}`}
                          data-task-status={task.status}
                        >
                          <div class="porto-tasks-cell">
                            <span
                              class={`porto-tasks-badge ${STATUS_BADGE[task.status] ?? ""}`}
                            >
                              {task.status === "completed" && (
                                <>
                                  <span
                                    class="porto-tasks-badge-icon"
                                    set:html={renderIcon("md:check-circle")}
                                  />{" "}
                                  Done
                                </>
                              )}
                              {task.status === "active" && (
                                <>
                                  <span
                                    class="porto-tasks-badge-icon spin"
                                    set:html={renderIcon("md:loading")}
                                  />{" "}
                                  In Progress
                                </>
                              )}
                              {task.status === "pending" && (
                                <>
                                  <span
                                    class="porto-tasks-badge-icon"
                                    set:html={renderIcon("md:clock-outline")}
                                  />{" "}
                                  Planned
                                </>
                              )}
                              {!KNOWN_STATUSES.has(task.status) && task.status}
                            </span>
                          </div>
                          <div class="porto-tasks-cell porto-tasks-cell--details">
                            <div
                              class={`porto-tasks-title-text ${
                                task.status === "completed"
                                  ? "porto-tasks-title-text--completed"
                                  : task.status === "active"
                                    ? "porto-tasks-title-text--active"
                                    : ""
                              }`}
                            >
                              {task.title}
                            </div>
                            {task.desc && (
                              <div
                                class={`porto-tasks-desc ${
                                  task.status === "completed"
                                    ? "porto-tasks-desc--completed"
                                    : ""
                                }`}
                              >
                                {task.desc}
                              </div>
                            )}
                          </div>
                          <div class="porto-tasks-cell">
                            {task.priority === "high" && (
                              <span class="porto-tasks-badge porto-tasks-badge--high">
                                <span
                                  class="porto-tasks-badge-icon"
                                  set:html={renderIcon("md:fire")}
                                />{" "}
                                High
                              </span>
                            )}
                            {task.priority === "medium" && (
                              <span class="porto-tasks-badge porto-tasks-badge--high porto-tasks-badge--bold">
                                <span
                                  class="porto-tasks-badge-icon"
                                  set:html={renderIcon("md:thermometer")}
                                />{" "}
                                Medium
                              </span>
                            )}
                            {task.priority === "low" && (
                              <span class="porto-tasks-badge porto-tasks-badge--low">
                                <span
                                  class="porto-tasks-badge-icon"
                                  set:html={renderIcon("md:snowflake")}
                                />{" "}
                                Low
                              </span>
                            )}
                          </div>
                        </div>
                      ))}
                    </div>
                  </div>
                  <div
                    class="porto-tasks-empty"
                    data-task-empty
                    style="display: none"
                  >
                    <span
                      class="porto-tasks-empty-icon"
                      set:html={renderIcon("md:format-list-checks")}
                    />
                    <p>No tasks in this category</p>
                  </div>
                </>
              )}
            </div>
          </div>
        </div>
      </>
    )}
  </div>

  <script>
    import { initTasksFilter } from "../scripts/tasks-filter.ts";
    initTasksFilter();
  </script>
</BaseLayout>
