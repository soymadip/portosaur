---
// Offline page (`/offline`) — the service worker falls back to this
// page when the user is offline. Port of the old `pages/offline.jsx`:
// empty-state layout in Tailwind utilities (the old shared empty-state
// styles are inlined), cloud-off icon, "Try again" reload button.
import config from "porto:config";
import BaseLayout from "../layouts/BaseLayout.astro";
import { pageTitle } from "../utils/content.ts";
import { renderIcon } from "../utils/icons.ts";

const title = pageTitle("You're Offline", config.site.title);
---

<BaseLayout title={title} description="You're offline">
  <div class="flex min-h-[calc(100vh-var(--navbar-height)-100px)] flex-col items-center justify-center p-8 text-center">
    <div class="text-[4.5rem] text-muted opacity-60">
      <span
        set:html={renderIcon("line-md:cloud-alt-off-loop", { size: "5rem" })}
      />
    </div>
    <h2 class="mt-[-0.8rem] mb-4 text-[2.2rem] text-foreground">
      You're Offline
    </h2>
    <p class="max-w-[500px] text-[1.1rem] text-muted">
      It looks like you don't have an internet connection. Previously visited
      pages are still available from cache.
    </p>
    <button
      type="button"
      class="mt-6 inline-flex cursor-pointer items-center gap-2 rounded-full border-0 bg-primary px-[1.4rem] py-[0.6rem] text-base leading-(--line-height) font-semibold text-[#09090b] no-underline transition-[background-color_0.2s_ease,transform_0.2s_ease] hover:-translate-y-0.5 hover:bg-primary-light hover:shadow-md"
      data-reload
    >
      Try again
    </button>
  </div>

  <script>
    const button = document.querySelector("[data-reload]");
    if (button) {
      button.addEventListener("click", () => {
        window.location.reload();
      });
    }
  </script>
</BaseLayout>
