---
// Offline page (`/offline`) — the service worker falls back to this
// page when the user is offline. Port of the old `pages/offline.jsx`:
// empty-state layout (the old shared empty-state styles are inlined
// in css/portfolio.css), cloud-off icon, "Try again" reload button.
import config from "porto:config";
import BaseLayout from "../layouts/BaseLayout.astro";
import { pageTitle } from "../utils/content.ts";
import { renderIcon } from "../utils/icons.ts";

const title = pageTitle("You're Offline", config.site.title);
---

<BaseLayout title={title} description="You're offline">
  <div class="porto-empty-state">
    <div class="porto-empty-state-icon">
      <span
        set:html={renderIcon("line-md:cloud-alt-off-loop", { size: "5rem" })}
      />
    </div>
    <h2 class="porto-empty-state-title">You're Offline</h2>
    <p class="porto-empty-state-text">
      It looks like you don't have an internet connection. Previously visited
      pages are still available from cache.
    </p>
    <button type="button" class="porto-link-button primary" data-reload>
      Try again
    </button>
  </div>

  <script>
    const button = document.querySelector("[data-reload]");
    if (button) {
      button.addEventListener("click", () => {
        window.location.reload();
      });
    }
  </script>
</BaseLayout>
