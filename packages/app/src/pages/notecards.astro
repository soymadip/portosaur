---
// NoteCards page (`/notes`) — exists in both modes.
//
// The page title is the capitalized notes route ("Docs" in docs mode,
// "Notes" in portfolio mode — the Docusaurus `pages/notes.jsx` rule);
// the h1 is always "My Notes". The page filters the notes collection to
// top-level files + top-level dirs with an index (the old NoteCards
// filter, translated from `require.context` keys to collection ids) and
// passes the entries to NoteCards, which parses and sorts them.
//
// Hash navigation (hash scroll-to-card + highlight/blur overlay) comes
// from the shared `hash-navigation` module; its styles are `:global()`
// rules below because the classes land on elements owned by NoteCards
// and on a JS-created overlay. The scroll button is the full NavArrow
// component (next-section / back-to-top), ported from the old theme.
import { getCollection } from "astro:content";
import config from "porto:config";
import BaseLayout from "../layouts/BaseLayout.astro";
import NoteCards from "../components/sections/NoteCards.astro";
import NavArrow from "../components/NavArrow.astro";
import { pageTitle, isIndexEntry } from "../utils/content.ts";

const siteTitle = config.site.title;
const notesRoute = config.site.notesRoute;

const pageName = notesRoute.charAt(0).toUpperCase() + notesRoute.slice(1);
const title = pageTitle(pageName, siteTitle);

// The old NoteCards filter, on collection ids: a top-level file
// (single segment, not an index) or a top-level dir with an index
// (two segments, second one an index/README). The root index (single
// segment, an index) matches neither and is excluded.
const notes = (await getCollection("notes")).filter((entry) => {
  const segments = entry.id.split("/");
  if (isIndexEntry(entry)) {
    return segments.length === 2;
  }
  return segments.length === 1;
});
---

<BaseLayout title={title} description={`My ${pageName}`}>
  <div class="notesContainer flex flex-1 flex-col items-center justify-center pb-[8vh]">
    <div class="container">
      <header class="mb-4 text-center">
        <h1 class="mt-[1.3rem] mb-2 animate-[slideUp_0.6s_cubic-bezier(0.2,0.8,0.2,1)_forwards] text-center text-[2.5rem] text-primary">
          My Notes
        </h1>
        <p class="mb-4 animate-[slideUp_0.6s_cubic-bezier(0.2,0.8,0.2,1)_0.15s_forwards] text-center text-[0.9rem] text-muted">
          A collection of my self written notes &amp; reference guides
        </p>
      </header>
      <NoteCards notes={notes} />
      <NavArrow />
    </div>
  </div>

  <script>
    import { initHashNavigation } from "../scripts/hash-navigation.ts";

    initHashNavigation({
      elementPrefix: "note-",
      // The card class is `noteCard` (the old ".note-card" selector never
      // matched the hashed CSS-module class, so the blur never applied).
      elementSelector: ".noteCard",
      containerSelector: ".notesContainer",
      effectDuration: 6000,
    });
  </script>
</BaseLayout>

<style>
  /* Hash-navigation effect styles (ported from the old
     utils/HashNavigation.jsx style injection). Global rules: the
     classes are added by the script to NoteCards' cards and to a
     JS-created overlay, so scoped selectors would not match.
     `notesContainer` keeps its class in the markup as the script's
     container selector; only its layout moved to utilities. */
  .notesContainer.hash-nav-active {
    position: relative;
  }

  .notesContainer.hash-nav-active::after {
    content: "";
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: color-mix(in srgb, var(--color-surface) 50%, transparent);
    z-index: 10;
    pointer-events: none;
  }

  :global(.hash-nav-highlight) {
    position: relative;
    z-index: 20;
    transform: scale(1.05);
    box-shadow: 0 0 30px 10px var(--color-primary);
    transition: all 0.3s ease;
  }

  :global(.hash-nav-blur) {
    filter: blur(4px) grayscale(70%) brightness(0.8);
    opacity: 0.3;
    transition: all 0.3s ease;
    background-color: color-mix(in srgb, var(--color-surface) 15%, transparent);
    pointer-events: none;
  }

  :global(.hash-nav-overlay) {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 15;
    cursor: pointer;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.hash-nav-highlight),
    :global(.hash-nav-blur) {
      transition: none !important;
    }

    :global(.hash-nav-highlight) {
      transform: none !important;
    }

    :global(.hash-nav-blur) {
      filter: opacity(0.3);
      background-color: color-mix(
        in srgb,
        var(--color-surface) 15%,
        transparent
      );
    }
  }
</style>
