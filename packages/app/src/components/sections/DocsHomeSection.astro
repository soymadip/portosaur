---
// DocsHomeSection — docs landing: icon/title/tagline/desc, action
// buttons, feature cards (with optional links). Reads config directly
// from `porto:config`.
//
// The hero layout is OG's (main branch `DocsHomeSection`): a
// two-column hero — text left (title, tagline, description,
// actions), image right with a primary glow behind it — restyled in
// the current design language (Starlight-derived tokens, the shared
// `.porto-link-button` actions). The feature cards are Starlight's
// Card + CardGrid user-components (renamed `sl-` → `porto-`),
// derived in part from Starlight (MIT License) — see
// packages/app/NOTICE.md — except the icon chips, which are OG's:
// a uniform neutral gray background with the icon in the primary
// color, no per-card accent rotation (main branch `featureIcon`).
//
// Portosaur differences from OG's hero:
// - Feature titles stay <h2> (they are part of the page's heading
//   list and the frozen URL snapshots) instead of Starlight's <p>.
// - Actions take Portosaur's shape ({ label/text, link, icon }) with
//   devicon/emoji icons via renderDynamicIcon; the first action is
//   primary, the rest secondary.
// - The hero image goes through Astro's `<Image />` when it is a
//   local file the build can size (remote URLs and unsizable files
//   keep a plain `<img>`, with the `onerror` fallback either way).
// - Entrance animations are dropped (the current design language
//   has none); the title hover underline, the image glow and the
//   image hover lift stay.
import { Image } from "astro:assets";
import config from "porto:config";
import { PAGE_TITLE_ID } from "../../constants.ts";
import { renderDynamicIcon, withBase } from "../../utils/icons.ts";
import {
  localImageDimensions,
  staticDirsForConfig,
} from "../../utils/imageSize.ts";

const docsHome = config.docsHome;

const base = config.site.baseUrl;
const icon = docsHome?.icon;
const iconRawSrc = icon ? (typeof icon === "string" ? icon : icon.src) : null;
const iconSrc = iconRawSrc ? withBase(iconRawSrc, base) : null;
const iconFallback =
  icon && typeof icon === "object" && icon.fallback
    ? withBase(icon.fallback, base)
    : null;
const iconDims = iconRawSrc
  ? await localImageDimensions(iconRawSrc, staticDirsForConfig(config))
  : null;
const iconOnError = iconFallback
  ? `this.onerror=null;this.src='${iconFallback}'`
  : undefined;
---

{docsHome && (
  <div class="docs-home">
    <div class="hero">
      <div class="porto-flex stack">
        <div class="porto-flex copy">
          <h1 id={PAGE_TITLE_ID}>{docsHome.title}</h1>
          {docsHome.tagline && <div class="tagline">{docsHome.tagline}</div>}
          {docsHome.desc && <p class="desc">{docsHome.desc}</p>}
        </div>
        {docsHome.actions && docsHome.actions.length > 0 && (
          <div class="porto-flex actions">
            {docsHome.actions.map((action, index) => (
              <a
                href={withBase(action.link, base)}
                class:list={[
                  "porto-link-button",
                  index === 0 ? "primary" : "secondary",
                ]}
              >
                {action.icon && (
                  <span
                    class="action-icon"
                    set:html={renderDynamicIcon(action.icon, { base })}
                  />
                )}
                {action.label || action.text}
              </a>
            ))}
          </div>
        )}
      </div>
      <div class="hero-icon">
        {icon && iconDims ? (
          <Image
            src={iconSrc}
            alt="Hero"
            width={iconDims.width}
            height={iconDims.height}
            loading="eager"
            fetchpriority="high"
            decoding="async"
            onerror={iconOnError}
          />
        ) : (
          icon && (
            <img
              src={iconSrc}
              alt="Hero"
              loading="eager"
              fetchpriority="high"
              decoding="async"
              width="400"
              height="400"
              onerror={iconOnError}
            />
          )
        )}
      </div>
    </div>

    {docsHome.features && docsHome.features.length > 0 && (
      <section class="features">
        <div class="card-grid">
          {docsHome.features.map((feature) => {
            const inner = (
              <>
                <div class="title-row porto-flex">
                  {feature.icon && (
                    <span
                      class="icon"
                      set:html={renderDynamicIcon(feature.icon, { base })}
                    />
                  )}
                  <h2 class="title">{feature.title}</h2>
                </div>
                <div class="body">
                  <p>{feature.details || feature.desc}</p>
                </div>
              </>
            );
            return feature.link ? (
              <a
                href={withBase(feature.link, base)}
                class="card porto-flex card-link"
              >
                {inner}
              </a>
            ) : (
              <div class="card porto-flex">{inner}</div>
            );
          })}
        </div>
      </section>
    )}
  </div>
)}

<style>
  @layer porto.core {
    .docs-home {
      max-width: 72rem;
      margin-inline: auto;
      padding-inline: 1rem;
    }

    /* Hero — OG's layout (main branch `DocsHomeSection`): text left,
       image right with a primary glow behind it. Mobile stacks
       image-on-top, text centered (`column-reverse` — the text comes
       first in the DOM, like OG). */
    .hero {
      display: flex;
      flex-direction: column-reverse;
      align-items: center;
      gap: 2rem;
      padding-block: 3.5rem 3rem;
    }

    .stack {
      flex-direction: column;
      gap: 1.5rem;
      text-align: center;
      max-width: 700px;
    }

    .copy {
      flex-direction: column;
      gap: 1rem;
      align-items: center;
    }

    .hero h1 {
      position: relative;
      display: inline-block;
      margin: 0;
      font-size: clamp(2.7rem, calc(0.25rem + 5vw), var(--porto-text-6xl));
      line-height: 1.05;
      font-weight: 700;
      color: var(--porto-color-text-accent);
      transition: transform 0.3s ease;
    }

    .hero h1:hover {
      transform: translateY(-2px);
    }

    .hero h1::after {
      content: "";
      position: absolute;
      width: 0;
      height: 4px;
      bottom: -2px;
      left: 0;
      background-color: var(--porto-color-text-accent);
      transition: width 0.3s ease;
    }

    .hero h1:hover::after {
      width: 100%;
    }

    .tagline {
      font-size: clamp(1.7rem, calc(0.5rem + 3vw), 2.34rem);
      font-weight: 600;
      line-height: 1.2;
      color: var(--porto-color-white);
    }

    .desc {
      margin: 0;
      font-size: var(--porto-text-lg);
      line-height: 1.5;
      color: var(--porto-color-gray-2);
    }

    .actions {
      gap: 1rem;
      flex-wrap: wrap;
      justify-content: center;
    }

    .action-icon {
      display: inline-flex;
      align-items: center;
    }

    /* The hero image, capped by height like OG (280px desktop,
       180px mobile) with its squircle radius and primary glow. */
    .hero-icon {
      position: relative;
      display: flex;
      justify-content: center;
      align-items: center;
      flex: 1;
    }

    .hero-icon::before {
      content: "";
      position: absolute;
      inset: -10%;
      border-radius: 50%;
      background: radial-gradient(
        ellipse at center,
        color-mix(in srgb, var(--porto-color-text-accent) 35%, transparent) 0%,
        transparent 70%
      );
      filter: blur(40px);
      z-index: 0;
    }

    /* `:global(img)`: the hero image renders through Astro's
       `<Image />` (a child component), whose `<img>` carries no
       scope attribute — a scoped `img` selector would not match it
       (the plain-`<img>` fallback branch matches either way). */
    .hero-icon > :global(img) {
      position: relative;
      z-index: 1;
      object-fit: cover;
      width: auto;
      height: auto;
      max-width: 100%;
      max-height: 180px;
      border-radius: 20%;
      transition:
        transform 0.4s cubic-bezier(0.25, 0.8, 0.25, 1),
        box-shadow 0.4s cubic-bezier(0.25, 0.8, 0.25, 1);
    }

    .hero-icon > :global(img):hover {
      transform: translateY(-6px) scale(1.02);
      box-shadow: var(--porto-shadow-md);
    }

    @media (min-width: 50rem) {
      .hero {
        flex-direction: row;
        justify-content: space-between;
      }

      .stack {
        flex: 1.2;
        text-align: start;
      }

      .copy {
        align-items: flex-start;
      }

      .actions {
        justify-content: flex-start;
      }

      .hero-icon > :global(img) {
        max-height: 280px;
      }
    }
  }

  @layer porto.components {
    /* The action buttons use the shared `.porto-link-button`
       (Starlight's LinkButton, in css/portfolio.css). */

    /* CardGrid + Card — from Starlight's CardGrid/Card
       user-components. */
    .features {
      padding-block: 1rem 2rem;
    }

    .card-grid {
      display: grid;
      grid-template-columns: 100%;
      gap: 1rem;
    }

    .card-grid > :global(*) {
      margin-top: 0 !important;
    }

    .card {
      border: 1px solid var(--porto-color-gray-5);
      background-color: var(--porto-color-black);
      padding: clamp(1rem, calc(0.125rem + 3vw), 2.5rem);
      flex-direction: column;
      gap: clamp(0.5rem, calc(0.125rem + 1vw), 1rem);
    }

    .card-link {
      text-decoration: none;
      color: inherit;
    }
    .card-link:hover {
      border-color: var(--porto-color-gray-2);
    }

    /* The icon chip sits BESIDE the <h2>, not inside it — an emoji
       icon inside the heading would enter the page's heading text
       (the frozen URL snapshots capture h2 text). */
    .title-row {
      gap: 1rem;
      align-items: center;
    }

    .title {
      margin: 0;
      font-weight: 600;
      font-size: var(--porto-text-h4);
      color: var(--porto-color-white);
      line-height: var(--porto-line-height-headings);
    }

    /* OG's icon chip (main branch `featureIcon`): a uniform neutral
       gray background — OG's `--ifm-color-emphasis-200`, a 15% text
       tint over the card background — with the icon in the primary
       color and no border. (Starlight's chips rotate a per-card
       accent color; OG's are all the same.) */
    .card .icon {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      background-color: color-mix(
        in srgb,
        var(--porto-color-gray-1) 15%,
        var(--porto-color-black)
      );
      color: var(--porto-color-text-accent);
      padding: 0.2em;
      border-radius: 0.5rem;
      flex-shrink: 0;
      font-size: 1.333em;
    }

    .card .body {
      margin: 0;
      font-size: clamp(
        var(--porto-text-sm),
        calc(0.5rem + 1vw),
        var(--porto-text-body)
      );
    }

    .card .body p {
      margin: 0;
      line-height: 1.5;
      color: var(--porto-color-gray-2);
    }

    @media (min-width: 50rem) {
      .card-grid {
        grid-template-columns: 1fr 1fr;
        gap: 1.5rem;
      }
    }
  }
</style>
