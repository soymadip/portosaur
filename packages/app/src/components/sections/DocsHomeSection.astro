---
// DocsHomeSection — docs landing: icon/title/tagline/desc, action
// buttons, feature cards (with optional links). Reads config directly
// from `porto:config`.
//
// A port of main branch `DocsHomeSection` (Docusaurus) — the whole
// page, hero and feature cards alike, translated to the current
// token system. The earlier hybrid (OG hero + Starlight feature
// cards) is gone: the user asked for OG's page, not a mix of the two.
//
// Token mapping from OG's Docusaurus variables:
// - `--ifm-color-primary` → `--porto-color-text-accent`; primary-light
//   (brand-button hover) has no token, so it is the accent mixed 20%
//   toward white.
// - `--ifm-heading-color` → `--porto-color-white`.
// - `--ifm-color-emphasis-100` (card bg) → `--porto-color-gray-6`
//   (16% dark / 94% light, matching emphasis-100 in both modes).
// - `--ifm-color-emphasis-200` (icon chip bg, mobile card border) → a
//   15% gray-1 tint over black, as established for the chips.
// - `--ifm-color-emphasis-300` (card hover, alt button) → a 20% tint;
//   `--ifm-color-emphasis-400` (alt-button hover) → a 30% tint.
// - `--ifm-color-emphasis-600` (descriptions) → `--porto-color-gray-3`
//   (the scheme's text-muted token — exactly OG's #a1a1aa dark /
//   #52525b light in the portosaur scheme; gray-2 is body text and
//   reads white)
//   (the body-text color).
// - `--ifm-color-black` (brand-button text) → `--porto-color-black`,
//   matching the shared link button.
// - `--ifm-font-color-base` (alt-button text) → `--porto-color-text`.
// - `--ifm-global-shadow-md` → `--porto-shadow-md`.
//
// Divergences from OG:
// - The tagline hover in OG also recolors to `--porto-secondary`, but
//   the secondary token was dropped with the old token set, so the
//   hover keeps the lift only.
// - OG's `.heroIcon:hover::before { opacity: 1.3 }` is dead code (the
//   `floatIn` fill overrides it), so it is not ported.
// - The hero image hover lift is removed entirely: on touch it sticks
//   after tapping.
// - On small phones (≤480px) the hero section's side padding drops
//   from OG's 2rem to 1rem so the tagline and description get more
//   room; OG's `-0.8rem` negative margin on the description is gone
//   (against 1rem it would push the text to the viewport edge).
// - Where the hero stacks (≤996px) the section's top padding drops
//   from OG's 3.5rem to 2rem so the icon sits closer to the navbar;
//   the glow still has room to fade above the image (it extends
//   ~10% + blur past the icon box, and fades to transparent).
// - The action icons are 1.25rem (OG inherits the button's 1rem)
//   and centered on the text line with an inline-flex wrapper —
//   a bare inline SVG/emoji sits on the baseline and reads high.
// - A `prefers-reduced-motion` guard is added: OG's entrance
//   animations start at `opacity: 0`, which would hide content for
//   users who disable animation.
// - The hero image goes through Astro's `<Image />` when it is a
//   local file the build can size (remote URLs and unsizable files
//   keep a plain `<img>`, with the `onerror` fallback either way).
// - Actions take Portosaur's shape ({ label/text, link, icon }) with
//   devicon/emoji icons via renderDynamicIcon; the first action is
//   brand, the rest alt.
import { Image } from "astro:assets";
import config from "porto:config";
import { PAGE_TITLE_ID } from "../../constants.ts";
import { renderDynamicIcon, withBase } from "../../utils/icons.ts";
import {
  localImageDimensions,
  staticDirsForConfig,
} from "../../utils/imageSize.ts";

const docsHome = config.docsHome;

const base = config.site.baseUrl;
const icon = docsHome?.icon;
const iconRawSrc = icon ? (typeof icon === "string" ? icon : icon.src) : null;
const iconSrc = iconRawSrc ? withBase(iconRawSrc, base) : null;
const iconFallback =
  icon && typeof icon === "object" && icon.fallback
    ? withBase(icon.fallback, base)
    : null;
const iconDims = iconRawSrc
  ? await localImageDimensions(iconRawSrc, staticDirsForConfig(config))
  : null;
const iconOnError = iconFallback
  ? `this.onerror=null;this.src='${iconFallback}'`
  : undefined;
---

{docsHome && (
  <div class="docs-home">
    <header class="hero-section">
      <div class="hero-container">
        <div class="hero-text">
          <h1 class="title" id={PAGE_TITLE_ID}>
            {docsHome.title}
          </h1>
          {docsHome.tagline && <p class="tagline">{docsHome.tagline}</p>}
          {docsHome.desc && <p class="description">{docsHome.desc}</p>}
          {docsHome.actions && docsHome.actions.length > 0 && (
            <div class="actions">
              {docsHome.actions.map((action, index) => (
                <a
                  href={withBase(action.link, base)}
                  class:list={[
                    "button",
                    index === 0 ? "button-brand" : "button-alt",
                  ]}
                >
                  {action.icon && (
                    <span
                      class="action-img"
                      set:html={renderDynamicIcon(action.icon, { base })}
                    />
                  )}
                  {action.label || action.text}
                </a>
              ))}
            </div>
          )}
        </div>
        {icon && (
          <div class="hero-icon">
            {iconDims ? (
              <Image
                src={iconSrc}
                alt="Hero"
                width={iconDims.width}
                height={iconDims.height}
                loading="eager"
                fetchpriority="high"
                decoding="async"
                onerror={iconOnError}
              />
            ) : (
              <img
                src={iconSrc}
                alt="Hero"
                loading="eager"
                fetchpriority="high"
                decoding="async"
                width="400"
                height="400"
                onerror={iconOnError}
              />
            )}
          </div>
        )}
      </div>
    </header>

    {docsHome.features && docsHome.features.length > 0 && (
      <section class="features-section">
        <div class="features-container">
          {docsHome.features.map((feature, index) => {
            const Tag = feature.link ? "a" : "div";
            return (
              <Tag
                class="feature-card"
                style={{ "--animation-order": index }}
                href={feature.link ? withBase(feature.link, base) : undefined}
              >
                {feature.icon && (
                  <div
                    class="feature-icon"
                    set:html={renderDynamicIcon(feature.icon, { base })}
                  />
                )}
                <div class="feature-content">
                  {/* Feature titles stay <h2>: that is what OG uses, and
                  the heading list in the URL snapshots expects it. */}
                  <h2 class="feature-title">{feature.title}</h2>
                  <p class="feature-desc">{feature.details || feature.desc}</p>
                </div>
              </Tag>
            );
          })}
        </div>
      </section>
    )}
  </div>
)}

<style>
  @layer porto.core {
    .docs-home {
      width: 100%;
    }

    @keyframes slide-up-fade {
      from {
        opacity: 0;
        transform: translateY(20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes float-in {
      from {
        opacity: 0;
        transform: translateY(10px) scale(0.98);
      }
      to {
        opacity: 1;
        transform: translateY(0) scale(1);
      }
    }

    .hero-section {
      padding: 3.5rem 2rem 3rem;
      display: flex;
      justify-content: center;
    }

    .hero-container {
      display: flex;
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      width: 100%;
      max-width: 72rem;
      gap: 2rem;
    }

    .hero-text {
      flex: 1.2;
      text-align: left;
      max-width: 700px;
    }

    .title {
      font-size: 4.1rem;
      font-weight: 700;
      line-height: 1.05;
      margin-bottom: 0;
      color: var(--porto-color-text-accent);
      transition: all 0.3s ease;
      position: relative;
      display: inline-block;
      opacity: 0;
      animation: slide-up-fade 0.7s cubic-bezier(0.25, 0.8, 0.25, 1) 0.1s
        forwards;
    }

    .title:hover {
      transform: translateY(-2px);
    }

    .title::after {
      content: "";
      position: absolute;
      width: 0;
      height: 4px;
      bottom: -2px;
      left: 0;
      background-color: var(--porto-color-text-accent);
      transition: width 0.3s ease;
    }

    .title:hover::after {
      width: 100%;
    }

    .tagline {
      font-size: 2.34rem;
      font-weight: 600;
      line-height: 1.2;
      color: var(--porto-color-white);
      margin-top: 0.5rem;
      margin-bottom: 1rem;
      transition: all 0.3s ease;
      position: relative;
      display: inline-block;
      opacity: 0;
      animation: slide-up-fade 0.7s cubic-bezier(0.25, 0.8, 0.25, 1) 0.2s
        forwards;
    }

    /* OG also recolors the tagline on hover, but the secondary token
       it uses no longer exists (see the header comment). */
    .tagline:hover {
      transform: translateY(-2px);
    }

    .description {
      font-size: 1.17rem;
      line-height: 1.4;
      color: var(--porto-color-gray-3);
      margin-bottom: 1.5rem;
      opacity: 0;
      animation: slide-up-fade 0.7s cubic-bezier(0.25, 0.8, 0.25, 1) 0.3s
        forwards;
    }

    .actions {
      display: flex;
      flex-wrap: wrap;
      gap: 1rem;
      opacity: 0;
      animation: slide-up-fade 0.7s cubic-bezier(0.25, 0.8, 0.25, 1) 0.4s
        forwards;
    }

    .button {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.6rem 1.4rem;
      font-size: 1rem;
      font-weight: 600;
      border-radius: 999px;
      text-decoration: none;
      transition:
        background-color 0.2s ease,
        border-color 0.2s ease,
        transform 0.2s ease;
    }

    .button:hover {
      text-decoration: none;
      transform: translateY(-2px);
      box-shadow: var(--porto-shadow-md);
    }

    .button-brand {
      background-color: var(--porto-color-text-accent);
      color: var(--porto-color-black);
    }

    .button-brand:hover {
      background-color: color-mix(
        in srgb,
        var(--porto-color-text-accent) 80%,
        white
      );
      color: var(--porto-color-black);
    }

    .button-alt {
      background-color: color-mix(
        in srgb,
        var(--porto-color-gray-1) 20%,
        var(--porto-color-black)
      );
      color: var(--porto-color-text);
    }

    .button-alt:hover {
      background-color: color-mix(
        in srgb,
        var(--porto-color-gray-1) 30%,
        var(--porto-color-black)
      );
      color: var(--porto-color-text);
    }

    /* Action icons: bigger than OG's inherited 1rem, and centered
       on the text line — a bare inline SVG/emoji sits on the
       baseline and reads high, so the wrapper is inline-flex. */
    .action-img {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 1.25rem;
    }

    .hero-icon {
      flex: 1;
      position: relative;
      display: flex;
      justify-content: center;
      align-items: center;
    }

    /* Glow behind the hero image */
    .hero-icon::before {
      content: "";
      position: absolute;
      inset: -10%;
      border-radius: 50%;
      background: radial-gradient(
        ellipse at center,
        color-mix(in srgb, var(--porto-color-text-accent) 35%, transparent) 0%,
        transparent 70%
      );
      filter: blur(40px);
      z-index: 0;
      opacity: 0;
      animation: float-in 1s ease 0.4s forwards;
    }

    /* `:global(img)`: the hero image renders through Astro's
       `<Image />` (a child component), whose `<img>` carries no
       scope attribute — a scoped `img` selector would not match it
       (the plain-`<img>` fallback branch matches either way). */
    .hero-icon > :global(img) {
      position: relative;
      z-index: 1;
      max-width: 100%;
      /* `width: auto` is not in OG's rule, but OG's `<img>` carries no
         width/height attributes — Astro's `<Image />` does, and without
         it the max-height cap distorts the box and `object-fit: cover`
         crops the image. */
      width: auto;
      height: auto;
      max-height: 280px;
      object-fit: cover;
      border-radius: 20%;
      opacity: 0;
      animation: float-in 0.9s cubic-bezier(0.25, 0.8, 0.25, 1) 0.5s forwards;
    }

    /* No hover effect on the hero image: OG lifts it on hover, but
       on touch that state sticks after tapping. */

    @media (max-width: 996px) {
      /* Less space above the icon where the hero stacks (the icon
         sits on top here). The glow still fades above the image —
         it extends past the icon box and is transparent at the
         edge, so nothing looks cut off. */
      .hero-section {
        padding-top: 2rem;
      }

      .hero-container {
        flex-direction: column-reverse;
        text-align: center;
      }

      .hero-text {
        text-align: center;
        max-width: 100%;
        margin-top: 0;
      }

      .title {
        font-size: 2.7rem;
      }

      .tagline {
        font-size: 1.7rem;
      }

      .description {
        font-size: 1.1rem;
      }

      .actions {
        justify-content: center;
      }

      .hero-icon {
        width: 100%;
        margin-bottom: 0;
      }

      .hero-icon > :global(img) {
        max-height: 180px;
      }
    }

    @media (max-width: 480px) {
      /* Tighter side padding on small phones: OG's 2rem leaves the
         tagline and description squeezed, so the whole hero gets
         1rem instead. OG's -0.8rem negative margin on the
         description is gone — against 1rem it would push the text
         to the viewport edge. */
      .hero-section {
        padding-inline: 1rem;
      }

      .title {
        font-size: 2.6rem;
      }

      .tagline {
        font-size: 1.5rem;
      }

      .hero-icon {
        margin-top: 0.8rem;
      }

      .hero-icon > :global(img) {
        max-height: 160px;
      }

      .button {
        flex: 0 0 auto;
        justify-content: center;
        gap: 0.35rem;
        padding: 0.6rem 0.45rem;
        font-size: 0.8rem;
        white-space: nowrap;
      }

      .action-img {
        flex-shrink: 0;
      }
    }

    @media (max-width: 359px) {
      .actions {
        gap: 0.25rem;
      }

      .button {
        gap: 0.25rem;
        padding: 0.55rem 0.35rem;
        font-size: 0.75rem;
      }
    }
  }

  @layer porto.components {
    /* Features Grid */
    .features-section {
      padding: 0.7rem;
      padding-bottom: 0.4rem;
      display: flex;
      justify-content: center;
    }

    .features-container {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      grid-auto-rows: minmax(205px, auto);
      gap: 1rem;
      width: 100%;
      max-width: 72rem;
    }

    .feature-card {
      background-color: var(--porto-color-gray-6);
      border-radius: 12px;
      padding: 1.5rem;
      display: flex;
      flex-direction: column;
      opacity: 0;
      animation: slide-up-fade 0.7s cubic-bezier(0.25, 0.8, 0.25, 1) forwards;
      animation-delay: calc(0.5s + var(--animation-order, 0) * 0.15s);
      transition:
        transform 0.2s ease,
        background-color 0.2s ease;
    }

    a.feature-card,
    a.feature-card:hover {
      color: inherit;
      text-decoration: none;
    }

    a.feature-card:focus-visible {
      outline: 2px solid var(--porto-color-text-accent);
      outline-offset: 3px;
    }

    .feature-card:hover {
      background-color: color-mix(
        in srgb,
        var(--porto-color-gray-1) 20%,
        var(--porto-color-black)
      );
    }

    .feature-icon {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 48px;
      height: 48px;
      background-color: color-mix(
        in srgb,
        var(--porto-color-gray-1) 15%,
        var(--porto-color-black)
      );
      border-radius: 8px;
      margin-bottom: 1rem;
      color: var(--porto-color-text-accent);
      font-size: 26px;
    }

    /* `:global(...)`: the icons come from renderDynamicIcon (raw HTML
       via set:html), so their svg/img children carry no scope
       attribute. */
    .feature-icon :global(svg),
    .feature-icon :global(div svg),
    .feature-icon :global(span svg),
    .feature-icon :global(img) {
      width: 24px;
      height: 24px;
    }

    .feature-content {
      width: 100%;
    }

    .feature-title {
      font-size: 1.2rem;
      font-weight: 600;
      margin-bottom: 0.5rem;
      color: var(--porto-color-white);
    }

    .feature-desc {
      font-size: 0.95rem;
      color: var(--porto-color-gray-3);
      margin: 0;
      line-height: 1.5;
    }

    @media (max-width: 996px) {
      .feature-icon {
        margin-bottom: 0.5rem;
      }

      .features-section {
        padding-bottom: 3.4rem;
      }
    }

    @media (max-width: 480px) {
      .features-section {
        padding: 0.25rem 0.7rem 0.8rem;
      }

      .features-container {
        grid-template-columns: minmax(0, 1fr);
        grid-auto-rows: auto;
        gap: 0.5rem;
      }

      .feature-card {
        flex-direction: row;
        align-items: center;
        gap: 0.85rem;
        padding: 0.85rem;
        border: 1px solid
          color-mix(
            in srgb,
            var(--porto-color-gray-1) 15%,
            var(--porto-color-black)
          );
        border-radius: 8px;
      }

      .feature-card:hover {
        background-color: var(--porto-color-gray-6);
      }

      .feature-icon {
        flex: 0 0 2.5rem;
        width: 2.5rem;
        height: 2.5rem;
        margin: 0;
        font-size: 1.35rem;
      }

      .feature-icon :global(svg),
      .feature-icon :global(div svg),
      .feature-icon :global(span svg),
      .feature-icon :global(img) {
        width: 1.25rem;
        height: 1.25rem;
      }

      .feature-content {
        flex: 1;
        min-width: 0;
      }

      .feature-title {
        font-size: 1.05rem;
        line-height: 1.25;
        margin-bottom: 0.25rem;
      }

      .feature-desc {
        font-size: 0.9rem;
        line-height: 1.45;
      }
    }

    /* Entrance animations start at `opacity: 0`; users who disable
       animation must still see the content. This sits in the later
       layer so it wins over the base rules in both layers. */
    @media (prefers-reduced-motion: reduce) {
      .title,
      .tagline,
      .description,
      .actions,
      .hero-icon::before,
      .hero-icon > :global(img),
      .feature-card {
        animation: none;
        opacity: 1;
      }
    }
  }
</style>
