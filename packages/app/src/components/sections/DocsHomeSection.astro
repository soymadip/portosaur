---
// DocsHomeSection — ported from the old components/DocsHomeSection/index.jsx.
//
// Docs landing: icon/title/tagline/desc, action buttons, feature cards
// (with optional links). Reads config directly from `porto:config`.
//
// The old component preloaded the hero icon via a <Head> link; head tags
// belong to the layout in the Astro port, so the preload is dropped
// (the image itself still loads eagerly).
import config from "porto:config";
import { renderDynamicIcon, withBase } from "../../utils/icons.ts";

const docsHome = config.docsHome;

const base = config.site.baseUrl;
const icon = docsHome?.icon;
const iconSrc = icon
  ? withBase(typeof icon === "string" ? icon : icon.src, base)
  : null;
const iconFallback =
  icon && typeof icon === "object" && icon.fallback
    ? withBase(icon.fallback, base)
    : null;
---

{docsHome && (
  <div class="w-full font-body">
    <header class="flex justify-center px-8 pb-12 pt-14">
      <div class="flex w-full max-w-[1152px] flex-row items-center justify-between gap-8 max-[996px]:flex-col-reverse max-[996px]:text-center">
        <div class="max-w-[700px] flex-[1.2] text-left max-[996px]:max-w-full max-[996px]:text-center">
          <h1 class="relative mb-0 inline-block text-[4.1rem] font-bold leading-[1.05] text-primary opacity-0 transition-all duration-300 ease-[ease] after:absolute after:bottom-[-2px] after:left-0 after:h-1 after:w-0 after:bg-primary after:transition-[width] after:duration-300 after:ease-[ease] hover:transform-[translateY(-2px)] hover:after:w-full animate-[slideUpFade_0.7s_cubic-bezier(0.25,0.8,0.25,1)_0.1s_forwards] max-[996px]:text-[2.7rem] max-[480px]:text-[2.6rem]">
            {docsHome.title}
          </h1>
          {docsHome.tagline && (
            <p class="relative mb-4 mt-2 inline-block text-[2.34rem] font-semibold leading-[1.2] text-foreground opacity-0 transition-all duration-300 ease-[ease] hover:transform-[translateY(-2px)] hover:text-secondary animate-[slideUpFade_0.7s_cubic-bezier(0.25,0.8,0.25,1)_0.2s_forwards] max-[996px]:text-[1.7rem] max-[480px]:text-[1.5rem]">
              {docsHome.tagline}
            </p>
          )}
          {docsHome.desc && (
            <p class="mb-6 text-[1.17rem] leading-[1.4] text-gray-600 opacity-0 animate-[slideUpFade_0.7s_cubic-bezier(0.25,0.8,0.25,1)_0.3s_forwards] max-[996px]:text-[1.1rem] max-[480px]:mx-[-0.8rem]">
              {docsHome.desc}
            </p>
          )}

          {docsHome.actions && docsHome.actions.length > 0 && (
            <div class="flex flex-wrap gap-4 opacity-0 animate-[slideUpFade_0.7s_cubic-bezier(0.25,0.8,0.25,1)_0.4s_forwards] max-[996px]:justify-center max-[359px]:gap-1">
              {docsHome.actions.map((action, index) => (
                <a
                  href={withBase(action.link, base)}
                  class={`inline-flex items-center gap-2 rounded-full px-[1.4rem] py-[0.6rem] text-base leading-(--line-height) font-semibold no-underline transition-[background-color,border-color,transform] duration-200 ease-[ease] hover:-translate-y-0.5 hover:shadow-md max-[480px]:flex-[0_0_auto] max-[480px]:justify-center max-[480px]:gap-[0.35rem] max-[480px]:whitespace-nowrap max-[480px]:px-[0.45rem] max-[480px]:py-[0.6rem] max-[480px]:text-[0.8rem] max-[359px]:gap-1 max-[359px]:px-[0.35rem] max-[359px]:py-[0.55rem] max-[359px]:text-[0.75rem] ${index === 0 ? "bg-primary text-[#09090b] hover:bg-primary-light hover:text-[#09090b]" : "bg-gray-300 text-foreground hover:bg-gray-400 hover:text-foreground"}`}
                >
                  {action.icon && (
                    <span
                      class="max-[480px]:shrink-0"
                      set:html={renderDynamicIcon(action.icon, { base })}
                    />
                  )}
                  {action.label || action.text}
                </a>
              ))}
            </div>
          )}
        </div>

        {icon && (
          <div class="relative flex flex-1 items-center justify-center before:absolute before:inset-[-10%] before:z-0 before:rounded-full before:bg-[radial-gradient(ellipse_at_center,color-mix(in_srgb,var(--color-primary)_35%,transparent)_0%,transparent_70%)] before:opacity-0 before:blur-[40px] before:transition-opacity before:duration-400 before:ease-[ease] before:animate-[floatIn_1s_ease_0.4s_forwards] hover:before:opacity-[1.3] max-[996px]:w-full max-[480px]:mt-[0.8rem]">
            <img
              src={iconSrc}
              alt="Hero"
              loading="eager"
              fetchpriority="high"
              class="relative z-[1] max-h-[280px] max-w-full rounded-[20%] object-cover opacity-0 transition-[transform,box-shadow] duration-400 ease-[cubic-bezier(0.25,0.8,0.25,1)] hover:transform-[translateY(-6px)_scale(1.02)] hover:shadow-lg animate-[floatIn_0.9s_cubic-bezier(0.25,0.8,0.25,1)_0.5s_forwards] max-[996px]:max-h-[180px] max-[480px]:max-h-[160px]"
              onerror={
                iconFallback
                  ? `this.onerror=null;this.src='${iconFallback}'`
                  : undefined
              }
            />
          </div>
        )}
      </div>
    </header>

    {docsHome.features && docsHome.features.length > 0 && (
      <section class="flex justify-center p-[0.7rem] pb-[0.4rem] max-[996px]:pb-[3.4rem] max-[480px]:px-[0.7rem] max-[480px]:pb-[0.8rem] max-[480px]:pt-1">
        <div class="grid w-full max-w-[1152px] auto-rows-[minmax(205px,auto)] grid-cols-[repeat(auto-fit,minmax(280px,1fr))] gap-4 max-[480px]:auto-rows-auto max-[480px]:grid-cols-[minmax(0,1fr)] max-[480px]:gap-2">
          {docsHome.features.map((feature, index) => {
            const inner = (
              <>
                {feature.icon && (
                  <div class="mb-4 flex size-12 items-center justify-center rounded-lg bg-gray-200 text-[26px] text-primary [&_img]:size-6 [&_svg]:size-6 max-[996px]:mb-2 max-[480px]:m-0 max-[480px]:size-10 max-[480px]:flex-[0_0_2.5rem] max-[480px]:text-[1.35rem] max-[480px]:[&_img]:size-5 max-[480px]:[&_svg]:size-5">
                    <span
                      set:html={renderDynamicIcon(feature.icon, { base })}
                    />
                  </div>
                )}
                <div class="w-full max-[480px]:min-w-0 max-[480px]:flex-1">
                  <h2 class="mb-2 text-[1.2rem] font-semibold text-foreground max-[480px]:mb-1 max-[480px]:text-[1.05rem] max-[480px]:leading-[1.25]">
                    {feature.title}
                  </h2>
                  <p class="m-0 text-[0.95rem] leading-[1.5] text-gray-600 max-[480px]:text-[0.9rem] max-[480px]:leading-[1.45]">
                    {feature.details || feature.desc}
                  </p>
                </div>
              </>
            );
            const style = `--animation-order: ${index}`;
            return feature.link ? (
              <a
                href={withBase(feature.link, base)}
                class="flex flex-col rounded-xl bg-gray-100 p-6 text-inherit no-underline opacity-0 transition-[transform,background-color] duration-200 ease-[ease] hover:bg-gray-300 focus-visible:outline-2 focus-visible:outline-primary focus-visible:outline-offset-[3px] animate-[slideUpFade_0.7s_cubic-bezier(0.25,0.8,0.25,1)_calc(0.5s+var(--animation-order,0)*0.15s)_forwards] max-[480px]:flex-row max-[480px]:items-center max-[480px]:gap-[0.85rem] max-[480px]:rounded-lg max-[480px]:border max-[480px]:border-gray-200 max-[480px]:p-[0.85rem] max-[480px]:hover:bg-gray-100"
                style={style}
              >
                {inner}
              </a>
            ) : (
              <div
                class="flex flex-col rounded-xl bg-gray-100 p-6 text-inherit no-underline opacity-0 transition-[transform,background-color] duration-200 ease-[ease] hover:bg-gray-300 focus-visible:outline-2 focus-visible:outline-primary focus-visible:outline-offset-[3px] animate-[slideUpFade_0.7s_cubic-bezier(0.25,0.8,0.25,1)_calc(0.5s+var(--animation-order,0)*0.15s)_forwards] max-[480px]:flex-row max-[480px]:items-center max-[480px]:gap-[0.85rem] max-[480px]:rounded-lg max-[480px]:border max-[480px]:border-gray-200 max-[480px]:p-[0.85rem] max-[480px]:hover:bg-gray-100"
                style={style}
              >
                {inner}
              </div>
            );
          })}
        </div>
      </section>
    )}
  </div>
)}

<style>
  /* `slideUpFade` (20px rise) and `floatIn` are local to this component:
     the global `slideUp` rises 30px, so it is not a substitute. Astro
     does not rename `@keyframes`, so the `animate-[slideUpFade_...]` /
     `animate-[floatIn_...]` utilities above resolve to these
     definitions. */
  @keyframes slideUpFade {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes floatIn {
    from {
      opacity: 0;
      transform: translateY(10px) scale(0.98);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }
</style>
