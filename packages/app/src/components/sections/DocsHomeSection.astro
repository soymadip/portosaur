---
// DocsHomeSection — docs landing: icon/title/tagline/desc, action
// buttons, feature cards (with optional links). Reads config directly
// from `porto:config`. Derived in part from Starlight (MIT License) —
// see packages/app/NOTICE.md: the hero layout comes from Starlight's
// Hero, the feature cards from its Card + CardGrid user-components
// (renamed `sl-` → `porto-`); the buttons use the shared
// `.porto-link-button` (Starlight's LinkButton, in css/portfolio.css).
//
// Portosaur differences from Starlight's splash:
// - Feature titles stay <h2> (they are part of the page's heading
//   list and the frozen URL snapshots) instead of Starlight's <p>.
// - Actions take Portosaur's shape ({ label/text, link, icon }) with
//   devicon/emoji icons via renderDynamicIcon; the first action is
//   primary, the rest secondary (Starlight's variants are per-action).
// - The hero image goes through Astro's `<Image />` when it is a
//   local file the build can size (remote URLs and unsizable files
//   keep a plain `<img>`, with the `onerror` fallback either way).
// - Entrance animations and the image glow are dropped.
import { Image } from "astro:assets";
import config from "porto:config";
import { PAGE_TITLE_ID } from "../../constants.ts";
import { renderDynamicIcon, withBase } from "../../utils/icons.ts";
import {
  localImageDimensions,
  staticDirsForConfig,
} from "../../utils/imageSize.ts";

const docsHome = config.docsHome;

const base = config.site.baseUrl;
const icon = docsHome?.icon;
const iconRawSrc = icon ? (typeof icon === "string" ? icon : icon.src) : null;
const iconSrc = iconRawSrc ? withBase(iconRawSrc, base) : null;
const iconFallback =
  icon && typeof icon === "object" && icon.fallback
    ? withBase(icon.fallback, base)
    : null;
const iconDims = iconRawSrc
  ? await localImageDimensions(iconRawSrc, staticDirsForConfig(config))
  : null;
const iconOnError = iconFallback
  ? `this.onerror=null;this.src='${iconFallback}'`
  : undefined;
---

{docsHome && (
  <div class="docs-home">
    <div class="hero">
      {icon && iconDims ? (
        <Image
          src={iconSrc}
          alt="Hero"
          width={iconDims.width}
          height={iconDims.height}
          loading="eager"
          fetchpriority="high"
          decoding="async"
          onerror={iconOnError}
        />
      ) : (
        icon && (
          <img
            src={iconSrc}
            alt="Hero"
            loading="eager"
            fetchpriority="high"
            decoding="async"
            width="400"
            height="400"
            onerror={iconOnError}
          />
        )
      )}
      <div class="porto-flex stack">
        <div class="porto-flex copy">
          <h1 id={PAGE_TITLE_ID}>{docsHome.title}</h1>
          {docsHome.tagline && <div class="tagline">{docsHome.tagline}</div>}
          {docsHome.desc && <p class="desc">{docsHome.desc}</p>}
        </div>
        {docsHome.actions && docsHome.actions.length > 0 && (
          <div class="porto-flex actions">
            {docsHome.actions.map((action, index) => (
              <a
                href={withBase(action.link, base)}
                class:list={[
                  "porto-link-button",
                  index === 0 ? "primary" : "secondary",
                ]}
              >
                {action.icon && (
                  <span
                    class="action-icon"
                    set:html={renderDynamicIcon(action.icon, { base })}
                  />
                )}
                {action.label || action.text}
              </a>
            ))}
          </div>
        )}
      </div>
    </div>

    {docsHome.features && docsHome.features.length > 0 && (
      <section class="features">
        <div class="card-grid">
          {docsHome.features.map((feature) => {
            const inner = (
              <>
                <div class="title-row porto-flex">
                  {feature.icon && (
                    <span
                      class="icon"
                      set:html={renderDynamicIcon(feature.icon, { base })}
                    />
                  )}
                  <h2 class="title">{feature.title}</h2>
                </div>
                <div class="body">
                  <p>{feature.details || feature.desc}</p>
                </div>
              </>
            );
            return feature.link ? (
              <a
                href={withBase(feature.link, base)}
                class="card porto-flex card-link"
              >
                {inner}
              </a>
            ) : (
              <div class="card porto-flex">{inner}</div>
            );
          })}
        </div>
      </section>
    )}
  </div>
)}

<style>
  @layer porto.core {
    .docs-home {
      max-width: 72rem;
      margin-inline: auto;
      padding-inline: 1rem;
    }

    /* Hero — from Starlight's Hero. */
    .hero {
      display: grid;
      grid-template-columns: 100%;
      align-items: center;
      gap: 1rem;
      padding-bottom: 1rem;
    }

    /* `:global(img)`: the hero image renders through Astro's
       `<Image />` (a child component), whose `<img>` carries no
       scope attribute — a scoped `img` selector would not match it
       (the plain-`<img>` fallback branch matches either way). */
    .hero > :global(img) {
      object-fit: contain;
      width: min(70%, 20rem);
      height: auto;
      margin-inline: auto;
    }

    .stack {
      flex-direction: column;
      gap: clamp(1.5rem, calc(1.5rem + 1vw), 2rem);
      text-align: center;
    }

    .copy {
      flex-direction: column;
      gap: 1rem;
      align-items: center;
    }

    .copy > * {
      max-width: 50ch;
    }

    .hero h1 {
      margin: 0;
      font-size: clamp(
        var(--porto-text-3xl),
        calc(0.25rem + 5vw),
        var(--porto-text-6xl)
      );
      line-height: var(--porto-line-height-headings);
      font-weight: 600;
      color: var(--porto-color-white);
    }

    .tagline {
      font-size: clamp(
        var(--porto-text-base),
        calc(0.0625rem + 2vw),
        var(--porto-text-xl)
      );
      color: var(--porto-color-gray-2);
    }

    .desc {
      margin: 0;
      font-size: var(--porto-text-base);
      line-height: 1.5;
      color: var(--porto-color-gray-2);
    }

    .actions {
      gap: 1rem 2rem;
      flex-wrap: wrap;
      justify-content: center;
    }

    .action-icon {
      display: inline-flex;
      align-items: center;
    }

    @media (min-width: 50rem) {
      .hero {
        grid-template-columns: 7fr 4fr;
        gap: 3%;
        padding-block: clamp(2.5rem, calc(1rem + 10vmin), 10rem);
      }

      .hero > :global(img) {
        order: 2;
        width: min(100%, 25rem);
      }

      .stack {
        text-align: start;
      }

      .copy {
        align-items: flex-start;
      }

      .actions {
        justify-content: flex-start;
      }
    }
  }

  @layer porto.components {
    /* The action buttons use the shared `.porto-link-button`
       (Starlight's LinkButton, in css/portfolio.css). */

    /* CardGrid + Card — from Starlight's CardGrid/Card
       user-components. */
    .features {
      padding-block: 1rem 2rem;
    }

    .card-grid {
      display: grid;
      grid-template-columns: 100%;
      gap: 1rem;
    }

    .card-grid > :global(*) {
      margin-top: 0 !important;
    }

    .card {
      --porto-card-border: var(--porto-color-purple);
      --porto-card-bg: var(--porto-color-purple-low);
      border: 1px solid var(--porto-color-gray-5);
      background-color: var(--porto-color-black);
      padding: clamp(1rem, calc(0.125rem + 3vw), 2.5rem);
      flex-direction: column;
      gap: clamp(0.5rem, calc(0.125rem + 1vw), 1rem);
    }
    .card:nth-child(4n + 1) {
      --porto-card-border: var(--porto-color-orange);
      --porto-card-bg: var(--porto-color-orange-low);
    }
    .card:nth-child(4n + 3) {
      --porto-card-border: var(--porto-color-green);
      --porto-card-bg: var(--porto-color-green-low);
    }
    .card:nth-child(4n + 4) {
      --porto-card-border: var(--porto-color-red);
      --porto-card-bg: var(--porto-color-red-low);
    }
    .card:nth-child(4n + 5) {
      --porto-card-border: var(--porto-color-blue);
      --porto-card-bg: var(--porto-color-blue-low);
    }

    .card-link {
      text-decoration: none;
      color: inherit;
    }
    .card-link:hover {
      border-color: var(--porto-color-gray-2);
    }

    /* The icon chip sits BESIDE the <h2>, not inside it — an emoji
       icon inside the heading would enter the page's heading text
       (the frozen URL snapshots capture h2 text). */
    .title-row {
      gap: 1rem;
      align-items: center;
    }

    .title {
      margin: 0;
      font-weight: 600;
      font-size: var(--porto-text-h4);
      color: var(--porto-color-white);
      line-height: var(--porto-line-height-headings);
    }

    .card .icon {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border: 1px solid var(--porto-card-border);
      background-color: var(--porto-card-bg);
      padding: 0.2em;
      border-radius: 0.25rem;
      flex-shrink: 0;
      font-size: 1.333em;
    }

    .card .body {
      margin: 0;
      font-size: clamp(
        var(--porto-text-sm),
        calc(0.5rem + 1vw),
        var(--porto-text-body)
      );
    }

    .card .body p {
      margin: 0;
      line-height: 1.5;
      color: var(--porto-color-gray-2);
    }

    @media (min-width: 50rem) {
      .card-grid {
        grid-template-columns: 1fr 1fr;
        gap: 1.5rem;
      }
    }
  }
</style>
