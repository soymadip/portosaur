---
// HeroSection — ported from the old components/HeroSection/index.jsx.
//
// Profile pic (with remote-URL fallback), intro/title/subtitle/
// profession/desc, Learn More button, hero social links. Reads config
// directly from `porto:config`.
//
// The profile picture goes through Astro's `<Image />` when it is a
// local file the build can size (dimensions read from the static
// dirs); remote URLs and unsizable files keep a plain `<img>`. The
// `onerror` fallback survives the conversion — Astro passes it
// through to the rendered `<img>` — so a broken profile picture
// still swaps to the configured fallback.
import { Image } from "astro:assets";
import config from "porto:config";
import { withBase } from "../../utils/icons.ts";
import {
  localImageDimensions,
  staticDirsForConfig,
} from "../../utils/imageSize.ts";
import SocialLinks from "./SocialLinks.astro";

interface Props {
  id?: string;
  className?: string;
}

const { id, className } = Astro.props;

const heroSection = config.homePage.heroSection;

const intro = heroSection.intro;
const title = heroSection.title;
const subtitle = heroSection.subtitle;
const profession = heroSection.profession;
const desc = heroSection.desc;
const profilePic = heroSection.profilePic;
const learnMoreButtonText = heroSection.learnMoreButtonTxt;

const base = config.site.baseUrl;
const profileRawSrc =
  typeof profilePic === "string" ? profilePic : profilePic.src;
const profileSrc = withBase(profileRawSrc, base);
const profileFallback =
  typeof profilePic === "object" && profilePic.fallback
    ? withBase(profilePic.fallback, base)
    : null;
// Dimensions for <Image /> (public images need width/height — Astro
// cannot analyze them). Null for remote or unsizable images, which
// keep the plain <img> below.
const profileDims = await localImageDimensions(
  profileRawSrc,
  staticDirsForConfig(config),
);
const profileOnError = profileFallback
  ? `this.onerror=null;this.src='${profileFallback}'`
  : undefined;
---

<div
  id={id}
  class={`porto-hero ${className || ""}`}
  role="region"
  aria-label="Hero section"
>
  <div class="porto-hero-inner">
    {/* Left: text content */}
    <div class="porto-hero-text">
      <p class="porto-hero-intro">{intro}</p>

      <h1 class="porto-hero-title">
        {title}
        <span class="porto-hero-comma">,</span>
      </h1>

      <div class="porto-hero-profession-row">
        <span class="porto-hero-subtitle">{subtitle}</span>
        <h2 class="porto-hero-profession">{profession}</h2>
        <span class="porto-hero-dot">.</span>
      </div>

      <p class="porto-hero-desc">{desc}</p>

      <div class="porto-hero-actions">
        <div class="porto-hero-learn-more">
          <a
            href="#about"
            class="porto-link-button primary"
            aria-label="Learn more about me"
          >
            {learnMoreButtonText}
          </a>
        </div>
        <SocialLinks links={heroSection.social} />
      </div>
    </div>

    {/* Right: profile picture */}
    <div class="porto-hero-picture-wrap">
      {profileDims ? (
        <Image
          src={profileSrc}
          alt="profile"
          width={profileDims.width}
          height={profileDims.height}
          class="porto-hero-picture"
          loading="eager"
          fetchpriority="high"
          onerror={profileOnError}
        />
      ) : (
        <img
          src={profileSrc}
          alt="profile"
          class="porto-hero-picture"
          loading="eager"
          fetchpriority="high"
          onerror={profileOnError}
        />
      )}
    </div>
  </div>
</div>
