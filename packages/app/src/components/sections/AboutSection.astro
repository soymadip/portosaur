---
// AboutSection — ported from the old components/AboutSection/index.jsx.
//
// Bio paragraphs, skills, resume button. The resume button stays hidden
// unless a resume is configured (non-empty string, not "none") —
// regression-tested behavior, keep the check exact.
//
// The old component opened the resume in the <Pv> preview viewer; Pv is
// a Phase 4 rebuild, so the button is a plain link (new tab) until then.
// Scroll reveal: the old useScrollReveal hook added `is-visible` to the
// section; the port marks the section `data-reveal` and the page's reveal
// script adds the class.
//
// The portrait goes through Astro's `<Image />` when it is a local
// file the build can size; remote URLs and unsizable files keep a
// plain `<img>` (same rule as the hero profile picture, including
// the `onerror` fallback).
import { Image } from "astro:assets";
import config from "porto:config";
import { renderIcon, withBase } from "../../utils/icons.ts";
import {
  localImageDimensions,
  staticDirsForConfig,
} from "../../utils/imageSize.ts";

interface Props {
  id?: string;
  className?: string;
}

const { id, className } = Astro.props;

const aboutMe = config.homePage?.aboutSection || {};

const base = config.site.baseUrl;
const image = aboutMe.image;
const imageRawSrc = image
  ? typeof image === "string"
    ? image
    : image.src
  : null;
const imageSrc = imageRawSrc ? withBase(imageRawSrc, base) : null;
const imageFallback =
  image && typeof image === "object" && image.fallback
    ? withBase(image.fallback, base)
    : null;
const imageDims = imageRawSrc
  ? await localImageDimensions(imageRawSrc, staticDirsForConfig(config))
  : null;
const imageOnError = imageFallback
  ? `this.onerror=null;this.src='${imageFallback}'`
  : undefined;

// The resume button renders only for a real resume path: a non-empty
// string that is not "none" (the engine default).
const hasResume =
  typeof aboutMe.resume === "string" &&
  aboutMe.resume.trim() !== "" &&
  aboutMe.resume.trim().toLowerCase() !== "none";
const resumeUrl = hasResume ? withBase(aboutMe.resume, base) : null;
---

{aboutMe.enable !== false && (
  <div
    id={id}
    data-reveal
    class={`porto-about ${className || ""}`}
    role="region"
    aria-label="About me section"
  >
    <div class="porto-about-inner">
      {/* Heading */}
      <div class="porto-about-heading-wrap">
        <h2 class="porto-about-heading">{aboutMe.heading || "About Me"}</h2>
      </div>

      {/* Content */}
      <div>
        <div class="porto-about-card">
          {/* Image + Resume */}
          <div class="porto-about-side">
            {image && (
              <div class="porto-about-avatar-ring">
                {imageDims ? (
                  <Image
                    src={imageSrc}
                    alt={aboutMe.name || "About Me"}
                    width={imageDims.width}
                    height={imageDims.height}
                    class="porto-about-avatar"
                    onerror={imageOnError}
                  />
                ) : (
                  <img
                    src={imageSrc}
                    alt={aboutMe.name || "About Me"}
                    class="porto-about-avatar"
                    onerror={imageOnError}
                  />
                )}
              </div>
            )}
            {hasResume && (
              <div class="porto-about-resume">
                <a
                  href={resumeUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="porto-link-button primary"
                >
                  <span set:html={renderIcon("md:download")} /> View Resume
                </a>
              </div>
            )}
          </div>

          {/* Bio + Skills */}
          <div class="porto-about-bio">
            <div class="bioText">
              {Array.isArray(aboutMe.bio) ? (
                aboutMe.bio.map((paragraph) => (
                  <p class="porto-about-bio-para">{paragraph}</p>
                ))
              ) : (
                <p class="porto-about-bio-para">{aboutMe.bio}</p>
              )}
            </div>

            {aboutMe.skills && aboutMe.skills.length > 0 && (
              <div class="porto-about-skills">
                <h3 class="porto-about-skills-heading">
                  {aboutMe.skillsHeading || "My Skills"}
                </h3>
                <div class="porto-about-skill-list">
                  {aboutMe.skills.map((skill, index) => (
                    <span
                      class="porto-about-skill"
                      style={`animation-delay: ${index * 0.05}s`}
                    >
                      {skill}
                    </span>
                  ))}
                </div>
              </div>
            )}
          </div>
        </div>
      </div>
    </div>
  </div>
)}
