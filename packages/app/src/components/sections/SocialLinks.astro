---
// SocialLinks — ported from the old components/SocialLinks/index.jsx.
//
// Row of social icon links (used in the hero). Hover state is pure CSS
// (:hover on the link, colored via --hover-color); the staggered fade-in
// delay is viewport-dependent, so a small inline script sets it per
// link on load and resize (the old useEffect logic).
//
// The old component wrapped each link in a <Hint> tooltip; the Hint
// component is a Phase 4 MDX stub whose placeholder renders its message
// visibly, so tooltips are plain `title` attributes until Phase 4 swaps
// the real Hint in.
import config from "porto:config";
import { renderDynamicIcon, techMap, withBase } from "../../utils/icons.ts";

interface Props {
  showAll?: boolean;
  links?: Array<{
    name?: string;
    url?: string;
    icon?: string;
    color?: string;
    desc?: string;
    pin?: boolean;
  }> | null;
}

const { showAll = false, links = null } = Astro.props;

const allSocialLinks = config.homePage?.socialSection?.links ?? [];
const socialLinks =
  links ??
  (showAll ? allSocialLinks : allSocialLinks.filter((link) => link.pin));
const base = config.site.baseUrl;
---

{socialLinks.length > 0 && (
  <div
    class="flex h-[38px] items-center gap-[18px] max-[768px]:w-full max-[768px]:justify-center"
    data-porto-social
  >
    {socialLinks.map((social) => {
      const href = social.url || "#";
      const slugLower = (social.name || "").toLowerCase();
      const mappedColor = techMap[slugLower]?.color;
      const displayColor =
        social.color || mappedColor || "var(--color-primary)";
      const iconHtml = renderDynamicIcon(social.icon, {
        slug: social.name,
        fallbackIcon: "md:help-circle",
        size: "24px",
        base,
      });
      return (
        <a
          href={href}
          target="_blank"
          rel="noopener noreferrer"
          class="socialLink relative flex items-center justify-center text-primary [transition:color_0.3s,translate_0.2s,scale_0.2s] hover:-translate-y-1 hover:scale-115 hover:text-[var(--hover-color,var(--color-primary-dark))] hover:opacity-90 hover:no-underline max-[768px]:mx-[9px]"
          style={`--hover-color: ${displayColor}`}
          title={social.desc || social.name || social.icon || "Link"}
          aria-label={social.name || social.icon || "social link"}
        >
          <span set:html={iconHtml} />
        </a>
      );
    })}
  </div>
)}

<script>
  // Staggered fade-in delays, by viewport (old calculateDelays logic):
  // 0.7s base on mobile, 0.9s on tablet, 1.3s on desktop, +0.1s per link.
  function applySocialDelays() {
    const width = window.innerWidth;
    const baseDelay = width <= 480 ? 0.7 : width <= 768 ? 0.9 : 1.3;
    document.querySelectorAll("[data-porto-social]").forEach((container) => {
      container.querySelectorAll(".socialLink").forEach((link, index) => {
        link.style.animationDelay = `${baseDelay + index * 0.1}s`;
      });
    });
  }
  applySocialDelays();
  window.addEventListener("resize", applySocialDelays);
</script>

<style>
  /* Load-in keyframes + animation. The inline script sets each link's
     animation-delay by viewport, so the animation stays plain CSS next
     to its keyframes; `.socialLink` is also the script's selector, so
     the class name stays. */
  @keyframes fadeIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  .socialLink {
    animation: fadeIn 0.3s ease-out forwards;
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .socialLink {
      animation: none !important;
      opacity: 1;
      /* `transition` is a Tailwind utility now, so this needs
         `!important` to beat it (same stylesheet no longer applies). */
      transition: none !important;
    }
  }
</style>
