---
// ProjectsSection — ported from the old components/ProjectsSection/index.jsx.
//
// Carousel with nav buttons + dots. The carousel itself is pure CSS
// (scroll-snap); the buttons, dots, and slides-to-show are client state,
// ported to the small inline script below (same breakpoints and scroll
// math as the old hooks: 1 slide ≤600px, 2 ≤1024px, 3 above).
//
// Note: neither the old component nor this port implements autoplay or a
// featured filter — the config key `projectShelf.autoplay` exists but the
// old component never read it, and `featured` is only a badge. The old
// <Hint> for the "+N" overflow tags is a plain `title` attribute until
// the real Hint lands in Phase 4.
import config from "porto:config";
import { renderDynamicIcon, renderIcon } from "../../utils/icons.ts";

interface Props {
  id?: string;
  className?: string;
}

const { id, className } = Astro.props;

const projectShelf = config.homePage?.projectShelf || {};
const projects = projectShelf?.projects || [];
const base = config.site.baseUrl;

// State badge colors — the old `.active`/`.completed`/… classes,
// expressed as a `data-state` attribute the CSS keys off. An unknown
// state gets no background, as before.
const KNOWN_STATES = new Set([
  "active",
  "completed",
  "maintenance",
  "paused",
  "archived",
  "planned",
]);
---

{projectShelf?.enable !== false && projects.length > 0 && (
  <div
    id={id}
    data-reveal
    data-porto-carousel
    data-projects={projects.length}
    class={`porto-projects ${className || ""}`}
  >
    <div class="porto-projects-inner">
      <div class="porto-projects-heading-wrap">
        <h2 class="porto-projects-heading">
          {projectShelf?.heading || "Projects"}
        </h2>
        {projectShelf?.subheading && (
          <p class="porto-projects-subheading">{projectShelf.subheading}</p>
        )}
      </div>

      <div class="porto-projects-row">
        {projects.length > 1 && (
          <button class="prevButton" disabled aria-label="Previous project">
            <span
              set:html={renderIcon("md:chevron-left", { size: "1.8rem" })}
            />
          </button>
        )}

        <div class="carousel" style="--slides-to-show: 3">
          {projects.map((project) => {
            const tags = project.tags || [];
            const extraTags = tags.length - 3;
            const state = (project.state || "").toLowerCase();
            return (
              <div class="porto-project-slide">
                <div class="porto-project-card">
                  <div
                    class="porto-project-media"
                    style={`background-color: ${project.bg || "rgba(255,255,255,0.05)"}`}
                  >
                    <span
                      class="porto-project-icon"
                      set:html={renderDynamicIcon(project.icon, {
                        slug: project.slug,
                        base,
                      })}
                    />

                    {project.state && (
                      <div class="porto-project-state">
                        <span
                          class="porto-project-state-badge"
                          data-state={KNOWN_STATES.has(state) ? state : ""}
                        >
                          {project.state}
                        </span>
                      </div>
                    )}

                    {project.featured && (
                      <div class="porto-project-featured" title="Featured">
                        <span set:html={renderIcon("md:star")} />
                      </div>
                    )}

                    {tags.length > 0 && (
                      <div class="porto-project-tags">
                        {tags.slice(0, 3).map((tag) => (
                          <span class="porto-project-tag">{tag}</span>
                        ))}
                        {extraTags > 0 && (
                          <span
                            class="porto-project-tag-more"
                            title={tags.slice(3).join(", ")}
                          >
                            +{extraTags}
                          </span>
                        )}
                      </div>
                    )}
                  </div>

                  <div class="porto-project-body">
                    <div class="porto-project-title-row">
                      <h3 class="porto-project-title">{project.title}</h3>
                    </div>
                    <p class="porto-project-desc">{project.desc}</p>
                  </div>

                  <div class="porto-project-links">
                    {project.website && (
                      <a
                        href={project.website}
                        target="_blank"
                        rel="noreferrer"
                        class="porto-project-link"
                      >
                        <span set:html={renderIcon("md:web")} /> Website
                      </a>
                    )}
                    {project.repo && (
                      <a
                        href={project.repo}
                        target="_blank"
                        rel="noreferrer"
                        class="porto-project-link"
                      >
                        <span set:html={renderIcon("md:xml")} /> Source
                      </a>
                    )}
                    {project.demo && (
                      <a
                        href={project.demo}
                        target="_blank"
                        rel="noreferrer"
                        class="porto-project-link"
                      >
                        <span set:html={renderIcon("md:play")} /> Demo
                      </a>
                    )}
                  </div>
                </div>
              </div>
            );
          })}
        </div>

        {projects.length > 1 && (
          <button class="nextButton" aria-label="Next project">
            <span
              set:html={renderIcon("md:chevron-right", { size: "1.8rem" })}
            />
          </button>
        )}
      </div>

      {/*
          Dots are server-rendered (max count = one per project, the
          slidesToShow=1 case). The script hides the extras per
          breakpoint and toggles `.activeDot` on the current one.
        */}
      <div class="dotsContainer">
        {projects.map((_, index) => (
          <button
            class="dot"
            data-dot={index}
            aria-label={`Go to slide ${index + 1}`}
          />
        ))}
      </div>
    </div>
  </div>
)}

<script>
  // Carousel state, ported from the old React hooks (same breakpoints and
  // scroll math). Runs once per page; scoped to [data-porto-carousel].
  function initCarousel(root) {
    const carousel = root.querySelector(".carousel");
    const prevBtn = root.querySelector(".prevButton");
    const nextBtn = root.querySelector(".nextButton");
    const dotsContainer = root.querySelector(".dotsContainer");
    const total = Number(root.dataset.projects || "0");
    if (!carousel) {
      return;
    }

    let slidesToShow = 3;
    let currentSlide = 0;

    function computeSlidesToShow() {
      const width = window.innerWidth;
      if (width <= 600) {
        return 1;
      }
      if (width <= 1024) {
        return 2;
      }
      return 3;
    }

    function totalPages() {
      return Math.max(1, Math.ceil(total - slidesToShow + 1));
    }

    function updateDots() {
      const pages = totalPages();
      dotsContainer.style.display = pages <= 1 ? "none" : "";
      dotsContainer.querySelectorAll(".dot").forEach((dot, index) => {
        dot.style.display = index < pages ? "" : "none";
        dot.classList.toggle("activeDot", index === currentSlide);
      });
    }

    function update() {
      const showNav = total > slidesToShow;
      if (prevBtn) {
        prevBtn.style.display = showNav ? "" : "none";
      }
      if (nextBtn) {
        nextBtn.style.display = showNav ? "" : "none";
      }
      const { scrollLeft, scrollWidth, clientWidth } = carousel;
      if (prevBtn) {
        prevBtn.disabled = !(scrollLeft > 5);
      }
      if (nextBtn) {
        nextBtn.disabled = !(scrollLeft + clientWidth < scrollWidth - 5);
      }
      const slideWidth = clientWidth / slidesToShow;
      currentSlide = Math.round(scrollLeft / slideWidth);
      updateDots();
    }

    function goToSlide(index) {
      const max = totalPages() - 1;
      const clamped = Math.max(0, Math.min(max, index));
      const scrollAmount = carousel.clientWidth / slidesToShow;
      carousel.scrollTo({ left: clamped * scrollAmount, behavior: "smooth" });
    }

    function onResize() {
      slidesToShow = computeSlidesToShow();
      carousel.style.setProperty("--slides-to-show", String(slidesToShow));
      update();
    }

    carousel.addEventListener("scroll", update, { passive: true });
    if (prevBtn) {
      prevBtn.addEventListener("click", () => goToSlide(currentSlide - 1));
    }
    if (nextBtn) {
      nextBtn.addEventListener("click", () => goToSlide(currentSlide + 1));
    }
    dotsContainer.querySelectorAll(".dot").forEach((dot, index) => {
      dot.addEventListener("click", () => goToSlide(index));
    });
    window.addEventListener("resize", onResize);
    onResize();
  }

  document.querySelectorAll("[data-porto-carousel]").forEach(initCarousel);
</script>
