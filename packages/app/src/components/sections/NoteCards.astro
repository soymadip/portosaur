---
// NoteCards — ported from the old components/NoteCards/index.jsx.
//
// Renders the top-level notes as cards. The page passes the filtered
// collection entries (`notes` prop — top-level files + top-level dirs
// with an index); this component parses frontmatter, resolves slugs with
// the shared slug util, filters drafts in production, and sorts by
// `sidebar_position` (same rules as the old `getAllNotesData`).
//
// Two deliberate changes from the old component:
// - Cards get `id="note-<slug>"` so the /notes HashNavigation can
//   scroll to them — the old cards had no id, so hash navigation never
//   found a target.
// - The old <Hint> description tooltip is a plain `title` attribute
//   until the real Hint lands in Phase 4 (the Phase 2 Hint stub renders
//   its message visibly).
// - `unlisted` frontmatter is not in the content schema, so it cannot
//   be filtered here (the old component hid unlisted notes).
import config from "porto:config";
import { guessDocPermalink } from "../../utils/slug.ts";
import {
  renderDynamicIcon,
  renderIcon,
  techMap,
  withBase,
} from "../../utils/icons.ts";

interface Props {
  notes: Array<{
    id: string;
    data?: Record<string, any>;
  }>;
}

const { notes: entries } = Astro.props;

const base = config.site.baseUrl;
const notesRoute = config.site.notesRoute;

// Same parsing as the old getAllNotesData: title from frontmatter or the
// file slug (first letter capitalized), description, position (default
// 999), icon/color overrides, draft flag.
const notes = entries
  .map((entry) => {
    const frontMatter = entry.data ?? {};
    const { slug, fileSlug } = guessDocPermalink(
      `${entry.id}.mdx`,
      frontMatter,
    );
    const rawTitle = frontMatter.title || fileSlug;
    return {
      title: rawTitle.charAt(0).toUpperCase() + rawTitle.slice(1),
      slug,
      description: frontMatter.description || "",
      position: frontMatter.sidebar_position || 999,
      iconStr: frontMatter.icon || null,
      colorStr: frontMatter.color || null,
      draft: frontMatter.draft === true,
    };
  })
  .filter((note) => {
    // Hide drafts in production
    if (note.draft && import.meta.env.PROD) {
      return false;
    }
    return true;
  })
  .sort((a, b) => a.position - b.position);
---

{notes.length > 0 && (
  <div class="porto-note-grid" role="list">
    {notes.map((note, index) => {
      const noteUrl = withBase(`/${notesRoute}/${note.slug}`, base);
      // Resolve color: explicit frontmatter first, then techMap
      // guessing, then default.
      const slugLower = note.slug.toLowerCase();
      const iconStrLower = (note.iconStr || "").toLowerCase();
      const mappedColor =
        techMap[iconStrLower]?.color || techMap[slugLower]?.color;
      const color = note.colorStr || mappedColor || "var(--porto-color-accent)";
      return (
        <a
          id={`note-${note.slug}`}
          href={noteUrl}
          class="noteCard"
          style={`--card-index: ${index}; --note-color: ${color};`}
          aria-label={`Read note: ${note.title}`}
          title={note.description || undefined}
        >
          <div class="porto-note-icon-wrap">
            <span
              class="noteIcon"
              set:html={renderDynamicIcon(note.iconStr, {
                slug: note.slug,
                fallbackIcon: "md:book",
                base,
              })}
            />
          </div>
          <div class="porto-note-text">
            <h3 class="porto-note-title" title={note.title}>
              {note.title}
            </h3>
          </div>
          <span
            class="mobileChevron"
            set:html={renderIcon("md:chevron-right")}
          />
        </a>
      );
    })}
  </div>
)}
