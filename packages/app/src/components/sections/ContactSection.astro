---
// ContactSection — ported from the old components/ContactSection/index.jsx.
//
// Social links grid (email links sorted first). Hover color per card
// comes from the link's own color, the techMap brand color, or the
// primary token. Scroll reveal via `data-reveal` (old useScrollReveal).
import config from "porto:config";
import { renderDynamicIcon, techMap } from "../../utils/icons.ts";

interface Props {
  id?: string;
  className?: string;
}

const { id, className } = Astro.props;

const socialLinksConfig = config.homePage?.socialSection || {};
const base = config.site.baseUrl;

// Sort so email links appear first in the contact grid.
const socialLinks = [...(socialLinksConfig.links || [])].sort((a, b) => {
  const isEmailA =
    a.url?.startsWith("mailto:") ||
    a.icon?.toLowerCase().includes("email") ||
    a.name?.toLowerCase().includes("email");
  const isEmailB =
    b.url?.startsWith("mailto:") ||
    b.icon?.toLowerCase().includes("email") ||
    b.name?.toLowerCase().includes("email");
  if (isEmailA && !isEmailB) {
    return -1;
  }
  if (!isEmailA && isEmailB) {
    return 1;
  }
  return 0;
});
---

{socialLinksConfig.enable !== false && (
  <div
    id={id}
    data-reveal
    class={`porto-contact ${className || ""}`}
    role="region"
    aria-label="Contact section"
  >
    <div class="porto-contact-inner">
      {/* Heading */}
      <div class="porto-contact-heading-wrap">
        <h2 class="porto-contact-title">{socialLinksConfig.heading}</h2>
        <p class="porto-contact-subtitle">{socialLinksConfig.subheading}</p>
      </div>

      {/* Social cards grid */}
      <div class="porto-contact-grid-wrap">
        <div
          class="porto-contact-grid"
          role="list"
          aria-label="Social media and contact links"
        >
          {socialLinks.map((social, index) => {
            const name = social.name;
            const slugLower = (name || "").toLowerCase();
            const mappedColor = techMap[slugLower]?.color;
            const iconColor =
              social.color || mappedColor || "var(--porto-color-accent)";
            const desc = social.desc || `Connect with me on ${name}`;
            const url = social.url;
            return (
              <a
                href={url}
                target="_blank"
                rel="noopener noreferrer"
                class="porto-contact-card"
                style={`--card-index: ${index}; --icon-hover-color: ${iconColor};`}
                aria-label={`Connect with me on ${name}: ${desc}`}
                role="listitem"
              >
                <div class="porto-contact-card-icon">
                  <span
                    set:html={renderDynamicIcon(social.icon, {
                      slug: name,
                      fallbackIcon: "md:help-circle",
                      base,
                    })}
                  />
                </div>
                <h3 class="porto-contact-card-name">{name}</h3>
                <p class="porto-contact-card-desc">{desc}</p>
              </a>
            );
          })}
        </div>
      </div>
    </div>
  </div>
)}
