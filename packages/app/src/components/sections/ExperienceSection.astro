---
// ExperienceSection — ported from the old components/ExperienceSection/index.jsx.
//
// Static section: heading + subheading + the "Coming Soon!" notice box.
// Note the old component never rendered `experience.list` — the notice
// box is the whole section. Kept faithful (the list stays unused).
import config from "porto:config";

interface Props {
  id?: string;
  className?: string;
}

const { id, className } = Astro.props;

const experience = config.homePage?.experienceSection || {};
---

{experience.enable !== false && (
  <div
    id={id}
    class={`porto-experience ${className || ""}`}
    role="region"
    aria-label="Experience section"
  >
    <div class="porto-experience-inner">
      {/* Heading */}
      <div class="porto-experience-heading-wrap">
        <h2 class="porto-experience-title">{experience.heading}</h2>
        <p class="porto-experience-subtitle">{experience.subheading}</p>
      </div>

      {/* Placeholder */}
      <div class="porto-experience-placeholder">
        <div class="porto-experience-notice" role="status" aria-live="polite">
          <p class="porto-experience-notice-title">Coming Soon!</p>
          <p class="porto-experience-notice-text">
            This section is under construction.
          </p>
        </div>
      </div>
    </div>
  </div>
)}
