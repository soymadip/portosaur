---
// Derived from Starlight (MIT License) — see packages/app/NOTICE.md.
// Starlight's TwoColumnContent, renamed (`sl-` → `porto-`). Splits
// the doc area into the fixed right sidebar (TOC) and the main pane.
// The aside renders only when the page has a TOC (`hasToc` prop;
// Starlight gates it on its route data instead).
interface Props {
  hasToc: boolean;
}

const { hasToc } = Astro.props;
---

<div class="lg:porto-flex">
  {hasToc && (
    <aside class="right-sidebar-container print:hidden">
      <div class="right-sidebar">
        <slot name="right-sidebar" />
      </div>
    </aside>
  )}
  <div class="main-pane">
    <slot />
  </div>
</div>

<style>
  @layer porto.core {
    .main-pane {
      isolation: isolate;
    }

    @media (min-width: 72rem) {
      /* Docusaurus-style three-column row: the main pane fills
         everything except the TOC width, and the TOC container is
         exactly sidebar-width, pinned to the right edge. (Starlight
         instead centers a capped content column and lets the TOC
         container absorb half the leftover space.) */
      .right-sidebar-container {
        order: 2;
        position: relative;
        /* Keep the sidebar at the end of the row if it paints before the main pane is parsed. */
        margin-inline-start: auto;
        width: var(--porto-sidebar-width);
      }

      .right-sidebar {
        position: fixed;
        top: 0;
        border-inline-start: 1px solid var(--porto-color-hairline);
        padding-top: var(--porto-nav-height);
        /* Exactly the container width: `width: 100%` on a fixed
           element resolves against the viewport, not the container,
           and overflowed a full viewport wide. */
        width: var(--porto-sidebar-width);
        height: 100vh;
        overflow-y: auto;
        scrollbar-width: none;
      }

      .main-pane {
        width: 100%;
      }

      :global([data-has-sidebar][data-has-toc]) .main-pane {
        order: 1;
        width: calc(100% - var(--porto-sidebar-width));
      }
    }
  }
</style>
