---
// Derived from Starlight (MIT License) — see packages/app/NOTICE.md.
// Starlight's SidebarSublist, renamed (`sl-` → `porto-`) and adapted
// to Portosaur's sidebar data (`porto:sidebar` nodes: doc items with
// `href`, categories with `link?.href` + `items`).
//
// Portosaur differences from Starlight's sublist:
// - No badges (Portosaur's sidebar has none).
// - Category labels link to their index page when the category has
//   one (index-as-category-link).
// - When `theme.navigation.collapsable_sidebar` is false, categories
//   render as plain groups (label + list, no <details>).
// - Category rows highlight as a full-width box (Docusaurus-style):
//   the active/hover background lives on the <summary> row, not the
//   inner link, so the caret sits inside the box; the caret has its
//   own hover background stacking on top of the row hover.
import config from "porto:config";
import Icon from "./Icon.astro";
import SidebarRestorePoint from "./SidebarRestorePoint.astro";

interface Props {
  items: any[];
  currentHref: string;
  nested?: boolean;
}

const { items, currentHref, nested } = Astro.props;

const collapsable = config.theme.collapsableSidebar !== false;

function normalize(href: string): string {
  return href.replace(/\/+$/, "") || "/";
}

const current = normalize(currentHref);

function isActiveItem(item: any): boolean {
  const href = item.href ?? item.link?.href;
  if (!href) {
    return false;
  }
  return normalize(href) === current;
}

function hasActiveDescendant(item: any): boolean {
  if (isActiveItem(item)) {
    return true;
  }
  for (const child of item.items ?? []) {
    if (hasActiveDescendant(child)) {
      return true;
    }
  }
  return false;
}
---

<ul class:list={{ "top-level": !nested }}>
  {items.map((item) => (
    <li>
      {item.type === "category" ? (
        collapsable ? (
          <details open={hasActiveDescendant(item)}>
            <summary>
              <span class="group-label">
                {item.link?.href ? (
                  <a
                    class="large"
                    href={item.link.href}
                    aria-current={isActiveItem(item) ? "page" : undefined}
                  >
                    {item.label}
                  </a>
                ) : (
                  <span class="large">{item.label}</span>
                )}
              </span>
              <span class="caret">
                <Icon name="right-caret" size="1.5rem" />
              </span>
            </summary>
            <SidebarRestorePoint />
            <Astro.self
              items={item.items ?? []}
              currentHref={currentHref}
              nested
            />
          </details>
        ) : (
          <>
            {item.link?.href ? (
              <a
                class="large"
                href={item.link.href}
                aria-current={isActiveItem(item) ? "page" : undefined}
              >
                {item.label}
              </a>
            ) : (
              <span class="group-label">
                <span class="large">{item.label}</span>
              </span>
            )}
            <Astro.self
              items={item.items ?? []}
              currentHref={currentHref}
              nested
            />
          </>
        )
      ) : (
        <a
          href={item.href}
          aria-current={isActiveItem(item) ? "page" : undefined}
          class:list={[{ large: !nested }]}
        >
          <span>{item.label}</span>
        </a>
      )}
    </li>
  ))}
</ul>

<style>
  @layer porto.core {
    ul {
      --porto-sidebar-item-padding-inline: 0.5rem;
      list-style: none;
      padding: 0;
    }

    li {
      overflow-wrap: anywhere;
    }

    ul ul li {
      margin-inline-start: var(--porto-sidebar-item-padding-inline);
      border-inline-start: 1px solid var(--porto-color-hairline-light);
      padding-inline-start: var(--porto-sidebar-item-padding-inline);
    }

    .large {
      font-size: var(--porto-text-lg);
      font-weight: 600;
      color: var(--porto-color-white);
    }

    .top-level > li + li {
      margin-top: 0.75rem;
    }

    summary {
      display: flex;
      align-items: center;
      /* The caret sits right after the label (a 0.25rem gap), not
         pinned to the row's right edge — the gap between the text
         end and the caret stays small whatever the row width. */
      gap: 0.25rem;
      /* Same vertical padding as a leaf link, so category rows and
         leaf rows are the same height. */
      padding: 0.25em var(--porto-sidebar-item-padding-inline);
      line-height: 1.4;
      cursor: pointer;
      user-select: none;
    }
    summary::marker,
    summary::-webkit-details-marker {
      display: none;
    }

    .caret {
      /* A square hit area around the chevron, with its own hover
         background (Docusaurus's caret button): the negative
         margins keep the padded box from making the row taller
         than a leaf row. */
      display: inline-flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      padding: 0.2rem;
      margin-block: -0.2rem;
      border-radius: 0.25rem;
      transition: transform 0.2s ease-in-out;
    }
    :global([dir="rtl"]) .caret {
      transform: rotateZ(180deg);
    }
    [open] > summary .caret {
      transform: rotateZ(90deg);
    }

    a {
      display: block;
      border-radius: 0.25rem;
      text-decoration: none;
      color: var(--porto-color-gray-2);
      padding: 0.25em var(--porto-sidebar-item-padding-inline);
      line-height: 1.4;
    }

    a:hover,
    a:focus {
      color: var(--porto-color-white);
    }

    /* OG-style active item: accent text on a subtle 10% accent tint.
       The solid-accent box (accent-high bg, accent-low text) fails in
       light mode, where the mid accent vs white is under 4.5:1 in four
       schemes — the tint + accent text reads in every scheme × mode.
       The tint uses text-accent (the per-mode visible primary), so
       dark mode tints with the dark primary like OG. */
    [aria-current="page"],
    [aria-current="page"]:hover,
    [aria-current="page"]:focus {
      font-weight: 600;
      color: var(--porto-color-accent-high);
      background-color: color-mix(
        in srgb,
        var(--porto-color-text-accent) 10%,
        transparent
      );
    }

    /* The active category row highlights as one uniform box: the
       background sits on the <summary>, not the inner link, so the
       box spans the full row at leaf-row height with the caret
       inside it (Docusaurus-style). The link keeps only the accent
       text color — its own background is cleared. */
    summary:has(> .group-label > a[aria-current="page"]) {
      background-color: color-mix(
        in srgb,
        var(--porto-color-text-accent) 10%,
        transparent
      );
      border-radius: 0.25rem;
      color: var(--porto-color-accent-high);
    }

    /* Dark mode only: lighten the active text one step — the same 65%
       white tint the hue `-high` colors use. The OG primaries are mid
       lightness, so dracula purple and gruvbox orange don't reach
       4.5:1 on the gray-6 sidebar bg at full strength. */
    :global([data-theme="dark"]) [aria-current="page"],
    :global([data-theme="dark"]) [aria-current="page"]:hover,
    :global([data-theme="dark"]) [aria-current="page"]:focus,
    :global([data-theme="dark"])
      summary:has(> .group-label > a[aria-current="page"]) {
      color: color-mix(in srgb, var(--porto-color-accent-high) 65%, white);
    }

    /* A hovered category row gets the same full-width box, in a
       translucent foreground tint (lightens dark sidebars, darkens
       light ones, in every scheme). The caret has its own hover
       background in the same tint, stacking on top of the row
       hover so the caret area goes slightly darker. */
    summary:hover {
      background-color: color-mix(
        in srgb,
        var(--porto-color-gray-1) 10%,
        transparent
      );
      border-radius: 0.25rem;
    }
    .caret:hover {
      background-color: color-mix(
        in srgb,
        var(--porto-color-gray-1) 10%,
        transparent
      );
    }
    .group-label a[aria-current="page"],
    .group-label a[aria-current="page"]:hover,
    .group-label a[aria-current="page"]:focus {
      background-color: transparent;
    }

    a > *:not(:last-child),
    .group-label > *:not(:last-child) {
      margin-inline-end: 0.25em;
    }

    /* A category link inside a <summary> is the group label, not a
       list link — no list-link padding (the summary provides it). */
    .group-label a {
      padding: 0;
    }

    @media (min-width: 50rem) {
      .top-level > li + li {
        margin-top: 0.5rem;
      }
      .large {
        font-size: var(--porto-text-base);
      }
      a {
        font-size: var(--porto-text-sm);
      }
    }
  }
</style>
