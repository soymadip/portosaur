---
// Derived from Starlight (MIT License) — see packages/app/NOTICE.md.
// Starlight's MobileTableOfContents, renamed (`sl-` → `porto-`,
// `mobile-starlight-toc` → `mobile-porto-toc`) and adapted to
// Portosaur's data (headings prop, nested by `nestHeadings`).
//
// Portosaur difference: the nav follows the hide-on-scroll navbar —
// when the navbar hides, the mobile TOC slides up to the top of the
// viewport (`html.porto-navbar-hidden` rule below).
import type { TocHeading } from "../utils/content.ts";
import { nestHeadings } from "../utils/content.ts";
import Icon from "./Icon.astro";
import TableOfContentsList from "./TableOfContentsList.astro";

interface Props {
  headings: TocHeading[];
}

const { headings } = Astro.props;
const toc = nestHeadings(headings);
---

{toc.length > 0 && (
  <mobile-porto-toc data-min-h={2} data-max-h={3}>
    <nav aria-labelledby="porto__on-this-page--mobile">
      <details id="porto__mobile-toc">
        <summary id="porto__on-this-page--mobile" class="porto-flex">
          <span class="toggle porto-flex">
            On this page
            <Icon name="right-caret" class="caret" size="1rem" />
          </span>
          <span class="display-current" />
        </summary>
        <div class="dropdown">
          <TableOfContentsList toc={toc} isMobile />
        </div>
      </details>
    </nav>
  </mobile-porto-toc>
)}

<style>
  @layer porto.core {
    nav {
      position: fixed;
      z-index: var(--porto-z-index-toc);
      top: calc(var(--porto-nav-height) - 1px);
      inset-inline: 0;
      border-top: 1px solid var(--porto-color-gray-5);
      background-color: var(--porto-color-bg-nav);
      transition: top 0.2s ease-in-out;
    }
    /* The navbar hides on scroll down (hideNavbarOnScroll) — the
       mobile TOC follows it to the top of the viewport. */
    :global(html.porto-navbar-hidden) nav {
      top: -1px;
    }
    @media (min-width: 50rem) {
      nav {
        inset-inline-start: var(--porto-content-inline-start, 0);
      }
    }

    summary {
      gap: 0.5rem;
      align-items: center;
      height: var(--porto-mobile-toc-height);
      border-bottom: 1px solid var(--porto-color-hairline-shade);
      padding: 0.5rem 1rem;
      font-size: var(--porto-text-xs);
      outline-offset: var(--porto-outline-offset-inside);
    }
    summary::marker,
    summary::-webkit-details-marker {
      display: none;
    }

    .toggle {
      flex-shrink: 0;
      gap: 1rem;
      align-items: center;
      justify-content: space-between;
      border: 1px solid var(--porto-color-gray-5);
      border-radius: 0.5rem;
      padding-block: 0.5rem;
      padding-inline-start: 0.75rem;
      padding-inline-end: 0.5rem;
      line-height: 1;
      background-color: var(--porto-color-black);
      user-select: none;
      cursor: pointer;
    }
    details[open] .toggle {
      color: var(--porto-color-white);
      border-color: var(--porto-color-accent);
    }
    details .toggle:hover {
      color: var(--porto-color-white);
      border-color: var(--porto-color-gray-2);
    }

    :global([dir="rtl"]) .caret {
      transform: rotateZ(180deg);
    }
    details[open] .caret {
      transform: rotateZ(90deg);
    }

    .display-current {
      white-space: nowrap;
      text-overflow: ellipsis;
      overflow: hidden;
      color: var(--porto-color-white);
    }

    .dropdown {
      --border-top: 1px;
      margin-top: calc(-1 * var(--border-top));
      border: var(--border-top) solid var(--porto-color-gray-6);
      border-top-color: var(--porto-color-hairline-shade);
      max-height: calc(
        85vh - var(--porto-nav-height) - var(--porto-mobile-toc-height)
      );
      overflow-y: auto;
      background-color: var(--porto-color-black);
      box-shadow: var(--porto-shadow-md);
      overscroll-behavior: contain;
    }
  }
</style>

<script>
  import { PortoTOC } from "../scripts/porto-toc.ts";

  class MobilePortoTOC extends PortoTOC {
    override set current(link: HTMLAnchorElement) {
      super.current = link;
      const display = this.querySelector(".display-current") as HTMLSpanElement;
      if (display) {
        display.textContent = link.textContent;
      }
    }

    constructor() {
      super();
      const details = this.querySelector("details");
      if (!details) {
        return;
      }
      const closeToC = () => {
        details.open = false;
      };
      // Close the table of contents whenever a link is clicked.
      details.querySelectorAll("a").forEach((a) => {
        a.addEventListener("click", closeToC);
      });
      // Close the table of contents when a user clicks outside of it.
      window.addEventListener("click", (e) => {
        if (!details.contains(e.target as Node)) {
          closeToC();
        }
      });
      // Or when they press the escape key.
      window.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && details.open) {
          const hasFocus = details.contains(document.activeElement);
          closeToC();
          if (hasFocus) {
            const summary = details.querySelector("summary");
            if (summary) {
              summary.focus();
            }
          }
        }
      });
    }
  }

  customElements.define("mobile-porto-toc", MobilePortoTOC);
</script>
