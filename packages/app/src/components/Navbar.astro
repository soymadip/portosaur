---
// Navbar — Starlight's header shell (fixed bar, 3-column grid at
// desktop widths) with Portosaur's nav content. Derived in part from
// Starlight (MIT License) — see packages/app/NOTICE.md: the `.header`
// frame styles come from Starlight's PageFrame, the `.header-inner`
// grid from Starlight's Header; the nav entries, search visibility,
// dropdowns, theme select, hide-on-scroll, and mobile menu are
// Portosaur's own (converted from Tailwind utilities to plain CSS).
//
// On docs pages (`hasSidebar`), the navbar renders NO hamburger or
// mobile menu — the sidebar popover (MobileMenuToggle +
// MobileMenuFooter, in DocLayout) is the mobile navigation. On other
// pages the hamburger + slide-down menu stay.
//
// The fixed header is positioned by the `.header` rules below;
// BaseLayout's <main> reserves its height (padding-top).
import config from "porto:config";
import Icon from "./Icon.astro";
import Search from "./Search.astro";
import SiteTitle from "./SiteTitle.astro";
import ThemeSelect from "./ThemeSelect.astro";
import {
  buildNavEntries,
  isDropdown,
  PORTO_HOMEPAGE,
} from "../utils/navbar.ts";

interface Props {
  /** True on the portfolio home page — removes the header border and
   * hides the brand in landscape (ported from old `pages/index.jsx`). */
  isHome?: boolean;
  /** True on docs pages — the sidebar popover owns mobile nav, so
   * the hamburger + slide-down menu are omitted. */
  hasSidebar?: boolean;
}

const { isHome = false, hasSidebar = false } = Astro.props;

const { leftEntries, rightEntries, moreItems, showProjectLink, versionLabel } =
  buildNavEntries(config, Astro.url.pathname);

const site = config.site;
const theme = config.theme;

// Search visibility — port of the old `@easyops-cn/docusaurus-search-local`
// setup (`searchContextByPaths: [notesRoute, blogRoute]` with
// `hideSearchBarWithNoSearchContext: true`): the search button only shows on
// pages under the notes/docs route or the blog route, and is hidden on
// home, /tasks, /offline, /search, 404, and (in docs mode, where the
// notes route is "docs") the /notes NoteCards page. The plugin matches
// `uri === path || uri.startsWith(path + "/")` where uri is the pathname
// minus the base URL.
const base = site.baseUrl ?? "/";
const basePrefix = base === "/" ? "" : base.replace(/\/+$/, "");
const uri = (
  Astro.url.pathname.startsWith(basePrefix)
    ? Astro.url.pathname.slice(basePrefix.length)
    : Astro.url.pathname
).replace(/^\/+/, "");
const inSearchContext = (route: string) =>
  uri === route || uri.startsWith(`${route}/`);
const showSearch =
  inSearchContext(site.notesRoute) || inSearchContext(site.blogRoute);

const hideOnScroll = theme.hideNavbarOnScroll;
const showThemeSwitch = theme.showThemeSwitch;
---

<header
  class:list={["header", { "header--home": isHome }]}
  data-navbar
  data-hide-on-scroll={hideOnScroll || undefined}
>
  <div class="header-inner">
    {!hasSidebar && (
      <button
        type="button"
        class="menu-button porto-flex md:porto-hidden"
        data-navbar-toggle
        aria-expanded="false"
        aria-controls="porto-mobile-menu"
        aria-label="Toggle navigation menu"
      >
        <Icon name="bars" size="1.5rem" />
      </button>
    )}

    <div class="title-column">
      <div class:list={["title-wrapper", { "title-wrapper--home": isHome }]}>
        <SiteTitle />
      </div>
      {leftEntries.length > 0 && (
        <nav
          class="primary-nav porto-hidden md:porto-flex"
          aria-label="Primary"
        >
          {leftEntries.map((entry) =>
            isDropdown(entry) ? (
              <details class="porto-navbar__dropdown">
                <summary class="nav-summary">{entry.label}</summary>
                <ul class="dropdown-menu">
                  {entry.items.map((item) => (
                    <li>
                      <a
                        class:list={["dropdown-link", { active: item.active }]}
                        href={item.href}
                        target={item.external ? "_blank" : undefined}
                        rel={item.external ? "noopener noreferrer" : undefined}
                      >
                        {item.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </details>
            ) : (
              <a
                class:list={["nav-link", { active: entry.active }]}
                href={entry.href}
                target={entry.external ? "_blank" : undefined}
                rel={entry.external ? "noopener noreferrer" : undefined}
              >
                {entry.label}
              </a>
            ),
          )}
        </nav>
      )}
    </div>

    <div class="porto-flex print:hidden right-group">
      <div class="porto-flex search-group">
        {showSearch && <Search />}
        {showThemeSwitch && (
          <div class="porto-hidden md:porto-flex">
            <ThemeSelect />
          </div>
        )}
      </div>
      <nav class="primary-nav porto-hidden md:porto-flex" aria-label="Primary">
        {rightEntries.map((entry) =>
          isDropdown(entry) ? (
            <details class="porto-navbar__dropdown">
              <summary class="nav-summary">{entry.label}</summary>
              <ul class="dropdown-menu">
                {entry.items.map((item) => (
                  <li>
                    <a
                      class:list={["dropdown-link", { active: item.active }]}
                      href={item.href}
                      target={item.external ? "_blank" : undefined}
                      rel={item.external ? "noopener noreferrer" : undefined}
                    >
                      {item.label}
                    </a>
                  </li>
                ))}
              </ul>
            </details>
          ) : (
            <a
              class:list={["nav-link", { active: entry.active }]}
              href={entry.href}
              target={entry.external ? "_blank" : undefined}
              rel={entry.external ? "noopener noreferrer" : undefined}
            >
              {entry.label}
            </a>
          ),
        )}
        <details class="porto-navbar__dropdown more-dropdown">
          <summary class="nav-summary">More</summary>
          <ul class="dropdown-menu">
            {moreItems.map((item) => (
              <li>
                <a
                  class:list={["dropdown-link", { active: item.active }]}
                  href={item.href}
                  target={item.external ? "_blank" : undefined}
                  rel={item.external ? "noopener noreferrer" : undefined}
                >
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </details>
      </nav>
    </div>
  </div>

  {
    /*
      The header has a fixed height, so the open menu overflows it and
      overlays the page — like the old sidebar. It needs its own opaque
      background or the page shows through between the items.
    */
    !hasSidebar && (
      <div class="mobile-menu" id="porto-mobile-menu" data-mobile-menu hidden>
        <nav aria-label="Mobile">
          {[...leftEntries, ...rightEntries].map((entry) =>
            isDropdown(entry) ? (
              <details class="porto-navbar__dropdown mobile-dropdown">
                <summary class="nav-summary mobile-summary">
                  {entry.label}
                </summary>
                <ul class="mobile-submenu">
                  {entry.items.map((item) => (
                    <li>
                      <a
                        class:list={["dropdown-link", { active: item.active }]}
                        href={item.href}
                        target={item.external ? "_blank" : undefined}
                        rel={item.external ? "noopener noreferrer" : undefined}
                      >
                        {item.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </details>
            ) : (
              <a
                class:list={[
                  "nav-link",
                  "mobile-link",
                  { active: entry.active },
                ]}
                href={entry.href}
                target={entry.external ? "_blank" : undefined}
                rel={entry.external ? "noopener noreferrer" : undefined}
              >
                {entry.label}
              </a>
            ),
          )}
          <details class="porto-navbar__dropdown mobile-dropdown">
            <summary class="nav-summary mobile-summary">More</summary>
            <ul class="mobile-submenu">
              {moreItems.map((item) => (
                <li>
                  <a
                    class:list={["dropdown-link", { active: item.active }]}
                    href={item.href}
                    target={item.external ? "_blank" : undefined}
                    rel={item.external ? "noopener noreferrer" : undefined}
                  >
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          </details>
        </nav>
        {showThemeSwitch && (
          <div class="mobile-theme-select">
            <ThemeSelect />
          </div>
        )}
        {showProjectLink && (
          <a
            class="version-link"
            href={PORTO_HOMEPAGE}
            target="_blank"
            rel="noopener noreferrer"
          >
            {versionLabel}
          </a>
        )}
      </div>
    )
  }
</header>

<script>
  const navbar = document.querySelector("[data-navbar]");
  const toggle = document.querySelector("[data-navbar-toggle]");
  const mobileMenu = document.querySelector("[data-mobile-menu]");

  // Mobile slide-down menu (non-docs pages only — docs pages have no
  // hamburger; the sidebar popover is the mobile nav there).
  if (toggle && mobileMenu instanceof HTMLElement) {
    const closeMenu = () => {
      mobileMenu.hidden = true;
      toggle.setAttribute("aria-expanded", "false");
    };
    toggle.addEventListener("click", () => {
      const willOpen = mobileMenu.hidden;
      mobileMenu.hidden = !willOpen;
      toggle.setAttribute("aria-expanded", String(willOpen));
    });
    mobileMenu.addEventListener("click", (event) => {
      if (event.target instanceof HTMLAnchorElement) {
        closeMenu();
      }
    });
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && !mobileMenu.hidden) {
        closeMenu();
      }
    });
  }

  // Close open dropdowns on outside click / Escape (<details> doesn't
  // close itself). The toggle click itself lands inside the <details>,
  // so it isn't treated as outside.
  const closeDropdowns = () => {
    document
      .querySelectorAll("details.porto-navbar__dropdown[open]")
      .forEach((dropdown) => {
        dropdown.removeAttribute("open");
      });
  };
  document.addEventListener("click", (event) => {
    if (
      event.target instanceof Node &&
      !event.target.parentElement?.closest("details.porto-navbar__dropdown")
    ) {
      closeDropdowns();
    }
  });
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") {
      closeDropdowns();
    }
  });

  // Hide-on-scroll: slide the navbar away while scrolling down, bring
  // it back on scroll up (or at the top of the page). Two classes are
  // toggled: one on the header itself (the transform) and one on
  // <html> so the mobile TOC and sidebar popover can follow the
  // navbar (see MobileTableOfContents + DocLayout).
  if (
    navbar instanceof HTMLElement &&
    navbar.hasAttribute("data-hide-on-scroll")
  ) {
    let lastScrollY = window.scrollY;
    let ticking = false;
    const update = () => {
      const y = window.scrollY;
      const hidden = y > navbar.offsetHeight && y > lastScrollY;
      navbar.classList.toggle("porto-navbar--hidden", hidden);
      document.documentElement.classList.toggle("porto-navbar-hidden", hidden);
      lastScrollY = y;
      ticking = false;
    };
    window.addEventListener(
      "scroll",
      () => {
        if (!ticking) {
          window.requestAnimationFrame(update);
          ticking = true;
        }
      },
      { passive: true },
    );
  }
</script>

<style>
  @layer porto.core {
    /* Fixed header frame — from Starlight's PageFrame. */
    .header {
      z-index: var(--porto-z-index-navbar);
      position: fixed;
      inset-inline-start: 0;
      inset-block-start: 0;
      width: 100%;
      height: var(--porto-nav-height);
      /* Same separator as the TOC panel's left border. */
      border-bottom: 1px solid var(--porto-color-hairline);
      padding: var(--porto-nav-pad-y) var(--porto-nav-pad-x);
      padding-inline-end: var(--porto-nav-pad-x);
      /* The header shares the content background — it is separated
         by the border above, not by color. (--porto-color-bg-nav
         stays for the dropdown and mobile-menu surfaces, which
         must stand out from the background.) */
      background-color: var(--porto-color-bg);
      transition: transform 0.2s ease-in-out;
    }

    .header--home {
      border-bottom-color: transparent;
    }

    /* On docs pages the mobile menu button sits fixed at the top
       right — reserve its space in the header. */
    :global([data-has-sidebar]) .header {
      padding-inline-end: calc(
        var(--porto-nav-gap) + var(--porto-nav-pad-x) +
          var(--porto-menu-button-size)
      );
    }

    /* Hide-on-scroll: the script toggles `.porto-navbar--hidden` on
       the header while scrolling down. */
    .porto-navbar--hidden {
      transform: translateY(-100%);
    }

    /* Inner layout — from Starlight's Header (flex on mobile, the
       3-column grid at desktop widths). */
    .header-inner {
      display: flex;
      gap: var(--porto-nav-gap);
      justify-content: space-between;
      align-items: center;
      height: 100%;
    }

    .title-column {
      display: flex;
      align-items: center;
      gap: var(--porto-nav-gap);
      min-width: 0;
      flex: 1;
    }

    .title-wrapper {
      display: flex;
      /* Prevent long titles overflowing and covering the search and menu buttons on narrow viewports. */
      overflow: clip;
      /* Avoid clipping focus ring around link inside title wrapper. */
      padding: 0.25rem;
      margin: -0.25rem;
      min-width: 0;
    }

    @media (orientation: landscape) {
      .title-wrapper--home {
        display: none;
      }
    }

    .menu-button {
      align-items: center;
      border: 0;
      border-radius: 0.25rem;
      padding: 0.5rem;
      background-color: transparent;
      color: var(--porto-color-gray-2);
      cursor: pointer;
    }
    .menu-button:hover {
      color: var(--porto-color-white);
    }

    .right-group {
      gap: 1rem;
      align-items: center;
    }

    .search-group {
      gap: var(--porto-nav-gap);
      align-items: center;
    }

    /* Nav links + dropdowns (Portosaur's own, plain CSS). */
    .primary-nav {
      align-items: center;
      gap: 0.25rem;
    }

    .nav-link,
    .nav-summary {
      cursor: pointer;
      border-radius: 0.25rem;
      padding: 0.5rem 0.75rem;
      font-size: 0.95rem;
      text-decoration: none;
      color: var(--porto-color-gray-2);
      list-style: none;
      white-space: nowrap;
    }
    .nav-link:hover,
    .nav-summary:hover {
      color: var(--porto-color-white);
    }
    .nav-link.active,
    .nav-summary.active {
      font-weight: 600;
      color: var(--porto-color-text-accent);
    }
    .nav-summary::after {
      content: "▾";
      margin-inline-start: 0.25rem;
      font-size: 0.75em;
    }
    .nav-summary::-webkit-details-marker {
      display: none;
    }

    .porto-navbar__dropdown {
      position: relative;
    }

    .dropdown-menu {
      position: absolute;
      top: calc(100% + 0.5rem);
      right: 0;
      z-index: 101;
      min-width: 12rem;
      margin: 0;
      padding: 0.5rem 0;
      list-style: none;
      border-radius: 0.5rem;
      border: 1px solid var(--porto-color-hairline-light);
      background-color: var(--porto-color-bg-nav);
      box-shadow: var(--porto-shadow-md);
    }

    .dropdown-link {
      display: block;
      padding: 0.5rem 1rem;
      font-size: 0.95rem;
      text-decoration: none;
      color: var(--porto-color-gray-2);
    }
    .dropdown-link:hover {
      background-color: var(--porto-color-hairline-light);
      color: var(--porto-color-white);
    }
    .dropdown-link.active {
      font-weight: 600;
      color: var(--porto-color-text-accent);
    }

    /* Divider between the nav links and the "More" dropdown. */
    .more-dropdown {
      margin-inline-start: -7px;
      border-inline-start: 1.5px solid var(--porto-color-hairline);
      padding-inline-start: 0.5rem;
    }

    /* Mobile slide-down menu (non-docs pages). The margins
       compensate for the header's padding so the menu starts exactly
       at the header's bottom edge and spans the full width. */
    .mobile-menu {
      margin-top: var(--porto-nav-pad-y);
      margin-inline: calc(-1 * var(--porto-nav-pad-x));
      border-top: 1px solid var(--porto-color-hairline);
      background-color: var(--porto-color-bg-nav);
      padding: 0.5rem 1rem 1rem;
    }

    .mobile-link,
    .mobile-summary {
      display: block;
    }

    .mobile-dropdown {
      position: static;
    }

    .mobile-submenu {
      position: static;
      margin: 0;
      padding: 0 0 0 1rem;
      list-style: none;
      border: 0;
      background-color: transparent;
      box-shadow: none;
    }

    .mobile-theme-select {
      /* Flex so the select shrink-wraps (Starlight always places
        the select in a flex row; in a block context the label
        stretches full width and the caret drifts to the far edge). */
      display: flex;
      margin-top: 0.5rem;
      padding: 0.5rem 0.75rem;
    }

    .version-link {
      display: block;
      margin-top: 0.75rem;
      border-top: 1px solid var(--porto-color-hairline);
      padding-top: 0.75rem;
      text-align: center;
      font-size: 0.95rem;
      text-decoration: none;
      color: var(--porto-color-gray-3);
      opacity: 0.64;
    }
    .version-link:hover {
      color: var(--porto-color-white);
    }

    @media (min-width: 50rem) {
      :global(:root[data-has-sidebar]) {
        --__porto-sidebar-pad: calc(2 * var(--porto-nav-pad-x));
      }
      :global(:root:not([data-has-toc])) {
        --__porto-toc-width: 0rem;
      }
      .header-inner {
        --__porto-sidebar-width: max(
          0rem,
          var(--porto-content-inline-start, 0rem) - var(--porto-nav-pad-x)
        );
        --__porto-main-column-fr: calc(
          (
              100% + var(--__porto-sidebar-pad, 0rem) -
                var(--__porto-toc-width, var(--porto-sidebar-width)) -
                (2 * var(--__porto-toc-width, var(--porto-nav-pad-x))) -
                var(--porto-content-inline-start, 0rem) -
                var(--porto-content-width)
            ) /
            2
        );
        display: grid;
        grid-template-columns:
          /* 1 (site title): runs up until the main content column’s left edge or the width of the title, whichever is the largest */
          minmax(
            calc(
              var(--__porto-sidebar-width) +
                max(0rem, var(--__porto-main-column-fr) - var(--porto-nav-gap))
            ),
            auto
          )
          /* 2 (search box): all free space that is available. */
          1fr
          /* 3 (right items): use the space that these need. */
          auto;
        align-content: center;
      }
      /* The right cluster (theme + search + nav links) sits in the
        third column; the 1fr middle column stays empty as a spacer,
        so the cluster is right-aligned like OG Docusaurus. */
      .right-group {
        grid-column: 3;
      }
      :global([data-has-sidebar]) .header {
        padding-inline-end: var(--porto-nav-pad-x);
      }
    }
  }
</style>
