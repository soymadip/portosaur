---
// Navbar — Starlight's header shell (fixed bar, 3-column grid at
// desktop widths) with Portosaur's nav content. Derived in part from
// Starlight (MIT License) — see packages/app/NOTICE.md: the `.header`
// frame styles come from Starlight's PageFrame, the `.header-inner`
// grid from Starlight's Header; the nav entries, dropdowns, theme
// select, hide-on-scroll, and mobile menu are Portosaur's own
// (converted from Tailwind utilities to plain CSS).
//
// ONE navbar on every page (like OG Docusaurus — no homepage/docs
// split): brand left; right cluster is the search icon, the theme
// select (desktop only — on mobile it lives in the menu), the nav
// links (desktop only), and the menu button (mobile only, right
// side, VitePress-style). The menu button opens the MobileMenu
// popover via `popovertarget` — the sidebar tree on docs pages, the
// nav links + theme + version link elsewhere. Search shows on every
// page (a deliberate divergence from OG's
// `hideSearchBarWithNoSearchContext`, which hid it off the
// notes/blog routes — a unified navbar can't have a missing button).
//
// The visible nav links prefetch on viewport
// (`data-astro-prefetch="viewport"`): ClientRouter enables
// prefetching with the hover strategy by default, which never fires
// on a phone — so without this, tapping Docs fetched the whole page
// at tap time. The navbar links are always visible and few, so
// prefetching them costs little. The link to the current page is
// skipped (via `entry.current`, an exact pathname match — `active`
// is section-wide, so skipping on it never prefetched Docs from any
// docs page). Dropdown links keep the hover
// default (they're hidden until the dropdown opens). The sidebar
// links prefetch on viewport too (see SidebarSublist) — only the
// visible rows, so the cost stays bounded.
//
// The fixed header is positioned by the `.header` rules below;
// BaseLayout's <main> reserves its height (padding-top).
import config from "porto:config";
import Search from "./Search.astro";
import SiteTitle from "./SiteTitle.astro";
import ThemeSelect from "./ThemeSelect.astro";
import { buildNavEntries, isDropdown } from "../utils/navbar.ts";

interface Props {
  /** True on any home page (docs or portfolio) — removes the header
   * bottom border. */
  isHome?: boolean;
  /** True on the portfolio home page only — hides the brand in
   * landscape (ported from old `pages/index.jsx`). */
  isPortfolioHome?: boolean;
}

const { isHome = false, isPortfolioHome = false } = Astro.props;

const { leftEntries, rightEntries, moreItems } = buildNavEntries(
  config,
  Astro.url.pathname,
);

const theme = config.theme;

const hideOnScroll = theme.hideNavbarOnScroll;
const showThemeSwitch = theme.showThemeSwitch;
---

<header
  class:list={["header", { "header--home": isHome }]}
  data-navbar
  data-pagefind-ignore
  data-hide-on-scroll={hideOnScroll || undefined}
>
  <div class="header-inner">
    <div class="title-column">
      <div
        class:list={[
          "title-wrapper",
          { "title-wrapper--home": isPortfolioHome },
        ]}
      >
        <SiteTitle />
      </div>
      {leftEntries.length > 0 && (
        <nav
          class="primary-nav porto-hidden md:porto-flex"
          aria-label="Primary"
        >
          {leftEntries.map((entry) =>
            isDropdown(entry) ? (
              <details class="porto-navbar__dropdown">
                <summary class="nav-summary">{entry.label}</summary>
                <ul class="dropdown-menu">
                  {entry.items.map((item) => (
                    <li>
                      <a
                        class:list={["dropdown-link", { active: item.active }]}
                        href={item.href}
                        target={item.external ? "_blank" : undefined}
                        rel={item.external ? "noopener noreferrer" : undefined}
                      >
                        {item.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </details>
            ) : (
              <a
                class:list={["nav-link", { active: entry.active }]}
                href={entry.href}
                target={entry.external ? "_blank" : undefined}
                rel={entry.external ? "noopener noreferrer" : undefined}
                data-astro-prefetch={
                  entry.external || entry.current ? undefined : "viewport"
                }
              >
                {entry.label}
              </a>
            ),
          )}
        </nav>
      )}
    </div>

    <div class="porto-flex print:hidden right-group">
      <div class="porto-flex search-group">
        <Search />
        {showThemeSwitch && (
          <div class="porto-hidden md:porto-flex">
            <ThemeSelect />
          </div>
        )}
      </div>
      <nav class="primary-nav porto-hidden md:porto-flex" aria-label="Primary">
        {rightEntries.map((entry) =>
          isDropdown(entry) ? (
            <details class="porto-navbar__dropdown">
              <summary class="nav-summary">{entry.label}</summary>
              <ul class="dropdown-menu">
                {entry.items.map((item) => (
                  <li>
                    <a
                      class:list={["dropdown-link", { active: item.active }]}
                      href={item.href}
                      target={item.external ? "_blank" : undefined}
                      rel={item.external ? "noopener noreferrer" : undefined}
                    >
                      {item.label}
                    </a>
                  </li>
                ))}
              </ul>
            </details>
          ) : (
            <a
              class:list={["nav-link", { active: entry.active }]}
              href={entry.href}
              target={entry.external ? "_blank" : undefined}
              rel={entry.external ? "noopener noreferrer" : undefined}
              data-astro-prefetch={
                entry.external || entry.current ? undefined : "viewport"
              }
            >
              {entry.label}
            </a>
          ),
        )}
        <details class="porto-navbar__dropdown more-dropdown">
          <summary class="nav-summary">More</summary>
          <ul class="dropdown-menu">
            {moreItems.map((item) => (
              <li>
                <a
                  class:list={["dropdown-link", { active: item.active }]}
                  href={item.href}
                  target={item.external ? "_blank" : undefined}
                  rel={item.external ? "noopener noreferrer" : undefined}
                >
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </details>
      </nav>
      {/* Mobile menu button (right side) — VitePress's hamburger icon
          (VPNavBarHamburger, MIT License): three staggered lines that
          animate into an X while the menu is open. Opens the
          MobileMenu popover via the popover API, no JavaScript needed
          to open/close; MobileMenu's toggle handler syncs
          `aria-expanded` so the open state is announced. */}
      <button
        type="button"
        class="menu-button porto-flex md:porto-hidden"
        popovertarget="porto__sidebar"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
        aria-controls="porto__sidebar"
      >
        <span class="hamburger-container">
          <span class="hamburger-line top"></span>
          <span class="hamburger-line middle"></span>
          <span class="hamburger-line bottom"></span>
        </span>
      </button>
    </div>
  </div>
</header>

<script>
  const navbar = document.querySelector("[data-navbar]");

  // Close open dropdowns on outside click / Escape (<details> doesn't
  // close itself). The toggle click itself lands inside the <details>,
  // so it isn't treated as outside.
  const closeDropdowns = () => {
    document
      .querySelectorAll("details.porto-navbar__dropdown[open]")
      .forEach((dropdown) => {
        dropdown.removeAttribute("open");
      });
  };
  document.addEventListener("click", (event) => {
    if (
      event.target instanceof Node &&
      !event.target.parentElement?.closest("details.porto-navbar__dropdown")
    ) {
      closeDropdowns();
    }
  });
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") {
      closeDropdowns();
    }
  });

  // Hide-on-scroll: slide the navbar away while scrolling down, bring
  // it back on scroll up (or at the top of the page). Two classes are
  // toggled: one on the header itself (the transform) and one on
  // <html> so the mobile TOC and sidebar popover can follow the
  // navbar (see MobileTableOfContents + DocLayout).
  if (
    navbar instanceof HTMLElement &&
    navbar.hasAttribute("data-hide-on-scroll")
  ) {
    let lastScrollY = window.scrollY;
    let ticking = false;
    const update = () => {
      // Re-query the navbar on every scroll: client-side navigation
      // replaces the body, so the element captured at load is
      // detached after the first navigation.
      const current = document.querySelector("[data-navbar]");
      const y = window.scrollY;
      const hidden =
        current instanceof HTMLElement &&
        y > current.offsetHeight &&
        y > lastScrollY;
      current?.classList.toggle("porto-navbar--hidden", hidden);
      document.documentElement.classList.toggle("porto-navbar-hidden", hidden);
      lastScrollY = y;
      ticking = false;
    };
    window.addEventListener(
      "scroll",
      () => {
        if (!ticking) {
          window.requestAnimationFrame(update);
          ticking = true;
        }
      },
      { passive: true },
    );
  }
</script>

<style>
  @layer porto.core {
    /* Fixed header frame — from Starlight's PageFrame. */
    .header {
      z-index: var(--porto-z-index-navbar);
      position: fixed;
      inset-inline-start: 0;
      inset-block-start: 0;
      width: 100%;
      height: var(--porto-nav-height);
      /* No bottom border on mobile — it only appears at desktop
         widths (see the media query below). */
      padding: var(--porto-nav-pad-y) var(--porto-nav-pad-x);
      padding-inline-end: var(--porto-nav-pad-x);
      /* The header shares the content background — it is separated
         by the border above, not by color. (--porto-color-bg-nav
         stays for the dropdown and mobile-menu surfaces, which
         must stand out from the background.) */
      background-color: var(--porto-color-bg);
      transition: transform 0.2s ease-in-out;
    }

    /* Hide-on-scroll: the script toggles `.porto-navbar--hidden` on
       the header while scrolling down. */
    .porto-navbar--hidden {
      transform: translateY(-100%);
    }

    /* Inner layout — from Starlight's Header (flex on mobile, the
       3-column grid at desktop widths). */
    .header-inner {
      display: flex;
      gap: var(--porto-nav-gap);
      justify-content: space-between;
      align-items: center;
      height: 100%;
    }

    .title-column {
      display: flex;
      align-items: center;
      gap: var(--porto-nav-gap);
      min-width: 0;
      flex: 1;
    }

    .title-wrapper {
      display: flex;
      /* Prevent long titles overflowing and covering the search and menu buttons on narrow viewports. */
      overflow: clip;
      /* Avoid clipping focus ring around link inside title wrapper. */
      padding: 0.25rem;
      margin: -0.25rem;
      min-width: 0;
    }

    @media (orientation: landscape) {
      .title-wrapper--home {
        display: none;
      }
    }

    /* Mobile menu button (right side) — a plain icon button in the
       navbar's right cluster. */
    .menu-button {
      align-items: center;
      justify-content: center;
      border: 0;
      border-radius: 0.25rem;
      padding: 0.5rem;
      background-color: transparent;
      color: var(--porto-color-gray-1);
      cursor: pointer;
    }
    .menu-button:hover {
      color: var(--porto-color-white);
    }

    /* VitePress's hamburger icon (VPNavBarHamburger, MIT License),
       ported from the source (vitepress 1.6.4): three 16px lines in a
       16×14 box with overflow hidden. The stagger is NOT different
       line widths — every line is 16px, and the default translateX
       offsets (top 0, middle 8px, bottom 4px) clip the middle to 8px
       and the bottom to 12px visible, all right-aligned. (An earlier
       version here used 12/8/12 widths from a mis-measured
       screenshot: the analysis window clipped the top line's left
       edge, so it looked 12px. The source is authoritative.) Hover
       shifts the stagger (top 4px, middle 0, bottom 8px). While the
       menu popover is open the lines animate into an X — top rotates
       225°, bottom 135°, middle slides fully out — and hovering the
       open button dims the lines. The button and the popover are not
       siblings (the button lives in the header, the popover in the
       layout), so the open state reads off <body>. */
    .hamburger-container {
      position: relative;
      width: 16px;
      height: 14px;
      overflow: hidden;
    }
    .hamburger-line {
      position: absolute;
      left: 0;
      width: 16px;
      height: 2px;
      background-color: currentColor;
      transition:
        top 0.25s,
        background-color 0.5s,
        transform 0.25s;
    }
    .hamburger-line.top {
      top: 0;
      transform: translateX(0);
    }
    .hamburger-line.middle {
      top: 6px;
      transform: translateX(8px);
    }
    .hamburger-line.bottom {
      top: 12px;
      transform: translateX(4px);
    }
    .menu-button:hover .hamburger-line.top {
      transform: translateX(4px);
    }
    .menu-button:hover .hamburger-line.middle {
      transform: translateX(0);
    }
    .menu-button:hover .hamburger-line.bottom {
      transform: translateX(8px);
    }
    :global(body:has(#porto__sidebar:popover-open)) .hamburger-line.top {
      top: 6px;
      transform: translateX(0) rotate(225deg);
    }
    :global(body:has(#porto__sidebar:popover-open)) .hamburger-line.middle {
      top: 6px;
      transform: translateX(16px);
    }
    :global(body:has(#porto__sidebar:popover-open)) .hamburger-line.bottom {
      top: 6px;
      transform: translateX(0) rotate(135deg);
    }
    :global(body:has(#porto__sidebar:popover-open))
      .menu-button:hover
      .hamburger-line {
      background-color: var(--porto-color-gray-2);
      transition:
        top 0.25s,
        background-color 0.25s,
        transform 0.25s;
    }

    .right-group {
      gap: 1rem;
      align-items: center;
    }

    .search-group {
      gap: var(--porto-nav-gap);
      align-items: center;
    }

    /* Nav links + dropdowns (Portosaur's own, plain CSS). */
    .primary-nav {
      align-items: center;
      gap: 0.25rem;
    }

    .nav-link,
    .nav-summary {
      cursor: pointer;
      border-radius: 0.25rem;
      padding: 0.5rem 0.75rem;
      font-size: 0.95rem;
      text-decoration: none;
      color: var(--porto-color-gray-2);
      list-style: none;
      white-space: nowrap;
    }
    .nav-link:hover,
    .nav-summary:hover {
      color: var(--porto-color-white);
    }
    .nav-link.active,
    .nav-summary.active {
      font-weight: 600;
      color: var(--porto-color-text-accent);
    }
    .nav-summary::after {
      content: "▾";
      margin-inline-start: 0.25rem;
      font-size: 0.75em;
    }
    .nav-summary::-webkit-details-marker {
      display: none;
    }

    .porto-navbar__dropdown {
      position: relative;
    }

    .dropdown-menu {
      position: absolute;
      top: calc(100% + 0.5rem);
      right: 0;
      z-index: 101;
      min-width: 12rem;
      margin: 0;
      padding: 0.5rem 0;
      list-style: none;
      border-radius: 0.5rem;
      border: 1px solid var(--porto-color-hairline-light);
      background-color: var(--porto-color-bg-nav);
      box-shadow: var(--porto-shadow-md);
    }

    .dropdown-link {
      display: block;
      padding: 0.5rem 1rem;
      font-size: 0.95rem;
      text-decoration: none;
      color: var(--porto-color-gray-2);
    }
    .dropdown-link:hover {
      background-color: var(--porto-color-hairline-light);
      color: var(--porto-color-white);
    }
    .dropdown-link.active {
      font-weight: 600;
      color: var(--porto-color-text-accent);
    }

    /* Divider between the nav links and the "More" dropdown. */
    .more-dropdown {
      margin-inline-start: -7px;
      border-inline-start: 1.5px solid var(--porto-color-hairline);
      padding-inline-start: 0.5rem;
    }

    @media (min-width: 50rem) {
      /* Desktop only: the bottom border returns (same separator as
         the TOC panel's left border). Home pages keep it transparent
         — the override sits after the border rule (same specificity,
         so source order decides). */
      .header {
        border-bottom: 1px solid var(--porto-color-hairline);
      }
      .header--home {
        border-bottom-color: transparent;
      }

      :global(:root[data-has-sidebar]) {
        --__porto-sidebar-pad: calc(2 * var(--porto-nav-pad-x));
      }
      :global(:root:not([data-has-toc])) {
        --__porto-toc-width: 0rem;
      }
      .header-inner {
        --__porto-sidebar-width: max(
          0rem,
          var(--porto-content-inline-start, 0rem) - var(--porto-nav-pad-x)
        );
        --__porto-main-column-fr: calc(
          (
              100% + var(--__porto-sidebar-pad, 0rem) -
                var(--__porto-toc-width, var(--porto-sidebar-width)) -
                (2 * var(--__porto-toc-width, var(--porto-nav-pad-x))) -
                var(--porto-content-inline-start, 0rem) -
                var(--porto-content-width)
            ) /
            2
        );
        display: grid;
        grid-template-columns:
          /* 1 (site title): runs up until the main content column’s left edge or the width of the title, whichever is the largest */
          minmax(
            calc(
              var(--__porto-sidebar-width) +
                max(0rem, var(--__porto-main-column-fr) - var(--porto-nav-gap))
            ),
            auto
          )
          /* 2 (search box): all free space that is available. */
          1fr
          /* 3 (right items): use the space that these need. */
          auto;
        align-content: center;
      }
      /* The right cluster (theme + search + nav links) sits in the
        third column; the 1fr middle column stays empty as a spacer,
        so the cluster is right-aligned like OG Docusaurus. */
      .right-group {
        grid-column: 3;
      }
    }
  }
</style>
