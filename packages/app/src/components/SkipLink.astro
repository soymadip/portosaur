---
// Derived from Starlight (MIT License) — see packages/app/NOTICE.md.
// Starlight's SkipLink, renamed (`sl-` → `porto-`). Portosaur
// difference: the link targets `#main-content` (BaseLayout's <main>),
// not the page title — non-docs pages have no `#_top` heading.
---

<a class="porto-skip-link" href="#main-content">
  Skip to main content
</a>

<style>
  @layer porto.core {
    a {
      clip: rect(0, 0, 0, 0);
      position: fixed;
      top: 0.75rem;
      inset-inline-start: 0.75rem;
    }
    a:focus {
      clip: unset;
      z-index: var(--porto-z-index-skiplink);
      display: block;
      padding: 0.5rem 1rem;
      text-decoration: none;
      /* OG-style: accent text on a subtle 10% accent tint (same as the
         active sidebar item). The solid-accent box was under 4.5:1 in
         three schemes' dark mode and four schemes' light mode. The
         tint uses text-accent, the per-mode visible primary. */
      color: var(--porto-color-accent-high);
      background-color: color-mix(
        in srgb,
        var(--porto-color-text-accent) 10%,
        transparent
      );
      box-shadow: var(--porto-shadow-lg);
    }
    /* Dark mode only: lighten the text one step, as in the sidebar —
       the pill sits over the navbar (gray-6), so the same dracula /
       gruvbox primaries fall short at full strength. */
    :global([data-theme="dark"]) a:focus {
      color: color-mix(in srgb, var(--porto-color-accent-high) 65%, white);
    }
  }
</style>
