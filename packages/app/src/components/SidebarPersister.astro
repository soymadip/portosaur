---
// Derived from Starlight (MIT License) — see packages/app/NOTICE.md.
/*
  This component is designed to wrap the tree of `<SidebarSublist>` components in the sidebar.

  It does the following:
  - Wraps the tree in an `<porto-sidebar-state-persist>` custom element
  - Before the tree renders, adds an inline script which loads state and defines
  the behaviour for the `<porto-sidebar-restore>` custom element.
  - After the tree renders, adds an inline script which restores the sidebar scroll state.

  Notes:
  - On smaller viewports, restoring state is skipped as the sidebar is collapsed inside a menu.
  - The state is parsed from session storage and restored.
  - This is a progressive enhancement, so any errors are swallowed silently.

  The `aria-hidden` attribute on script tags is used to prevent a Safari/VoiceOver bug where the
  script is read out loud due to them being inside a container with `display: contents`.
  @see https://bugs.webkit.org/show_bug.cgi?id=283645

  Portosaur difference: the sidebar hash is a small djb2 over the
  serialized `porto:sidebar` tree (Starlight hashes its own route
  data); the inline scripts below are otherwise unchanged apart from
  the renames.
*/
import sidebarTree from "porto:sidebar";

function sidebarHash(tree: unknown): string {
  const text = JSON.stringify(tree ?? []);
  let hash = 5381;
  for (let i = 0; i < text.length; i++) {
    hash = ((hash << 5) + hash + text.charCodeAt(i)) | 0;
  }
  return (hash >>> 0).toString(36);
}

const hash = sidebarHash(sidebarTree);

declare global {
  interface Window {
    /** Restored scroll position. Briefly stored on the `window` global to pass between inline scripts. */
    _portoScrollRestore?: number;
  }
}
---

<porto-sidebar-state-persist data-hash={hash}>
  <script is:inline aria-hidden="true">
    (() => {
      try {
        if (!matchMedia("(min-width: 50em)").matches) return;
        /** @type {HTMLElement | null} */
        const target = document.querySelector("porto-sidebar-state-persist");
        const state = JSON.parse(
          sessionStorage.getItem("porto-sidebar-state") || "0",
        );
        if (!target || !state || target.dataset.hash !== state.hash) return;
        window._portoScrollRestore = state.scroll;
        customElements.define(
          "porto-sidebar-restore",
          class SidebarRestore extends HTMLElement {
            connectedCallback() {
              try {
                const idx = parseInt(this.dataset.index || "");
                const details = this.closest("details");
                if (details && typeof state.open[idx] === "boolean")
                  details.open = state.open[idx];
              } catch {}
            }
          },
        );
      } catch {}
    })();
  </script>

  <slot />

  <script is:inline aria-hidden="true">
    (() => {
      const scroller = document.getElementById("porto__sidebar");
      if (!window._portoScrollRestore || !scroller) return;
      scroller.scrollTop = window._portoScrollRestore;
      delete window._portoScrollRestore;
    })();
  </script>
</porto-sidebar-state-persist>

<style>
  @layer porto.core {
    porto-sidebar-state-persist {
      display: contents;
    }
  }
</style>
