---
// Derived from Starlight (MIT License) — see packages/app/NOTICE.md.
// Starlight's Sidebar (persister + sublist + mobile menu footer),
// renamed (`sl-` → `porto-`) and adapted to Portosaur's sidebar data.
//
// The `porto:sidebar` tree is the root's children — the top-level
// items, with no root wrapper (the old "Docs"/"Notes" root entry is
// gone). Both modes render the tree as-is, categories and all —
// Docusaurus-style nesting in notes mode too (the notes sidebar was
// flattened in `68797af`, reversed per user feedback: a flat list of
// every note left no visual hierarchy). The old root collapse
// chevron and the « sidebar-collapse button are gone: Starlight has
// no sidebar collapse; open/closed groups and scroll position
// persist across navigations instead (SidebarPersister).
import sidebarTree from "porto:sidebar";
import MobileMenuFooter from "./MobileMenuFooter.astro";
import SidebarPersister from "./SidebarPersister.astro";
import SidebarSublist from "./SidebarSublist.astro";

interface Props {
  currentHref: string;
}

const { currentHref } = Astro.props;

const items = sidebarTree;
---

<SidebarPersister>
  <SidebarSublist items={items} currentHref={currentHref} />
</SidebarPersister>

<div class="md:porto-hidden">
  <MobileMenuFooter />
</div>
