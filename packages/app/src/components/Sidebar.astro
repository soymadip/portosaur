---
// Derived from Starlight (MIT License) — see packages/app/NOTICE.md.
// Starlight's Sidebar (persister + sublist + mobile menu footer),
// renamed (`sl-` → `porto-`) and adapted to Portosaur's sidebar data.
//
// The `porto:sidebar` tree is a one-element array holding the root
// category ("Docs"/"Notes"). The root itself renders as the first
// top-level link (to the collection home), followed by the root's
// items — the same flattening the old sidebar did. The old root
// collapse chevron and the « sidebar-collapse button are gone:
// Starlight has no sidebar collapse; open/closed groups and scroll
// position persist across navigations instead (SidebarPersister).
import sidebarTree from "porto:sidebar";
import MobileMenuFooter from "./MobileMenuFooter.astro";
import SidebarPersister from "./SidebarPersister.astro";
import SidebarSublist from "./SidebarSublist.astro";

interface Props {
  currentHref: string;
}

const { currentHref } = Astro.props;

const root = sidebarTree[0];
const rootLink =
  root?.link?.href != null
    ? [{ type: "doc", href: root.link.href, label: root.label }]
    : [];
const items = [...rootLink, ...(root?.items ?? [])];
---

<SidebarPersister>
  <SidebarSublist items={items} currentHref={currentHref} />
</SidebarPersister>

<div class="md:porto-hidden">
  <MobileMenuFooter />
</div>
