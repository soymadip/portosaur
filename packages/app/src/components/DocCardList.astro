---
// DocCardList — generated-index cards from sidebar category items
// (port of the old wrapper around TopicList), restyled in Starlight's
// LinkCard + CardGrid language. Derived in part from Starlight (MIT
// License) — see packages/app/NOTICE.md: the card + grid styles come
// from Starlight's LinkCard/CardGrid user-components.
//
// Items are sidebar nodes: `title`/`label`, `href` (docs) or
// `link.href` (categories), `description`, `icon` (from the index doc's
// frontmatter on categories, the doc's own frontmatter on docs).
// Icons follow the old `getIconTitleProps`: the frontmatter icon, else a
// techMap/devicon guess from the title, else `md:folder` for categories
// and `md:notebook` for docs — rendered as inline SVG via
// `renderDynamicIcon` (emoji icons render as text). The SVG is `1em`,
// sized by the h2's font-size.
//
// Portosaur differences from Starlight's LinkCard:
// - Card titles stay <h2> (they are part of the page's heading list
//   and the frozen URL snapshots) instead of Starlight's <span>.
// - The description stays one-line truncated (Portosaur descriptions
//   come from frontmatter and can be long); Starlight's wraps.
// - The frontmatter icon renders before the title, next to
//   Starlight's right-arrow.
import Icon from "./Icon.astro";
import { renderDynamicIcon } from "../utils/icons.ts";

interface Props {
  items: any[];
}

const { items } = Astro.props;
---

<div class="card-grid">
  {items.map((item) => {
    const href = item.href ?? item.link?.href ?? "#";
    const title = item.title ?? item.label ?? "";
    const description = item.description;
    const icon = item.icon;
    // Old TopicList CardCategory prefixes the description with the
    // category item count ("3 items • desc"); plain doc links show
    // the description as-is.
    const isCategory = item.type === "category" && Array.isArray(item.items);
    const itemsCount = isCategory
      ? `${item.items.length} item${item.items.length === 1 ? "" : "s"}`
      : null;
    const iconHtml = renderDynamicIcon(icon, {
      slug: title,
      fallbackIcon: isCategory ? "md:folder" : "md:notebook",
    });
    return (
      <div class="porto-link-card">
        <span class="porto-flex stack">
          <a href={href} class="card-title-link">
            <span class="card-icon" set:html={iconHtml} />
            <h2 class="title" title={title}>
              <span class="truncate">{title}</span>
            </h2>
          </a>
          {(itemsCount || description) && (
            <span class="description truncate">
              {itemsCount && <strong>{itemsCount}</strong>}
              {itemsCount && description && (
                <>
                  {" "}
                  <span class="separator">•</span> {description}
                </>
              )}
              {!itemsCount && description}
            </span>
          )}
        </span>
        <Icon name="right-arrow" size="1.333em" class="icon" />
      </div>
    );
  })}
</div>

<style>
  /* `porto.components` sits after `porto.content` in the layer
     order, so these rules beat the content.css h2/p rules — this
     list renders inside the `.porto-markdown-content` slot wrapper.
     No `!important` needed except CardGrid's own `> *` rule, as in
     Starlight. */
  @layer porto.components {
    .card-grid {
      display: grid;
      grid-template-columns: 100%;
      gap: 1rem;
    }

    .card-grid > :global(*) {
      margin-top: 0 !important;
    }

    .porto-link-card {
      display: grid;
      grid-template-columns: 1fr auto;
      gap: 0.5rem;
      border: 1px solid var(--porto-color-gray-5);
      border-radius: 0.5rem;
      padding: 1rem;
      box-shadow: var(--porto-shadow-sm);
      position: relative;
    }

    a {
      text-decoration: none;
      line-height: var(--porto-line-height-headings);
    }

    /* The stretched link makes the whole card clickable while
       keeping the title as the link's accessible name. */
    a::before {
      content: "";
      position: absolute;
      inset: 0;
    }

    .stack {
      flex-direction: column;
      gap: 0.5rem;
      min-width: 0;
    }

    /* The icon chip sits BESIDE the <h2>, not inside it — an emoji
       icon inside the heading would enter the page's heading text
       (the frozen URL snapshots capture h2 text). */
    .card-title-link {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      min-width: 0;
    }

    .title {
      display: inline-flex;
      flex: 1;
      min-width: 0;
      align-items: center;
      margin: 0;
      color: var(--porto-color-white);
      font-weight: 600;
      font-size: var(--porto-text-lg);
    }

    .card-icon {
      display: inline-flex;
      flex-shrink: 0;
      align-items: center;
      justify-content: center;
    }
    .card-icon:empty {
      display: none;
    }

    .truncate {
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .description {
      color: var(--porto-color-gray-3);
      line-height: 1.5;
      font-size: var(--porto-text-sm);
    }

    .separator {
      opacity: 0.5;
    }

    .icon {
      color: var(--porto-color-gray-3);
    }

    /* Hover state */
    .porto-link-card:hover {
      background: var(--porto-color-gray-7, var(--porto-color-gray-6));
      border-color: var(--porto-color-gray-2);
    }

    .porto-link-card:hover .icon {
      color: var(--porto-color-white);
    }

    @media (min-width: 50rem) {
      .card-grid {
        grid-template-columns: 1fr 1fr;
        gap: 1.5rem;
      }
    }
  }
</style>
