---
// Derived from Starlight (MIT License) — see packages/app/NOTICE.md.
// Starlight's ContentPanel, renamed (`sl-` → `porto-`). One padded
// content block; consecutive panels are separated by a hairline.
---

<div class="content-panel">
  <div class="porto-container">
    <slot />
  </div>
</div>

<style>
  @layer porto.core {
    .content-panel {
      padding: 1.5rem var(--porto-content-pad-x);
    }
    .content-panel + .content-panel {
      border-top: 1px solid var(--porto-color-hairline);
    }
    /* No max-width: the article fills the whole main pane, like
       Docusaurus (Starlight caps it at --porto-content-width and
       centers it, leaving empty space at wide viewports). */
    .porto-container > :global(* + *) {
      margin-top: 1.5rem;
    }
  }
</style>
