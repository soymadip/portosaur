---
// MobileMenu — the mobile navigation popover, shared by every page.
// Derived in part from Starlight (MIT License) — see
// packages/app/NOTICE.md: the sidebar popover comes from Starlight's
// PageFrame, the footer shape from its MobileMenuFooter.
//
// On docs pages (`hasSidebar`) the popover also holds the sidebar
// tree (the slot) and becomes the persistent sidebar from 50rem up;
// on other pages it holds only the footer (nav links, theme select,
// version link). The toggle lives in the navbar (right cluster,
// mobile only) and opens this popover via `popovertarget` — no
// JavaScript needed to open/close; the script below only resets the
// popover attribute on desktop (persistent variant) and traps focus
// while the menu is open.
//
// Open/close animation — ported from VitePress's VPNavScreen
// (vitepress 1.6.4, theme-default): the pane fades (opacity 0.25s)
// while its content slides down 8px into place (transform 0.25s
// ease), and reverses on close. VitePress does it with Vue's
// <transition>; here it is pure CSS — `@starting-style` supplies
// the enter state (popovers go from `display: none`, so no
// transition would run otherwise) and `allow-discrete` on `display`
// and `overlay` keeps the pane rendered in the top layer for the
// 0.25s exit fade instead of vanishing instantly. Both are stable
// CSS, shipped in all major browsers since 2023–2024.
import MobileMenuFooter from "./MobileMenuFooter.astro";

interface Props {
  /** True on docs pages — the popover holds the sidebar tree (the
   * slot) and stays visible as the persistent sidebar at desktop
   * widths. */
  hasSidebar?: boolean;
}

const { hasSidebar = false } = Astro.props;
---

<nav
  class="sidebar print:hidden"
  aria-label={hasSidebar ? "Docs sidebar" : "Mobile navigation"}
>
  <script>
    // The mobile menu uses the popover API to open and close without JavaScript. We enhance this
    // behaviour with focus trapping while the menu is open.
    class PortoSidebarPane extends HTMLElement {
      constructor() {
        super();

        const desktopMediaQuery = matchMedia("(min-width: 50em)");

        // Remove the popover attribute on desktop viewports — only
        // for the persistent (docs) variant, where the pane becomes
        // the always-visible sidebar. The menu-only variant keeps
        // its popover at every width (its toggle hides at desktop,
        // so it can never open there).
        const resetPopoverAttribute = () => {
          this.popover =
            this.dataset.persistent !== undefined && desktopMediaQuery.matches
              ? null
              : "auto";
        };
        resetPopoverAttribute();
        desktopMediaQuery.addEventListener("change", () =>
          resetPopoverAttribute(),
        );

        // Update the menu state when the sidebar popover is toggled.
        this.addEventListener("toggle", ({ newState }) =>
          this.trapFocus(newState === "open"),
        );
      }
      /** Trap keyboard focus inside the header and menu when the menu is expanded. */
      trapFocus(shouldTrap: boolean) {
        // Docs pages inert the main frame (the sidebar popover sits
        // outside it, inside <main> — inerting <main> there would
        // inert the menu itself). Other pages have no main frame,
        // so the whole <main> is inerted instead.
        const targets = document.querySelector(".main-frame")
          ? ".main-frame, .porto-skip-link"
          : "main, .porto-skip-link";
        document.querySelectorAll<HTMLElement>(targets).forEach((el) => {
          el.toggleAttribute("inert", shouldTrap);
        });
      }
    }
    customElements.define("porto-sidebar-pane", PortoSidebarPane);
  </script>
  <porto-sidebar-pane
    popover=""
    id="porto__sidebar"
    data-persistent={hasSidebar || undefined}
    class:list={["sidebar-pane", { "sidebar-pane--persistent": hasSidebar }]}
  >
    <div class="sidebar-content porto-flex">
      <slot />
      <div class="md:porto-hidden">
        <MobileMenuFooter />
      </div>
    </div>
  </porto-sidebar-pane>
</nav>

<style>
  /* Sidebar popover — from Starlight's PageFrame. */
  @layer porto.core {
    .sidebar-pane {
      /* By default, user agents apply some opinionated styles to popovers, which we don’t want. */
      border: unset;
      padding: unset;
      height: unset;
      color: unset;

      position: fixed;
      z-index: var(--porto-z-index-menu);
      inset-block: var(--porto-nav-height) 0;
      inset-inline-start: 0;
      width: 100%;
      background-color: var(--porto-color-black);
      overflow-y: auto;
      /* No `scrollbar-gutter: stable` (Starlight reserves one): with
         collapsed categories the sidebar usually fits the viewport,
         so the reserved 16px gutter was pure dead space after the
         caret — the row box ended 21px before the pane edge. Without
         it the rows run to the content padding; a classic scrollbar
         takes its own space when the content does overflow, and the
         TOC panel already behaves this way. */
      /* Open/close animation (VitePress's nav screen): the pane
         fades over 0.25s. `display`/`overlay` with
         `allow-discrete` keep it rendered in the top layer for the
         exit fade instead of vanishing instantly. */
      opacity: 0;
      transition:
        opacity 0.25s,
        inset-block-start 0.2s ease-in-out,
        display 0.25s allow-discrete,
        overlay 0.25s allow-discrete;
    }

    .sidebar-pane:popover-open {
      opacity: 1;
    }

    /* Enter state: without this the pane would start at opacity 1
       (popovers go from `display: none`, so no transition runs). */
    @starting-style {
      .sidebar-pane:popover-open {
        opacity: 0;
      }
      .sidebar-pane:popover-open .sidebar-content {
        transform: translateY(-8px);
      }
    }

    /* The navbar hides on scroll down (hideNavbarOnScroll) — the
       sidebar follows it to the top of the viewport. */
    :global(html.porto-navbar-hidden) .sidebar-pane {
      inset-block-start: 0;
    }

    /* Horizontal padding is 0.3rem each side, not the 1rem sidebar
       gutter: at 1rem every entry sat one nest-level in from the pane
       edge (a nest level is 1rem: 0.5rem margin + 0.5rem padding on
       `ul ul li`). Docusaurus's sidebar menu uses 0.5rem; this sits
       tighter per user feedback, with the links' own 0.5rem padding
       providing the text gutter. */
    .sidebar-content {
      height: 100%;
      min-height: max-content;
      padding: 1rem 0.3rem 0;
      flex-direction: column;
      gap: 1rem;
      /* Open/close animation (VitePress's nav screen): the content
         slides down 8px into place as the pane fades in, and back
         up as it fades out. Scoped to `[popover]` so the persistent
         desktop sidebar (no popover attribute there) never shifts. */
      transition: transform 0.25s ease;
    }

    .sidebar-pane[popover]:not(:popover-open) .sidebar-content {
      transform: translateY(-8px);
    }

    @media (min-width: 50rem) {
      .sidebar-content::after {
        content: "";
        padding-bottom: 1px;
      }

      /* The persistent (docs) variant becomes the always-visible
         sidebar; the menu-only variant stays a popover (its toggle
         hides at desktop, so it can never open there). */
      .sidebar-pane--persistent {
        display: block;
        width: var(--porto-sidebar-width);
        background-color: var(--porto-color-bg-sidebar);
        /* Same separator as the TOC panel's left border. */
        border-inline-end: 1px solid var(--porto-color-hairline);
        /* Not a popover at desktop widths, so it never matches
           `:popover-open` — keep it fully opaque. */
        opacity: 1;
      }
    }
  }
</style>

<style is:global>
  @layer porto.core {
    body:has(#porto__sidebar:popover-open) {
      overflow: hidden;
    }

    @media (min-width: 50rem) {
      body:has(#porto__sidebar:popover-open) {
        overflow: auto;
      }
    }
  }
</style>
