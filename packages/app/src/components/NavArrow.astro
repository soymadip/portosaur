---
// NavArrow — port of the old components/NavArrow/index.jsx.
//
// A fixed circular button at the bottom center of the page. It appears
// once the page is scrolled past 100px and points down (bouncing) while
// there is a next section to scroll to, flipping to an up chevron near
// the bottom of the page, where a click scrolls back to the top. Click
// behavior is the old one exactly: next direct child of <main> with an
// id below the current scroll position (scrolling to the very bottom
// when that section is the last one, or when there is no next section).
//
// Two deliberate changes from the old component:
// - The old <Hint> tooltip is a plain `title` attribute (same call the
//   NoteCards port made — the real Hint lands in Phase 4); `aria-label`
//   carries the same text and both update with the direction.
// - The chevron size follows the Phase 2 inline stub (1.4rem): the old
//   component passed size="2.5rem" to the Icon but its own `.chevron`
//   class set 1.4rem, so the intended size was 1.4rem.
import { renderIcon } from "../utils/icons.ts";
---

<button
  id="nav-arrow"
  type="button"
  class="navArrow pointer-events-none fixed bottom-10 left-1/2 z-100 flex size-[50px] cursor-pointer items-center justify-center rounded-full border-0 bg-primary text-[#09090b] opacity-0 shadow-sm hover:bg-primary-darker hover:shadow-md [@media(max-width:768px)]:bottom-6 [@media(max-width:768px)]:size-[46px]"
  data-direction="down"
  aria-label="Scroll to next section"
  title="Next Section"
>
  <span
    class="iconWrapper down flex items-center justify-center text-[1.4rem] [&_svg]:size-[1em] [@media(max-width:768px)]:text-[1.2rem]"
    set:html={renderIcon("md:chevron-down")}
  />
  <span
    class="iconWrapper up flex items-center justify-center text-[1.4rem] [&_svg]:size-[1em] [@media(max-width:768px)]:text-[1.2rem]"
    set:html={renderIcon("md:chevron-up")}
  />
</button>

<script>
  const navArrow = document.getElementById("nav-arrow");

  if (navArrow instanceof HTMLButtonElement) {
    let scrollTimeout = 0;

    const getSections = () => {
      const main = document.querySelector("main");
      if (!main) {
        return [];
      }
      return Array.from(main.querySelectorAll(":scope > [id]"))
        .map((el) => el.id)
        .filter((id) => id !== "nav-arrow");
    };

    const setDirection = (direction) => {
      navArrow.setAttribute("data-direction", direction);
      const isDown = direction === "down";
      navArrow.setAttribute(
        "aria-label",
        isDown ? "Scroll to next section" : "Scroll to top",
      );
      navArrow.setAttribute("title", isDown ? "Next Section" : "Back to Top");
    };

    const handleScroll = () => {
      const scrollTop =
        window.pageYOffset || document.documentElement.scrollTop;
      const windowHeight = window.innerHeight;
      const fullHeight = document.documentElement.scrollHeight;

      navArrow.classList.toggle("visible", scrollTop > 100);

      if (scrollTop + windowHeight >= fullHeight - 50) {
        setDirection("up");
      } else {
        setDirection("down");
      }

      navArrow.classList.add("scrolling");
      window.clearTimeout(scrollTimeout);
      scrollTimeout = window.setTimeout(() => {
        navArrow.classList.remove("scrolling");
      }, 800);
    };

    const handleClick = () => {
      if (navArrow.getAttribute("data-direction") === "up") {
        window.scrollTo({ top: 0, behavior: "smooth" });
        return;
      }

      const sections = getSections();
      const windowTop =
        window.pageYOffset || document.documentElement.scrollTop;
      let nextSectionId = null;

      for (const id of sections) {
        const element = document.getElementById(id);
        if (element) {
          const rect = element.getBoundingClientRect();
          const absoluteTop = rect.top + windowTop;
          if (absoluteTop > windowTop + 100) {
            nextSectionId = id;
            break;
          }
        }
      }

      if (nextSectionId) {
        const isLastSection = nextSectionId === sections[sections.length - 1];

        if (isLastSection) {
          window.scrollTo({
            top: document.documentElement.scrollHeight,
            behavior: "smooth",
          });
        } else {
          document
            .getElementById(nextSectionId)
            .scrollIntoView({ behavior: "smooth" });
        }
      } else {
        window.scrollTo({
          top: document.documentElement.scrollHeight,
          behavior: "smooth",
        });
      }
    };

    window.addEventListener("scroll", handleScroll, { passive: true });
    handleScroll();
    navArrow.addEventListener("click", handleClick);
  }
</script>

<style>
  /* Transforms, JS-toggled state, and the bounce keyframes stay plain
     CSS: the script toggles `.visible` / `.scrolling` and
     `data-direction`, and the base / visible / hover / active
     transforms must all compose on the same `transform` property —
     Tailwind translate/scale utilities use the separate `translate` /
     `scale` properties and would double-apply. (The plain rules are
     unlayered, so they beat the layered `opacity-0` /
     `pointer-events-none` utilities above.) */
  .navArrow {
    transform: translateX(-50%) translateY(100px);
    transition:
      transform 400ms cubic-bezier(0.175, 0.885, 0.32, 1.275),
      opacity 400ms ease,
      background-color 200ms ease;
  }

  .navArrow.visible {
    transform: translateX(-50%) translateY(0);
    opacity: 1;
    pointer-events: auto;
  }

  .navArrow:hover {
    transform: translateX(-50%) translateY(-5px) scale(1.1);
  }

  .navArrow:active {
    transform: translateX(-50%) translateY(-2px) scale(0.95);
  }

  /* Only the chevron for the current direction shows. */
  .navArrow[data-direction="down"] .iconWrapper.up {
    display: none;
  }

  .navArrow[data-direction="up"] .iconWrapper.down {
    display: none;
  }

  .navArrow[data-direction="down"] .iconWrapper.down {
    animation: navArrowBounce 2s infinite;
  }

  @keyframes navArrowBounce {
    0%,
    20%,
    50%,
    80%,
    100% {
      transform: translateY(0);
    }
    40% {
      transform: translateY(-8px);
    }
    60% {
      transform: translateY(-4px);
    }
  }

  /* Subtly fade during manual scroll */
  .navArrow.scrolling {
    opacity: 0.7;
  }

  /* Reduced motion support */
  @media (prefers-reduced-motion: reduce) {
    .navArrow {
      transition: opacity 200ms ease;
      animation: none !important;
    }

    .navArrow.visible {
      transform: translateX(-50%) translateY(0);
    }
  }
</style>
