---
// Footer — renders only when `theme.footer.enable` is set.
//
// The message renders as HTML (theme-classic rendered the footer
// copyright as HTML too). The Portosaur credit link inside the default
// message is added — or omitted when
// `theme.footer.disable_project_link` is set — by the config engine
// (`buildSiteConfig`), so this component renders the message as-is.
import config from "porto:config";

const footer = config.theme.footer;
---

{footer.enable && (
  <footer>
    <div class="footer-message" set:html={footer.message} />
  </footer>
)}

<style>
  @layer porto.core {
    footer {
      border-top: 1px solid var(--porto-color-hairline);
      padding: 1rem;
      text-align: center;
    }

    .footer-message {
      font-size: 0.8rem;
      color: var(--porto-color-gray-3);
    }
  }

  /* The "Built with Portosaur" link is accent-colored. `:global(a)`:
     the link arrives via `set:html`, so it never carries this
     component's scope attribute — a plain scoped `a` selector
     compiles to `a.astro-<hash>` and never matches. */
  footer :global(a) {
    color: var(--porto-color-text-accent);
  }
</style>
