---
// Search — Starlight-style search button + modal (Pagefind).
//
// A navbar button opens a native <dialog> modal; `@pagefind/default-ui`
// lazy-loads on idle and renders results inside. A vanilla custom
// element (<porto-search>), zero framework — the same shape as
// Starlight's <site-search>, adapted to Portosaur's tokens and
// baseUrl handling.
//
// The Pagefind index is built at `astro:build:done`, so in dev the
// dialog shows a message instead of the UI (same tone as /search).
import config from "porto:config";

const base = config.site.baseUrl ?? "/";
const basePrefix = base === "/" ? "" : base.replace(/\/+$/, "");
// PagefindUI loads pagefind.js from here and derives result URLs from
// it, so subpath deploys work without extra config.
const bundlePath = `${basePrefix}/pagefind/`;
const isDev = import.meta.env.DEV;
---

<porto-search data-bundle-path={bundlePath}>
  <button
    data-open-modal
    disabled
    type="button"
    class="flex cursor-pointer items-center gap-2 rounded-[1.25rem] border border-border bg-surface px-3 py-1.5 text-[0.85rem] text-muted hover:text-foreground"
    aria-label="Search"
    aria-keyshortcuts="Control+K"
  >
    <svg
      width="16"
      height="16"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <circle cx="11" cy="11" r="8" />
      <path d="m21 21-4.3-4.3" />
    </svg>
    <span class="[@media(max-width:996px)]:hidden" aria-hidden="true">
      Search
    </span>
    <kbd
      class="flex items-center gap-0.5 rounded border border-border bg-background-alt px-1.5 py-0.5 text-[0.7rem] text-muted [@media(max-width:996px)]:hidden"
      style="display: none"
    >
      <kbd>Ctrl</kbd>
      <kbd>K</kbd>
    </kbd>
  </button>

  <dialog aria-label="Search">
    <div class="dialog-frame">
      <button
        data-close-modal
        type="button"
        class="absolute top-4 right-4 z-10 flex h-[calc(64px*var(--pagefind-ui-scale))] cursor-pointer items-center self-end border-0 bg-transparent p-1 text-[0.85rem] text-primary [@media(min-width:50rem)]:hidden"
      >
        Cancel
      </button>
      {isDev ? (
        <div class="m-auto text-center text-muted">
          <p>Search isn't available in dev mode.</p>
          <p>Build the site to enable search.</p>
        </div>
      ) : (
        <div class="search-container">
          <div id="porto-search-ui" />
        </div>
      )}
    </div>
  </dialog>
</porto-search>

{/*
  Inlined to avoid briefly showing an invalid shortcut. Purposely using
  the deprecated `navigator.platform` property to detect Apple devices,
  as the user agent is spoofed by some browsers when opening devtools.
*/}
<script is:inline>
  (() => {
    const openBtn = document.querySelector("button[data-open-modal]");
    const shortcut = openBtn?.querySelector("kbd");
    if (!openBtn || !(shortcut instanceof HTMLElement)) {
      return;
    }
    const platformKey = shortcut.querySelector("kbd");
    if (platformKey && /(Mac|iPhone|iPod|iPad)/i.test(navigator.platform)) {
      platformKey.textContent = "⌘";
      openBtn.setAttribute("aria-keyshortcuts", "Meta+K");
    }
    shortcut.style.display = "";
  })();
</script>

<script>
  class PortoSearch extends HTMLElement {
    constructor() {
      super();
      const openBtn = this.querySelector<HTMLButtonElement>(
        "button[data-open-modal]",
      )!;
      const closeBtn = this.querySelector<HTMLButtonElement>(
        "button[data-close-modal]",
      )!;
      const dialog = this.querySelector("dialog")!;
      const dialogFrame = this.querySelector(".dialog-frame")!;

      /** Close the modal if a user clicks on a link or outside of the modal. */
      const onClick = (event: MouseEvent) => {
        const isLink = "href" in (event.target || {});
        if (
          isLink ||
          (document.body.contains(event.target as Node) &&
            !dialogFrame.contains(event.target as Node))
        ) {
          closeModal();
        }
      };

      const openModal = (event?: MouseEvent) => {
        dialog.showModal();
        document.body.toggleAttribute("data-search-modal-open", true);
        this.querySelector("input")?.focus();
        event?.stopPropagation();
        window.addEventListener("click", onClick);
      };

      const closeModal = () => {
        dialog.close();
      };

      openBtn.addEventListener("click", openModal);
      openBtn.disabled = false;
      closeBtn.addEventListener("click", closeModal);

      dialog.addEventListener("close", () => {
        document.body.toggleAttribute("data-search-modal-open", false);
        window.removeEventListener("click", onClick);
      });

      // Listen for `ctrl + k` and `cmd + k` keyboard shortcuts.
      window.addEventListener("keydown", (e) => {
        if ((e.metaKey === true || e.ctrlKey === true) && e.key === "k") {
          if (dialog.open) {
            closeModal();
          } else {
            openModal();
          }
          e.preventDefault();
        }
      });

      if (import.meta.env.DEV) {
        return;
      }
      const onIdle =
        window.requestIdleCallback || ((cb: () => void) => setTimeout(cb, 1));
      onIdle(async () => {
        // @ts-expect-error — Missing types for @pagefind/default-ui package.
        const { PagefindUI } = await import("@pagefind/default-ui");
        new PagefindUI({
          element: "#porto-search-ui",
          bundlePath: this.dataset.bundlePath,
          showImages: false,
          showSubResults: true,
        });
        // If the user opened the modal before the UI mounted, focus the
        // input now that it exists.
        if (dialog.open) {
          this.querySelector("input")?.focus();
        }
      });
    }
  }
  customElements.define("porto-search", PortoSearch);
</script>

<style>
  /* The dialog is fullscreen on small screens, a centered card on
     desktop — the Starlight shape, in Portosaur tokens. */
  dialog {
    margin: 0;
    padding: 0;
    background-color: var(--color-background);
    border: 1px solid var(--color-border);
    color: var(--color-foreground);
    width: 100%;
    max-width: 100%;
    height: 100%;
    max-height: 100%;
    box-shadow: var(--shadow-lg);
  }
  dialog[open] {
    display: flex;
  }
  dialog::backdrop {
    background-color: rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(0.25rem);
  }
  .dialog-frame {
    position: relative;
    overflow: auto;
    flex-direction: column;
    flex-grow: 1;
    display: flex;
    gap: 1rem;
    padding: 1rem;
  }
  @media (min-width: 50rem) {
    dialog {
      margin: 4rem auto auto;
      border-radius: 0.5rem;
      width: 90%;
      max-width: 40rem;
      height: max-content;
      min-height: 15rem;
      max-height: calc(100% - 8rem);
    }
    .dialog-frame {
      padding: 1.5rem;
    }
  }
</style>

<style is:global>
  @import url("@pagefind/default-ui/css/ui.css");

  [data-search-modal-open] {
    overflow: hidden;
  }

  /* Pagefind UI variables, mapped to Portosaur tokens so every scheme
     and mode picks them up. The input and titles use the foreground;
     excerpts are muted via the override below. */
  #porto-search-ui {
    --pagefind-ui-primary: var(--color-primary);
    --pagefind-ui-text: var(--color-foreground);
    --pagefind-ui-font: var(--font-body);
    --pagefind-ui-background: var(--color-background);
    --pagefind-ui-border: var(--color-border);
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: var(--radius-card);
    --pagefind-ui-tag: var(--color-surface);
    /* Room for the Cancel button beside the input on mobile; the
       button is hidden on desktop, so the space goes to zero there. */
    --search-cancel-space: 5rem;
  }

  @media (min-width: 50rem) {
    #porto-search-ui {
      --search-cancel-space: 0px;
    }
  }

  #porto-search-ui .pagefind-ui__search-input {
    font-weight: 400;
    width: calc(100% - var(--search-cancel-space));
  }

  #porto-search-ui .pagefind-ui__search-clear {
    inset-inline-end: var(--search-cancel-space);
  }

  #porto-search-ui .pagefind-ui__search-input::placeholder {
    color: var(--color-muted);
    opacity: 1;
  }

  #porto-search-ui input:focus {
    --pagefind-ui-border: var(--color-primary);
  }

  #porto-search-ui .pagefind-ui__result-excerpt {
    color: var(--color-muted);
  }

  #porto-search-ui mark {
    color: var(--color-foreground);
    background-color: transparent;
    font-weight: 600;
  }
</style>
