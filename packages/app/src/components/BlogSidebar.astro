---
// Blog sidebar ("Recent posts") — the Docusaurus `BlogSidebar`: posts
// grouped by year (newest year first), each post a link under its
// year. Used on the blog list pages and on post pages (left column).
// The current post (on post pages) is marked `aria-current`.
interface SidebarPost {
  url: string;
  title: string;
  date: Date | null;
}

interface Props {
  posts: SidebarPost[];
  currentUrl?: string;
}

const { posts, currentUrl } = Astro.props;

// Group by year, newest first; undated posts (no frontmatter date, no
// git date, no mtime — only when the source file cannot be found)
// gather under "Undated" at the end. Posts keep their input order
// within a year (routes pass them newest first).
const byYear = new Map<number, SidebarPost[]>();
const undated: SidebarPost[] = [];
for (const post of posts) {
  if (post.date) {
    const year = post.date.getFullYear();
    const group = byYear.get(year) ?? [];
    group.push(post);
    byYear.set(year, group);
  } else {
    undated.push(post);
  }
}
const groups = [...byYear.keys()]
  .sort((a, b) => b - a)
  .map((year) => ({ label: String(year), posts: byYear.get(year) ?? [] }));
if (undated.length > 0) {
  groups.push({ label: "Undated", posts: undated });
}
---

<aside class="porto-blog-sidebar">
  <nav aria-label="Recent posts">
    <h3 class="porto-blog-sidebar-title">Recent posts</h3>
    {groups.map((group) => (
      <div class="porto-blog-sidebar-group">
        <h4 class="porto-blog-sidebar-year">{group.label}</h4>
        <ul class="porto-blog-sidebar-list">
          {group.posts.map((post) => (
            <li>
              <a
                class="porto-blog-sidebar-link"
                href={post.url}
                aria-current={currentUrl === post.url ? "page" : undefined}
              >
                {post.title}
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </nav>
</aside>
