---
// Derived from Starlight (MIT License) — see packages/app/NOTICE.md.
// Starlight's PageTitle, renamed. The page <h1> (id `_top`, the
// skip-link target); the title arrives as a prop — Starlight reads
// it from its route data instead.
import { PAGE_TITLE_ID } from "../constants.ts";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<h1 id={PAGE_TITLE_ID}>{title}</h1>

<style>
  @layer porto.core {
    /* OG colors the page title with the primary (Docusaurus `.markdown h1`). */
    h1 {
      margin-top: 1rem;
      font-size: var(--porto-text-h1);
      line-height: var(--porto-line-height-headings);
      font-weight: 600;
      color: var(--porto-color-text-accent);
    }
  }
</style>
