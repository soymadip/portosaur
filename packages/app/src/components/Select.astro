---
// Derived from Starlight (MIT License) — see packages/app/NOTICE.md.
// Starlight's Select, renamed (`sl-` → `porto-`).
import Icon from "./Icon.astro";
import type { PortoIcon } from "../utils/porto-icons.ts";

interface Props {
  label: string;
  icon?: PortoIcon;
  width?: string;
  options: Array<{
    label: string;
    value: string;
    selected: boolean;
  }>;
}

/**
 * The `autocomplete="off"` attribute is used to prevent the browser from automatically selecting a
 * value for this input, e.g. based on the user's previous selections, as this could lead to
 * incorrect values being selected for example when the user switches between languages and uses
 * the back button.
 * Note that this attribute is only useful when a value is not restored at a later stage, e.g. the
 * bfcache that ignores this attribute when restoring the value.
 */
---

<label style={`--porto-select-width: ${Astro.props.width}`}>
  <span class="sr-only">{Astro.props.label}</span>
  <span class="icon label-icon">
    {Astro.props.icon ? <Icon name={Astro.props.icon} /> : <slot name="icon" />}
  </span>
  <select autocomplete="off">
    {Astro.props.options.map(({ value, selected, label }) => (
      <option value={value} selected={selected} set:html={label} />
    ))}
  </select>
  <Icon name="down-caret" class="icon caret" />
</label>

<style>
  @layer porto.core {
    label {
      --porto-label-icon-size: 0.875rem;
      --porto-caret-size: 1.25rem;
      --porto-inline-padding: 0.5rem;
      position: relative;
      display: flex;
      align-items: center;
      gap: 0.25rem;
      color: var(--porto-color-gray-2);
    }

    label:hover {
      color: var(--porto-color-white);
    }

    .icon {
      display: flex;
      position: absolute;
      pointer-events: none;
    }

    select {
      border: 0;
      padding-block: 0.625rem;
      padding-inline: calc(
          var(--porto-label-icon-size) + var(--porto-inline-padding) + 0.25rem
        )
        calc(var(--porto-caret-size) + var(--porto-inline-padding) + 0.25rem);
      margin-inline: calc(var(--porto-inline-padding) * -1);
      width: calc(var(--porto-select-width) + var(--porto-inline-padding) * 2);
      background-color: transparent;
      text-overflow: ellipsis;
      color: inherit;
      cursor: pointer;
      appearance: none;
    }

    option {
      background-color: var(--porto-color-bg-nav);
      color: var(--porto-color-gray-1);
    }

    @media (min-width: 50rem) {
      select {
        font-size: var(--porto-text-sm);
      }
    }
  }

  @layer porto.components {
    .label-icon {
      font-size: var(--porto-label-icon-size);
      inset-inline-start: 0;
    }

    .caret {
      font-size: var(--porto-caret-size);
      inset-inline-end: 0;
    }
  }
</style>
