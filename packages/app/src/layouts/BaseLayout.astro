---
// BaseLayout — the document shell (port of the old swizzled `Layout`).
//
// Renders <head> (title, meta description, social-card meta, favicon /
// manifest links, user head tags, user custom CSS), the theme-mode
// inline script (resolves the initial mode from localStorage /
// defaultMode / the OS preference for `auto`, before paint — no
// flash), skip-link, Navbar, <main>,
// Footer, the theme-mode module, and the PWA scripts.
//
// Pages must NOT render their own <main>: this layout owns it (the old
// `pages/index.jsx` rendered a nested <main> inside Layout's div —
// that nesting is dropped in the port).
//
// The navbar is fixed, so <main> reserves its height (padding-top:
// nav-height). DocLayout adds the mobile-TOC height on top for docs
// pages. `hasSidebar`/`hasToc` land as data attributes on <html> —
// the Starlight CSS system keys its two-column layout off them.
// The theme CSS entry (Starlight's CSS system, renamed to `porto-`,
// + Portosaur's schemes and overrides). IMPORTANT: these two imports
// MUST stay first — the CSS bundle follows import order, and
// custom.css carries the cascade-layer order declaration, which has
// to precede every component's scoped `@layer` block (see the comment
// at the top of custom.css). User custom CSS (`theme.custom_css`, via
// the `porto:user-css` virtual module) is imported AFTER it, so Vite
// bundles the user rules last and they win the cascade — a `<link>`
// can't do that, because Astro appends its bundled stylesheet links
// at the end of `<head>`.
import "../css/custom.css";
import "porto:user-css";

import { ClientRouter } from "astro:transitions";
import config from "porto:config";
import { getAssetHeadTags } from "../utils/assets.ts";
import MobileMenu from "../components/MobileMenu.astro";
import Navbar from "../components/Navbar.astro";
import NavProgress from "../components/NavProgress.astro";
import Footer from "../components/Footer.astro";
import SkipLink from "../components/SkipLink.astro";

// Font preloads: the two latin variable-font files every page
// downloads (Geist + Geist Mono, normal weight — the italic and
// latin-ext faces only load when used). Imported with `?url` so Vite
// resolves the hashed asset URL at build time; the fontsource CSS
// references the same files, so Vite emits each one once.
import geistLatinWoff2 from "@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url";
import geistMonoLatinWoff2 from "@fontsource-variable/geist-mono/files/geist-mono-latin-wght-normal.woff2?url";

// KaTeX stylesheet URL, resolved at build time via `?url` (never a
// hardcoded hashed path). The stylesheet is linked only on pages
// that render math (`hasMath`, flagged by the remarkHasMath plugin)
// — it used to be imported globally from custom.css, ~25KB on every
// page. The `?url` import keeps Vite emitting the file (and its
// fonts) as a standalone asset; browsers only download it when the
// link below (or the fallback script) asks for it.
import katexCssUrl from "katex/dist/katex.min.css?url";

interface Props {
  title: string;
  description?: string;
  noFooter?: boolean;
  wrapperClassName?: string;
  hasSidebar?: boolean;
  hasToc?: boolean;
  /**
   * The page renders math (flagged by the remarkHasMath plugin) —
   * links the KaTeX stylesheet. Pages without math get no KaTeX
   * CSS; pages with math whose flag was never plumbed through
   * still get the stylesheet from the fallback script at the end
   * of <body>.
   */
  hasMath?: boolean;
}

const {
  title,
  description,
  noFooter,
  wrapperClassName,
  hasSidebar = false,
  hasToc = false,
  hasMath = false,
} = Astro.props;

const site = config.site;
const theme = config.theme;

const base = site.baseUrl ?? "/";
const basePrefix = base === "/" ? "" : base.replace(/\/+$/, "");
const withBase = (urlPath: string) =>
  `${basePrefix}${urlPath.startsWith("/") ? urlPath : `/${urlPath}`}`;

// Head-tag objects come in two shapes: `{ tagName, attributes,
// innerHTML? }` (generated asset tags) and the `{ tag: attrs }`
// shorthand users write in `site.head_tags`. Normalize both (the old
// `buildHeadTags` did the same).
interface HeadTag {
  tagName: string;
  attributes: Record<string, string>;
  innerHTML?: string;
}

function normalizeHeadTag(tag: any): HeadTag | null {
  if (!tag || typeof tag !== "object") {
    return null;
  }
  if (tag.tagName && tag.attributes) {
    return {
      tagName: tag.tagName,
      attributes: tag.attributes,
      innerHTML: tag.innerHTML,
    };
  }
  const entries = Object.entries(tag);
  if (entries.length === 0) {
    return null;
  }
  const [tagName, attributes] = entries[0];
  return {
    tagName,
    attributes: (attributes ?? {}) as Record<string, string>,
  };
}

// Favicon / manifest / theme-color links, computed from the resolved
// config (the assets hook generates the files they point to). The
// engine's `extraHeadTags` are merged in too (empty in the current
// flow — nothing feeds them — but the contract stands), deduped by
// tag, then the user's own `site.head_tags`.
const assetTags = getAssetHeadTags(config)
  .map(normalizeHeadTag)
  .filter((tag): tag is HeadTag => tag !== null);
const extraTags = (config.extraHeadTags ?? [])
  .map(normalizeHeadTag)
  .filter((tag): tag is HeadTag => tag !== null);
const userTags = (site.headTags ?? [])
  .map(normalizeHeadTag)
  .filter((tag): tag is HeadTag => tag !== null);
const seenTags = new Set<string>();
const headTags: HeadTag[] = [];
for (const tag of [...assetTags, ...extraTags]) {
  const key = JSON.stringify(tag);
  if (!seenTags.has(key)) {
    seenTags.add(key);
    headTags.push(tag);
  }
}
headTags.push(...userTags);

// Social card: absolute URL for og:image / twitter:image.
function absoluteUrl(value: string | undefined): string | undefined {
  if (!value) {
    return undefined;
  }
  if (/^https?:\/\//.test(value)) {
    return value;
  }
  const siteUrl = (site.url ?? "").replace(/\/$/, "");
  return `${siteUrl}${withBase(value)}`;
}
const socialCardUrl = absoluteUrl(site.socialCard);

// Home-page detection: the borderless header applies to both home
// pages (docs and portfolio); the brand hiding in landscape stays
// portfolio-only, like the ported index.jsx inline style.
const pathname = Astro.url.pathname;
const isHome =
  pathname === "/" ||
  (basePrefix !== "" &&
    (pathname === basePrefix || pathname === `${basePrefix}/`));
const isPortfolioHome = isHome && config.siteMode === "portfolio";

const pwaEnabled = site.pwa?.enable ?? false;
const pwaNotifications = site.pwa?.notifications ?? false;
const swUrl = withBase("sw.js");
---

<!doctype html>
<html
  lang="en"
  transition:animate="none"
  data-scheme={theme.colorScheme}
  data-theme={theme.defaultMode}
  data-has-sidebar={hasSidebar || undefined}
  data-has-toc={hasToc || undefined}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <meta name="generator" content={`Portosaur v${config.portoVersion}`} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:type" content="website" />
    {socialCardUrl && <meta property="og:image" content={socialCardUrl} />}
    <meta
      name="twitter:card"
      content={socialCardUrl ? "summary_large_image" : "summary"}
    />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    {socialCardUrl && <meta name="twitter:image" content={socialCardUrl} />}
    <link
      rel="preload"
      href={geistLatinWoff2}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={geistMonoLatinWoff2}
      as="font"
      type="font/woff2"
      crossorigin
    />
    {headTags.map((tag) => {
      const Tag = tag.tagName as any;
      if (tag.innerHTML) {
        return <Tag {...tag.attributes} set:html={tag.innerHTML} />;
      }
      return <Tag {...tag.attributes} />;
    })}
    {/*
      KaTeX stylesheet, only on pages that render math — see the
      `?url` import above. `data-katex-css` marks the link so the
      fallback script at the end of <body> can tell it is already
      present.
    */}
    {hasMath && <link rel="stylesheet" href={katexCssUrl} data-katex-css />}
    {/*
      Blocking theme-mode script: applies the stored choice (or the
      configured defaultMode) before first paint, so there is no
      flash. A stored `auto` resolves against the OS preference.
      The full theme-mode module loads at the end of <body>.

      With client-side navigation the swap copies the new page's
      server-rendered data-theme (the site default) onto <html>,
      losing the user's stored choice — so the script also
      registers an `astro:before-swap` listener that carries the
      resolved mode into the incoming document before the swap.
      The listener registers once (guarded): inline scripts can
      re-execute on repeat visits.
    */}
    <script is:inline define:vars={{ defaultMode: theme.defaultMode }}>
      (function () {
        function resolveMode() {
          var mode = defaultMode;
          try {
            var stored = window.localStorage.getItem("theme");
            if (stored === "light" || stored === "dark") {
              mode = stored;
            } else if (stored === "auto") {
              mode = window.matchMedia("(prefers-color-scheme: light)").matches
                ? "light"
                : "dark";
            }
          } catch (error) {
            // Storage unavailable — fall back to the configured default.
          }
          return mode;
        }
        document.documentElement.setAttribute("data-theme", resolveMode());
        if (!window.__portoThemeSwap) {
          window.__portoThemeSwap = true;
          document.addEventListener("astro:before-swap", function (event) {
            event.newDocument.documentElement.setAttribute(
              "data-theme",
              resolveMode(),
            );
          });
        }
      })();
    </script>
    {/*
      Client-side routing (SPA mode): internal links navigate without
      a full page reload. No page transition animation
      (`transition:animate="none"` on <html>) — like VitePress and
      Docusaurus, the swap is instant instead of a 180ms cross-fade.
      Module scripts run once, so every script that touches the DOM
      re-runs its setup on `astro:page-load` (see theme-mode.ts,
      code-blocks.ts, and the component scripts).
    */}
    <ClientRouter />
  </head>
  <body>
    <SkipLink />
    <NavProgress />

    <Navbar isHome={isHome} isPortfolioHome={isPortfolioHome} />

    {/*
      The mobile menu popover on pages without a sidebar (docs pages
      render it from DocLayout, with the sidebar tree inside). The
      navbar's menu button opens it via `popovertarget`.
    */}
    {!hasSidebar && <MobileMenu />}

    <div class="porto-content-wrapper">
      <main id="main-content" class:list={[wrapperClassName]}>
        <slot />
      </main>
      {/*
        Phase 4: the Preact Preview island mounts here — the dock as a
        sticky flex sibling of <main>, popup / PiP / mobile dock via a
        portal (see plan §4.4.5). Nothing Preview-related is mounted
        until then.
      */}
    </div>

    {!noFooter && <Footer />}

    {/* Theme select wiring + theme-color sync (every page). */}
    <script>
      import "../scripts/theme-mode.ts";
    </script>

    {/* Code-block framing (copy button, language label) on every page. */}
    <script>
      import "../scripts/code-blocks.ts";
    </script>

    {/* Stricter slow-connection gate for prefetching (every page). */}
    <script>
      import "../scripts/prefetch-gate.ts";
    </script>

    {/* Touchstart preload for internal links (every page). */}
    <script>
      import "../scripts/touch-preload.ts";
    </script>

    {/* Delayed navigation progress bar (every page). */}
    <script>
      import "../scripts/nav-progress.ts";
    </script>

    {/*
      Slow-connection prefetch gate, initial load: Astro's own 2g
      check never fires on a throttled-but-"4g" connection, so strip
      the viewport-prefetch attributes when the Network Information
      API reports a slow link — stripped links fall back to the hover
      strategy (`prefetchAll`), which is intent-based and one link at
      a time. This classic script runs during parsing, before Astro's
      deferred prefetch module initializes; navigations are gated by
      the `astro:before-swap` listener in `scripts/prefetch-gate.ts`
      (same thresholds — keep the two in sync).
    */}
    <script is:inline>
      (function () {
        try {
          var conn = navigator.connection;
          if (!conn) {
            return;
          }
          var slow =
            conn.saveData ||
            /2g/.test(conn.effectiveType || "") ||
            (typeof conn.downlink === "number" && conn.downlink < 1) ||
            (typeof conn.rtt === "number" && conn.rtt > 400);
          if (slow) {
            document
              .querySelectorAll("[data-astro-prefetch='viewport']")
              .forEach(function (el) {
                el.removeAttribute("data-astro-prefetch");
              });
          }
        } catch (error) {
          // Network Information API unavailable — prefetch as normal.
        }
      })();
    </script>

    {/*
      PWA: register the service worker in production builds only (the
      old @docusaurus/plugin-pwa behaved the same). The worker itself
      (`sw.js`, from `sw-custom.ts` via @vite-pwa/astro injectManifest)
      is wired in Phase 5 — until then registration rejects and is
      ignored.
    */}
    {pwaEnabled && import.meta.env.PROD && <script
      is:inline
      define:vars={{ swUrl }}
    >
      if ("serviceWorker" in navigator) {
        window.addEventListener("load", function () {
          navigator.serviceWorker.register(swUrl).catch(function () {});
        });
      }
    </script>}

    {/*
      Periodic Background Sync registration (12h new-post checks).
      Only when notifications are enabled — permission itself is
      requested by the NotifyButton's user gesture, never here.
    */}
    {pwaEnabled && pwaNotifications && <script>
      import "../clientModules/periodicSync.ts";
    </script>}

    {/*
      KaTeX fallback: the head link above covers pages whose `hasMath`
      flag is plumbed through, but a page that renders math without
      the flag (a page type nobody wired yet) would show unstyled
      math — so when KaTeX markup is present but no stylesheet link
      is, inject one. Runs on load and on every client-side
      navigation (`astro:page-load` — the listener registers once,
      guarded, since inline scripts can re-execute on repeat
      visits). A no-op on pages without math and on pages whose
      head link already exists.
    */}
    <script is:inline define:vars={{ katexCssUrl }}>
      (function () {
        function ensureKatexCss() {
          if (!document.querySelector(".katex")) {
            return;
          }
          if (document.querySelector("link[data-katex-css]")) {
            return;
          }
          var link = document.createElement("link");
          link.rel = "stylesheet";
          link.setAttribute("data-katex-css", "");
          link.href = katexCssUrl;
          document.head.appendChild(link);
        }
        ensureKatexCss();
        if (!window.__portoKatexCss) {
          window.__portoKatexCss = true;
          document.addEventListener("astro:page-load", ensureKatexCss);
        }
      })();
    </script>
  </body>
</html>

<style>
  /* Document shell layout (plain CSS — the navbar is fixed, so
     <main> reserves its height). The body is the flex column (there
     is no `.page` wrapper — Starlight's PageFrame wraps header +
     sidebar + main in one; Portosaur's header lives in the Navbar
     component and the sidebar in DocLayout, so the body plays that
     role). */
  body {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  .porto-content-wrapper {
    display: flex;
    flex: 1 0 auto;
    flex-direction: row;
  }

  main {
    display: flex;
    flex: auto;
    flex-direction: column;
    min-width: 0;
    padding-top: var(--porto-nav-height);
  }
</style>
