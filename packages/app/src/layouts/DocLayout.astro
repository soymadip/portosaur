---
// DocLayout — docs/notes page shell on top of BaseLayout, in
// Starlight's page-frame language. Derived in part from Starlight
// (MIT License) — see packages/app/NOTICE.md: the sidebar popover +
// main-frame structure comes from Starlight's PageFrame, the panel
// layout from its Page.
//
// Structure: a fixed sidebar popover (the mobile menu on small
// screens, a persistent sidebar from 50em up) + `.main-frame`
// holding TwoColumnContent — the right TOC aside and the main pane
// with two content panels: breadcrumbs + the <h1> title, then the
// markdown content + the doc footer (edit link, last updated,
// pagination).
//
// The <h1> renders here (from the `heading` prop), not in the page
// slot — pages pass `heading` and put only the body in the slot.
//
// Dropped from the old layout: the PageActions edit/copy-link
// buttons, the mobile toolbar + its rAF positioning script, the «
// sidebar-collapse button and the root collapse chevron (Starlight
// has no sidebar collapse; group open state + scroll position
// persist across navigations instead).
//
// Version banner/badge: DROPPED — versioning is unused.
import config from "porto:config";
import sidebar, { home as sidebarHome } from "porto:sidebar";
import BaseLayout from "./BaseLayout.astro";
import ContentPanel from "../components/ContentPanel.astro";
import DocFooter from "../components/DocFooter.astro";
import MarkdownContent from "../components/MarkdownContent.astro";
import MobileMenuToggle from "../components/MobileMenuToggle.astro";
import PageSidebar from "../components/PageSidebar.astro";
import PageTitle from "../components/PageTitle.astro";
import Sidebar from "../components/Sidebar.astro";
import TwoColumnContent from "../components/TwoColumnContent.astro";
import { findBreadcrumbs, findPrevNext } from "../utils/content.ts";

interface Props {
  title: string;
  description?: string;
  /** The page <h1> (rendered here by PageTitle, not in the slot). */
  heading: string;
  currentHref: string;
  headings?: { depth: number; slug: string; text: string }[];
  editUrl?: string;
  lastUpdated?: string;
}

const {
  title,
  description,
  heading,
  currentHref,
  headings = [],
  editUrl,
  lastUpdated,
} = Astro.props;

// The section crumb comes from the mode/route, not the tree — the
// tree carries no root category. The home link prepends the
// pagination order, so the first doc's "Previous" still points at
// the collection home.
const section = {
  title: config.siteMode === "docs" ? "Docs" : "Notes",
  href: `/${config.site.notesRoute}`,
};
const breadcrumbs = config.theme.breadcrumbs
  ? findBreadcrumbs(sidebar, currentHref, section)
  : [];
const { prev, next } = findPrevNext(sidebar, currentHref, sidebarHome);
const tocHeadings = headings.filter(
  (heading) => heading.depth >= 2 && heading.depth <= 3,
);
const hasToc = tocHeadings.length > 0;
---

<BaseLayout title={title} description={description} hasSidebar hasToc={hasToc}>
  <nav class="sidebar print:hidden" aria-label="Docs sidebar">
    <MobileMenuToggle />
    <script>
      // The mobile menu uses the popover API to open and close without JavaScript. We enhance this
      // behaviour with focus trapping while the menu is open.
      class PortoSidebarPane extends HTMLElement {
        constructor() {
          super();

          const desktopMediaQuery = matchMedia("(min-width: 50em)");

          // Remove the popover attribute on desktop viewports. It's only needed for the mobile menu.
          const resetPopoverAttribute = () => {
            this.popover = desktopMediaQuery.matches ? null : "auto";
          };
          resetPopoverAttribute();
          desktopMediaQuery.addEventListener("change", () =>
            resetPopoverAttribute(),
          );

          // Update the menu state when the sidebar popover is toggled.
          this.addEventListener("toggle", ({ newState }) =>
            this.trapFocus(newState === "open"),
          );
        }
        /** Trap keyboard focus inside the header and menu when the menu is expanded. */
        trapFocus(shouldTrap: boolean) {
          document
            .querySelectorAll<HTMLElement>(".main-frame, .porto-skip-link")
            .forEach((el) => {
              el.toggleAttribute("inert", shouldTrap);
            });
        }
      }
      customElements.define("porto-sidebar-pane", PortoSidebarPane);
    </script>
    <porto-sidebar-pane popover="" id="porto__sidebar" class="sidebar-pane">
      <div class="sidebar-content porto-flex">
        <Sidebar currentHref={currentHref} />
      </div>
    </porto-sidebar-pane>
  </nav>

  <div class="main-frame">
    <TwoColumnContent hasToc={hasToc}>
      <PageSidebar slot="right-sidebar" headings={tocHeadings} />
      <ContentPanel>
        {breadcrumbs.length > 0 && (
          <nav class="breadcrumbs" aria-label="Breadcrumbs">
            <ol>
              <li>
                <a href="/" aria-label="Home">
                  ⌂
                </a>
              </li>
              {breadcrumbs.map((crumb, index) => {
                const isLast = index === breadcrumbs.length - 1;
                // Categories without an index doc have href: null
                // (see findSidebarPath) — plain text, not a link.
                return (
                  <li>
                    {isLast || !crumb.href ? (
                      <span
                        class:list={[{ current: isLast }]}
                        aria-current={isLast ? "page" : undefined}
                      >
                        {crumb.title}
                      </span>
                    ) : (
                      <a href={crumb.href}>{crumb.title}</a>
                    )}
                  </li>
                );
              })}
            </ol>
          </nav>
        )}
        <PageTitle title={heading} />
      </ContentPanel>
      <ContentPanel>
        <MarkdownContent>
          <slot />
        </MarkdownContent>
        <DocFooter
          editUrl={editUrl}
          lastUpdated={lastUpdated}
          prev={prev}
          next={next}
        />
      </ContentPanel>
    </TwoColumnContent>
  </div>

  <script>
    import "../scripts/sidebar-persist.ts";
  </script>
</BaseLayout>

<style>
  /* Sidebar popover + main frame — from Starlight's PageFrame. */
  @layer porto.core {
    .sidebar-pane {
      /* By default, user agents apply some opinionated styles to popovers, which we don’t want. */
      border: unset;
      padding: unset;
      height: unset;
      color: unset;

      position: fixed;
      z-index: var(--porto-z-index-menu);
      inset-block: var(--porto-nav-height) 0;
      inset-inline-start: 0;
      width: 100%;
      background-color: var(--porto-color-black);
      overflow-y: auto;
      scrollbar-gutter: stable;
      transition: inset-block-start 0.2s ease-in-out;
    }

    /* The navbar hides on scroll down (hideNavbarOnScroll) — the
       sidebar follows it to the top of the viewport. */
    :global(html.porto-navbar-hidden) .sidebar-pane {
      inset-block-start: 0;
    }

    .sidebar-content {
      height: 100%;
      min-height: max-content;
      padding: 1rem var(--porto-sidebar-pad-x) 0;
      flex-direction: column;
      gap: 1rem;
    }

    @media (min-width: 50rem) {
      .sidebar-content::after {
        content: "";
        padding-bottom: 1px;
      }
    }

    /* BaseLayout's <main> already reserves the nav height; the frame
       adds only the mobile-TOC height. */
    .main-frame {
      padding-top: var(--porto-mobile-toc-height);
      padding-inline-start: var(--porto-content-inline-start);
    }

    @media (min-width: 50rem) {
      .sidebar-pane {
        /* Make the sidebar visible on larger screens instead of deferring to popover state. */
        display: block;
        width: var(--porto-sidebar-width);
        background-color: var(--porto-color-bg-sidebar);
        border-inline-end: 1px solid var(--porto-color-hairline-shade);
      }
    }

    /* Breadcrumbs (Portosaur's own, config-gated). */
    .breadcrumbs ol {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.25rem;
      margin: 0 0 1rem;
      padding: 0;
      list-style: none;
      font-size: 0.85rem;
    }

    .breadcrumbs li + li::before {
      content: "›";
      margin-inline-end: 0.25rem;
      color: var(--porto-color-gray-3);
    }

    .breadcrumbs a {
      color: var(--porto-color-text-accent);
      text-decoration: none;
    }
    .breadcrumbs a:hover {
      text-decoration: underline;
    }

    .breadcrumbs .current {
      color: var(--porto-color-text-accent);
    }
  }
</style>
