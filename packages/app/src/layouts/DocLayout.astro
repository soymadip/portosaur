---
// DocLayout — docs/notes page shell on top of BaseLayout (port of the
// old swizzled `DocItem/Layout`).
//
// Left sidebar (from `porto:sidebar`), main column with breadcrumbs,
// the page content (<slot /> — the <h1> title is rendered by the page
// itself), a minimal mobile TOC disclosure (<details>; the full
// MobileTOC component is Phase 4), desktop TOC aside, prev/next
// paginator, and the doc footer (Edit link + last updated).
//
// PageActions (edit ✎ + copy-link ⧉ buttons, top-right) are inline
// here; the old copy-markdown dropdown is Phase 4.
//
// Version banner/badge: DROPPED — versioning is unused.
import config from "porto:config";
import sidebar from "porto:sidebar";
import BaseLayout from "./BaseLayout.astro";
import Sidebar from "../components/Sidebar.astro";
import TOC from "../components/TOC.astro";
import { findSidebarPath, findPrevNext } from "../utils/content.ts";

interface Props {
  title: string;
  description?: string;
  currentHref: string;
  headings?: { depth: number; slug: string; text: string }[];
  editUrl?: string;
  lastUpdated?: string;
}

const {
  title,
  description,
  currentHref,
  headings = [],
  editUrl,
  lastUpdated,
} = Astro.props;

const breadcrumbs = config.theme.breadcrumbs
  ? findSidebarPath(sidebar, currentHref)
  : [];
const { prev, next } = findPrevNext(sidebar, currentHref);
const tocHeadings = headings.filter(
  (heading) => heading.depth >= 2 && heading.depth <= 3,
);
---

<BaseLayout title={title} description={description}>
  <div class="porto-doc-layout flex w-full items-start gap-8 p-4">
    {/*
      Expand button (»): only visible while the sidebar is collapsed
      (see the toggle script below); re-opens the sidebar.
    */}
    <button
      type="button"
      class="porto-doc-sidebar__expand sticky top-[calc(var(--navbar-height,60px)+1rem)] hidden size-8 shrink-0 items-center justify-center self-start rounded-md border border-border bg-background-alt p-0 text-[1.1rem] leading-none text-muted hover:border-primary hover:text-primary"
      data-sidebar-expand
      aria-label="Expand sidebar"
    >
      »
    </button>
    <aside class="porto-doc-sidebar sticky top-[calc(var(--navbar-height,60px)+1rem)] h-[calc(100vh-var(--navbar-height,60px)-2rem)] w-[300px] shrink-0 [@media(max-width:996px)]:hidden">
      <nav class="flex h-full flex-col" aria-label="Docs sidebar">
        <Sidebar currentHref={currentHref} />
      </nav>
    </aside>

    {/*
      `@container/docContainer`: container-query context for the
      pagination below (port of the old pagination.css `docContainer`):
      the content column is ~660px wide at desktop widths, so the
      container query — not a viewport media query — is what stacks
      the prev/next cards.
    */}
    <div class="relative @container/docContainer flex min-w-0 flex-auto flex-col">
      {/*
        PageActions: edit + copy-link icon buttons at the top-right of
        the doc page (above the TOC area on desktop).
      */}
      <div class="absolute top-0 right-0 z-1 flex gap-2">
        {editUrl && (
          <a
            class="inline-flex size-8 items-center justify-center rounded-md border border-border bg-background-alt p-0 text-base leading-none text-foreground no-underline hover:border-primary hover:text-primary"
            href={editUrl}
            title="Edit this page"
            aria-label="Edit this page"
          >
            ✎
          </a>
        )}
        <button
          type="button"
          class="inline-flex size-8 items-center justify-center rounded-md border border-border bg-background-alt p-0 text-base leading-none text-foreground no-underline hover:border-primary hover:text-primary data-[copied=true]:border-primary data-[copied=true]:text-primary"
          data-copy-page-url
          title="Copy link"
          aria-label="Copy link"
        >
          ⧉
        </button>
      </div>

      {/*
        The article column is capped for readability (~60rem) while the
        layout itself is full-width: sidebar flush left, TOC flush right,
        leftover space between the article and the TOC.
      */}
      <article class="flex w-full max-w-[60rem] flex-[1_0_auto] flex-col">
        {breadcrumbs.length > 0 && (
          <nav aria-label="Breadcrumbs">
            <ol class="m-0 mb-4 flex list-none flex-wrap items-center gap-1 p-0 pr-20 text-[0.85rem]">
              <li class="[li+&]:before:mr-1 [li+&]:before:text-muted [li+&]:before:content-['›']">
                <a
                  class="text-primary no-underline hover:underline"
                  href="/"
                  aria-label="Home"
                >
                  ⌂
                </a>
              </li>
              {breadcrumbs.map((crumb, index) => {
                const isLast = index === breadcrumbs.length - 1;
                // Categories without an index doc have href: null
                // (see findSidebarPath) — plain text, not a link.
                return (
                  <li class="[li+&]:before:mr-1 [li+&]:before:text-muted [li+&]:before:content-['›']">
                    {isLast || !crumb.href ? (
                      <span
                        class:list={[{ "text-primary": isLast }]}
                        aria-current={isLast ? "page" : undefined}
                      >
                        {crumb.title}
                      </span>
                    ) : (
                      <a
                        class="text-primary no-underline hover:underline"
                        href={crumb.href}
                      >
                        {crumb.title}
                      </a>
                    )}
                  </li>
                );
              })}
            </ol>
          </nav>
        )}

        {/*
          Mobile toolbar: sticky under the navbar on small screens; the
          client script below keeps it glued to the navbar bottom while
          the navbar hides/shows (port of the old MobileToolbar
          requestAnimationFrame positioning).
        */}
        {tocHeadings.length > 0 && (
          <div
            class="hidden [@media(max-width:996px)]:sticky [@media(max-width:996px)]:top-[var(--mobile-toolbar-top,0px)] [@media(max-width:996px)]:z-100 [@media(max-width:996px)]:flex [@media(max-width:996px)]:items-center [@media(max-width:996px)]:bg-background [@media(max-width:996px)]:pt-[0.35rem] [@media(max-width:996px)]:pb-4"
            data-mobile-toolbar
            style="--mobile-toolbar-top: 0px"
          >
            <details>
              <summary class="cursor-pointer font-semibold">
                On this page
              </summary>
              <TOC headings={tocHeadings} spy={false} />
            </details>
          </div>
        )}

        <div class="porto-markdown">
          <slot />
        </div>

        {(editUrl || lastUpdated) && (
          <footer class="mt-auto flex flex-wrap justify-between gap-4 pt-8 text-[0.9rem] text-muted">
            <span>
              {editUrl && (
                <a class="text-primary no-underline" href={editUrl}>
                  Edit this page
                </a>
              )}
            </span>
            <span>
              {lastUpdated && <span>Last updated on {lastUpdated}</span>}
            </span>
          </footer>
        )}
      </article>

      {(prev || next) && (
        <nav
          class:list={[
            "mt-auto grid w-full max-w-[60rem] grid-cols-2 gap-4 [@container(max-width:768px)]:grid-cols-1 [@container(max-width:768px)]:gap-[0.15rem] [@media(max-width:996px)]:grid-cols-1 [@media(max-width:996px)]:gap-[0.15rem]",
            editUrl || lastUpdated ? "pt-6" : "pt-[2.9rem]",
          ]}
          aria-label="Docs pages"
        >
          {prev && (
            <a
              class="flex flex-col gap-1 rounded-lg border border-border bg-background-alt p-4 text-foreground no-underline hover:border-primary"
              href={prev.href}
            >
              <span class="text-[0.85rem] text-muted">Previous</span>
              <span class="flex items-center justify-start text-left text-[1.1rem] text-primary">
                {prev.title}
              </span>
            </a>
          )}
          {next && (
            <a
              class="col-start-2 flex flex-col gap-1 rounded-lg border border-border bg-background-alt p-4 text-right text-foreground no-underline hover:border-primary [@container(max-width:768px)]:col-start-1 [@media(max-width:996px)]:col-start-1"
              href={next.href}
            >
              <span class="text-[0.85rem] text-muted">Next</span>
              <span class="flex items-center justify-end text-right text-[1.1rem] text-primary">
                {next.title}
              </span>
            </a>
          )}
        </nav>
      )}
    </div>

    {tocHeadings.length > 0 && (
      <aside class="sticky top-[calc(var(--navbar-height,60px)+1rem)] max-h-[calc(100vh-var(--navbar-height,60px)-2rem)] w-[220px] shrink-0 overflow-y-auto [@media(max-width:996px)]:hidden">
        <TOC headings={tocHeadings} />
      </aside>
    )}
  </div>

  <script>
    // Port of the old MobileToolbar effect: keep the sticky mobile
    // toolbar glued to the navbar's bottom edge while the navbar
    // hides/shows on scroll, and publish the scroll offset headings
    // need so anchor jumps don't land under the toolbar.
    const toolbar = document.querySelector("[data-mobile-toolbar]");
    const navbar = document.querySelector("[data-navbar]");
    if (toolbar instanceof HTMLElement && navbar instanceof HTMLElement) {
      let animationFrame = 0;
      const updateTop = () => {
        const navbarBottom = Math.max(0, navbar.getBoundingClientRect().bottom);
        const navbarReservedHeight = Math.max(
          navbarBottom,
          navbar.offsetHeight,
        );
        toolbar.style.setProperty("--mobile-toolbar-top", `${navbarBottom}px`);
        document.documentElement.style.setProperty(
          "--mobile-doc-scroll-offset",
          `${navbarReservedHeight + toolbar.offsetHeight + 8}px`,
        );
      };

      const stopFollowingNavbar = () => {
        if (animationFrame) {
          window.cancelAnimationFrame(animationFrame);
          animationFrame = 0;
        }
        updateTop();
      };

      const followNavbar = (event) => {
        if (event.propertyName !== "transform") {
          return;
        }
        if (animationFrame) {
          window.cancelAnimationFrame(animationFrame);
        }
        const follow = () => {
          updateTop();
          animationFrame = window.requestAnimationFrame(follow);
        };
        follow();
      };

      const observer = new MutationObserver(() => {
        window.requestAnimationFrame(updateTop);
      });
      observer.observe(navbar, {
        attributes: true,
        attributeFilter: ["class"],
      });
      navbar.addEventListener("transitionrun", followNavbar);
      navbar.addEventListener("transitionend", stopFollowingNavbar);
      navbar.addEventListener("transitioncancel", stopFollowingNavbar);
      window.addEventListener("resize", updateTop);
      updateTop();
    }
  </script>

  <script>
    // PageActions copy button: copies the page URL and shows a brief
    // "Copied" state (title/aria-label + data-copied styling).
    const copyButton = document.querySelector("[data-copy-page-url]");
    if (copyButton instanceof HTMLButtonElement) {
      copyButton.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(window.location.href);
        } catch {
          // Clipboard API unavailable (non-secure context) — fall back
          // to a hidden textarea + execCommand.
          const textarea = document.createElement("textarea");
          textarea.value = window.location.href;
          document.body.appendChild(textarea);
          textarea.select();
          document.execCommand("copy");
          textarea.remove();
        }
        copyButton.setAttribute("data-copied", "true");
        copyButton.setAttribute("title", "Copied!");
        copyButton.setAttribute("aria-label", "Copied!");
        window.setTimeout(() => {
          copyButton.removeAttribute("data-copied");
          copyButton.setAttribute("title", "Copy link");
          copyButton.setAttribute("aria-label", "Copy link");
        }, 1500);
      });
    }

    // Sidebar collapse (« at the sidebar bottom) / expand (» at the
    // layout's left edge): toggling a class on the layout hides the
    // sidebar and lets the content column expand.
    const layout = document.querySelector(".porto-doc-layout");
    const collapseButton = document.querySelector("[data-sidebar-collapse]");
    const expandButton = document.querySelector("[data-sidebar-expand]");
    if (layout && collapseButton && expandButton) {
      collapseButton.addEventListener("click", () => {
        layout.classList.add("porto-doc-layout--sidebar-collapsed");
      });
      expandButton.addEventListener("click", () => {
        layout.classList.remove("porto-doc-layout--sidebar-collapsed");
      });
    }

    // Sidebar root header chevron: collapses/expands the whole tree
    // (the CSS hides every root-list item but the header row).
    const rootToggle = document.querySelector("[data-sidebar-root-toggle]");
    const sidebarList = document.querySelector(".porto-sidebar");
    if (rootToggle instanceof HTMLButtonElement && sidebarList) {
      rootToggle.addEventListener("click", () => {
        const collapsed =
          sidebarList.getAttribute("data-root-collapsed") === "true";
        sidebarList.setAttribute("data-root-collapsed", String(!collapsed));
        rootToggle.setAttribute("aria-expanded", String(collapsed));
        rootToggle.textContent = collapsed ? "⌄" : "›";
        rootToggle.setAttribute(
          "aria-label",
          collapsed ? "Collapse sidebar tree" : "Expand sidebar tree",
        );
      });
    }
  </script>
</BaseLayout>

<style>
  /* Sidebar collapse (« at the sidebar bottom / » at the layout's
     left edge): the script toggles
     `.porto-doc-layout--sidebar-collapsed` on the layout, hiding the
     sidebar and showing the expand button. A JS-toggled ancestor
     class — plain CSS, not a utility (the unlayered rules beat the
     layered `hidden` utility on the expand button). Below the 996px
     breakpoint the sidebar is gone anyway, so the expand button
     stays hidden even while collapsed. */
  .porto-doc-layout--sidebar-collapsed .porto-doc-sidebar {
    display: none;
  }

  .porto-doc-layout--sidebar-collapsed .porto-doc-sidebar__expand {
    display: flex;
  }

  @media (max-width: 996px) {
    .porto-doc-layout--sidebar-collapsed .porto-doc-sidebar__expand {
      display: none;
    }
  }
</style>
