---
// DocLayout — docs/notes page shell on top of BaseLayout (port of the
// old swizzled `DocItem/Layout`).
//
// Left sidebar (from `porto:sidebar`), main column with breadcrumbs,
// the page content (<slot /> — the <h1> title is rendered by the page
// itself), a minimal mobile TOC disclosure (<details>; the full
// MobileTOC component is Phase 4), desktop TOC aside, prev/next
// paginator, and the doc footer (Edit link + last updated).
//
// PageActions (edit ✎ + copy-link ⧉ buttons, top-right) are inline
// here; the old copy-markdown dropdown is Phase 4.
//
// Version banner/badge: DROPPED — versioning is unused.
import config from "porto:config";
import sidebar from "porto:sidebar";
import BaseLayout from "./BaseLayout.astro";
import Sidebar from "../components/Sidebar.astro";
import TOC from "../components/TOC.astro";
import { findSidebarPath, findPrevNext } from "../lib/content.mjs";

interface Props {
  title: string;
  description?: string;
  currentHref: string;
  headings?: { depth: number; slug: string; text: string }[];
  editUrl?: string;
  lastUpdated?: string;
}

const {
  title,
  description,
  currentHref,
  headings = [],
  editUrl,
  lastUpdated,
} = Astro.props;

const breadcrumbs = config.theme.breadcrumbs
  ? findSidebarPath(sidebar, currentHref)
  : [];
const { prev, next } = findPrevNext(sidebar, currentHref);
const tocHeadings = headings.filter(
  (heading) => heading.depth >= 2 && heading.depth <= 3,
);
---

<BaseLayout title={title} description={description}>
  <div class="porto-doc-layout">
    {/*
      Expand button (»): only visible while the sidebar is collapsed
      (see the toggle script below); re-opens the sidebar.
    */}
    <button
      type="button"
      class="porto-doc-sidebar__expand"
      data-sidebar-expand
      aria-label="Expand sidebar"
    >
      »
    </button>
    <aside class="porto-doc-sidebar">
      <nav class="porto-doc-sidebar__nav" aria-label="Docs sidebar">
        <Sidebar currentHref={currentHref} />
      </nav>
    </aside>

    <div class="porto-doc-main">
      {/*
        PageActions: edit + copy-link icon buttons at the top-right of
        the doc page (above the TOC area on desktop).
      */}
      <div class="porto-page-actions">
        {editUrl && (
          <a
            class="porto-page-actions__button"
            href={editUrl}
            title="Edit this page"
            aria-label="Edit this page"
          >
            ✎
          </a>
        )}
        <button
          type="button"
          class="porto-page-actions__button"
          data-copy-page-url
          title="Copy link"
          aria-label="Copy link"
        >
          ⧉
        </button>
      </div>

      <article class="porto-doc-article">
        {breadcrumbs.length > 0 && (
          <nav class="porto-breadcrumbs" aria-label="Breadcrumbs">
            <ol>
              <li class="porto-breadcrumbs__item">
                <a href="/" aria-label="Home">
                  ⌂
                </a>
              </li>
              {breadcrumbs.map((crumb, index) => {
                const isLast = index === breadcrumbs.length - 1;
                // Categories without an index doc have href: null
                // (see findSidebarPath) — plain text, not a link.
                return (
                  <li class="porto-breadcrumbs__item">
                    {isLast || !crumb.href ? (
                      <span aria-current={isLast ? "page" : undefined}>
                        {crumb.title}
                      </span>
                    ) : (
                      <a href={crumb.href}>{crumb.title}</a>
                    )}
                  </li>
                );
              })}
            </ol>
          </nav>
        )}

        {/*
          Mobile toolbar: sticky under the navbar on small screens; the
          client script below keeps it glued to the navbar bottom while
          the navbar hides/shows (port of the old MobileToolbar
          requestAnimationFrame positioning).
        */}
        {tocHeadings.length > 0 && (
          <div
            class="porto-mobile-toolbar"
            data-mobile-toolbar
            style="--mobile-toolbar-top: 0px"
          >
            <details class="porto-mobile-toc">
              <summary>On this page</summary>
              <TOC headings={tocHeadings} spy={false} />
            </details>
          </div>
        )}

        <div class="porto-markdown">
          <slot />
        </div>

        {(editUrl || lastUpdated) && (
          <footer class="porto-doc-footer">
            <span>{editUrl && <a href={editUrl}>Edit this page</a>}</span>
            <span>
              {lastUpdated && <span>Last updated on {lastUpdated}</span>}
            </span>
          </footer>
        )}
      </article>

      {(prev || next) && (
        <nav class="porto-pagination" aria-label="Docs pages">
          {prev && (
            <a
              class="porto-pagination__link porto-pagination__link--prev"
              href={prev.href}
            >
              <span class="porto-pagination__sublabel">Previous</span>
              <span class="porto-pagination__label">{prev.title}</span>
            </a>
          )}
          {next && (
            <a
              class="porto-pagination__link porto-pagination__link--next"
              href={next.href}
            >
              <span class="porto-pagination__sublabel">Next</span>
              <span class="porto-pagination__label">{next.title}</span>
            </a>
          )}
        </nav>
      )}
    </div>

    {tocHeadings.length > 0 && (
      <aside class="porto-doc-toc">
        <TOC headings={tocHeadings} />
      </aside>
    )}
  </div>

  <script>
    // Port of the old MobileToolbar effect: keep the sticky mobile
    // toolbar glued to the navbar's bottom edge while the navbar
    // hides/shows on scroll, and publish the scroll offset headings
    // need so anchor jumps don't land under the toolbar.
    const toolbar = document.querySelector("[data-mobile-toolbar]");
    const navbar = document.querySelector(".porto-navbar");
    if (toolbar instanceof HTMLElement && navbar instanceof HTMLElement) {
      let animationFrame = 0;
      const updateTop = () => {
        const navbarBottom = Math.max(0, navbar.getBoundingClientRect().bottom);
        const navbarReservedHeight = Math.max(
          navbarBottom,
          navbar.offsetHeight,
        );
        toolbar.style.setProperty("--mobile-toolbar-top", `${navbarBottom}px`);
        document.documentElement.style.setProperty(
          "--mobile-doc-scroll-offset",
          `${navbarReservedHeight + toolbar.offsetHeight + 8}px`,
        );
      };

      const stopFollowingNavbar = () => {
        if (animationFrame) {
          window.cancelAnimationFrame(animationFrame);
          animationFrame = 0;
        }
        updateTop();
      };

      const followNavbar = (event) => {
        if (event.propertyName !== "transform") {
          return;
        }
        if (animationFrame) {
          window.cancelAnimationFrame(animationFrame);
        }
        const follow = () => {
          updateTop();
          animationFrame = window.requestAnimationFrame(follow);
        };
        follow();
      };

      const observer = new MutationObserver(() => {
        window.requestAnimationFrame(updateTop);
      });
      observer.observe(navbar, {
        attributes: true,
        attributeFilter: ["class"],
      });
      navbar.addEventListener("transitionrun", followNavbar);
      navbar.addEventListener("transitionend", stopFollowingNavbar);
      navbar.addEventListener("transitioncancel", stopFollowingNavbar);
      window.addEventListener("resize", updateTop);
      updateTop();
    }
  </script>

  <script>
    // PageActions copy button: copies the page URL and shows a brief
    // "Copied" state (title/aria-label + data-copied styling).
    const copyButton = document.querySelector("[data-copy-page-url]");
    if (copyButton instanceof HTMLButtonElement) {
      copyButton.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(window.location.href);
        } catch {
          // Clipboard API unavailable (non-secure context) — fall back
          // to a hidden textarea + execCommand.
          const textarea = document.createElement("textarea");
          textarea.value = window.location.href;
          document.body.appendChild(textarea);
          textarea.select();
          document.execCommand("copy");
          textarea.remove();
        }
        copyButton.setAttribute("data-copied", "true");
        copyButton.setAttribute("title", "Copied!");
        copyButton.setAttribute("aria-label", "Copied!");
        window.setTimeout(() => {
          copyButton.removeAttribute("data-copied");
          copyButton.setAttribute("title", "Copy link");
          copyButton.setAttribute("aria-label", "Copy link");
        }, 1500);
      });
    }

    // Sidebar collapse (« at the sidebar bottom) / expand (» at the
    // layout's left edge): toggling a class on the layout hides the
    // sidebar and lets the content column expand.
    const layout = document.querySelector(".porto-doc-layout");
    const collapseButton = document.querySelector("[data-sidebar-collapse]");
    const expandButton = document.querySelector("[data-sidebar-expand]");
    if (layout && collapseButton && expandButton) {
      collapseButton.addEventListener("click", () => {
        layout.classList.add("porto-doc-layout--sidebar-collapsed");
      });
      expandButton.addEventListener("click", () => {
        layout.classList.remove("porto-doc-layout--sidebar-collapsed");
      });
    }

    // Sidebar root header chevron: collapses/expands the whole tree
    // (the CSS hides every root-list item but the header row).
    const rootToggle = document.querySelector("[data-sidebar-root-toggle]");
    const sidebarList = document.querySelector(".porto-sidebar");
    if (rootToggle instanceof HTMLButtonElement && sidebarList) {
      rootToggle.addEventListener("click", () => {
        const collapsed =
          sidebarList.getAttribute("data-root-collapsed") === "true";
        sidebarList.setAttribute("data-root-collapsed", String(!collapsed));
        rootToggle.setAttribute("aria-expanded", String(collapsed));
        rootToggle.textContent = collapsed ? "⌄" : "›";
        rootToggle.setAttribute(
          "aria-label",
          collapsed ? "Collapse sidebar tree" : "Expand sidebar tree",
        );
      });
    }
  </script>
</BaseLayout>

<style>
  .porto-doc-layout {
    display: flex;
    align-items: flex-start;
    gap: 2rem;
    max-width: 80rem;
    width: 100%;
    margin: 0 auto;
    padding: 1rem;
  }

  .porto-doc-sidebar {
    flex-shrink: 0;
    width: 300px;
    position: sticky;
    top: calc(var(--porto-navbar-height, 60px) + 1rem);
    /* Full-height column: the list scrolls inside it and the « collapse
       button stays pinned to the bottom (see Sidebar.astro). */
    height: calc(100vh - var(--porto-navbar-height, 60px) - 2rem);
  }

  .porto-doc-sidebar__nav {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  /* Expand button (»): hidden unless the sidebar is collapsed. */
  .porto-doc-sidebar__expand {
    display: none;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    align-self: flex-start;
    position: sticky;
    top: calc(var(--porto-navbar-height, 60px) + 1rem);
    width: 2rem;
    height: 2rem;
    padding: 0;
    color: var(--porto-text-muted);
    background: var(--porto-bg-alt, var(--porto-bg));
    border: 1px solid var(--porto-border);
    border-radius: 0.375rem;
    font-size: 1.1rem;
    line-height: 1;
    cursor: pointer;
  }

  .porto-doc-sidebar__expand:hover {
    color: var(--porto-primary);
    border-color: var(--porto-primary);
  }

  .porto-doc-layout--sidebar-collapsed .porto-doc-sidebar {
    display: none;
  }

  .porto-doc-layout--sidebar-collapsed .porto-doc-sidebar__expand {
    display: flex;
  }

  .porto-doc-main {
    flex: 1 1 auto;
    display: flex;
    flex-direction: column;
    min-width: 0;
    position: relative;
    /* Container-query context for the pagination below (port of the old
       pagination.css `docContainer`): the content column is ~660px wide
       at desktop widths, so the container query — not a viewport media
       query — is what stacks the prev/next cards. */
    container-type: inline-size;
    container-name: docContainer;
  }

  .porto-doc-article {
    display: flex;
    flex-direction: column;
    flex: 1 0 auto;
  }

  .porto-doc-toc {
    flex-shrink: 0;
    width: 220px;
    position: sticky;
    top: calc(var(--porto-navbar-height, 60px) + 1rem);
    max-height: calc(100vh - var(--porto-navbar-height, 60px) - 2rem);
    overflow-y: auto;
  }

  /* PageActions: edit ✎ + copy-link ⧉ buttons, top-right of the doc
     page, on the breadcrumbs row. */
  .porto-page-actions {
    position: absolute;
    top: 0;
    right: 0;
    z-index: 1;
    display: flex;
    gap: 0.5rem;
  }

  .porto-page-actions__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    padding: 0;
    color: var(--porto-text);
    text-decoration: none;
    background: var(--porto-bg-alt, var(--porto-bg));
    border: 1px solid var(--porto-border);
    border-radius: 0.375rem;
    font-size: 1rem;
    line-height: 1;
    cursor: pointer;
  }

  .porto-page-actions__button:hover {
    color: var(--porto-primary);
    border-color: var(--porto-primary);
  }

  .porto-page-actions__button[data-copied="true"] {
    color: var(--porto-primary);
    border-color: var(--porto-primary);
  }

  .porto-breadcrumbs ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem;
    margin: 0 0 1rem;
    padding: 0;
    padding-right: 5rem;
    list-style: none;
    font-size: 0.85rem;
  }

  .porto-breadcrumbs__item + .porto-breadcrumbs__item::before {
    content: "›";
    margin-right: 0.25rem;
    color: var(--porto-text-muted);
  }

  .porto-breadcrumbs a {
    color: var(--porto-primary);
    text-decoration: none;
  }

  .porto-breadcrumbs a:hover {
    text-decoration: underline;
  }

  .porto-breadcrumbs [aria-current="page"] {
    color: var(--porto-primary);
  }

  .porto-mobile-toolbar {
    display: none;
  }

  .porto-mobile-toc summary {
    cursor: pointer;
    font-weight: 600;
  }

  .porto-doc-footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem;
    margin-top: auto;
    padding-top: 2rem;
    color: var(--porto-text-muted);
    font-size: 0.9rem;
  }

  .porto-doc-footer a {
    color: var(--porto-primary);
    text-decoration: none;
  }

  .porto-pagination {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: auto;
    padding-top: 2.9rem;
  }

  article:has(.porto-doc-footer) + .porto-pagination {
    padding-top: 1.5rem;
  }

  .porto-pagination__link {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 1rem;
    color: var(--porto-text);
    text-decoration: none;
    background: var(--porto-bg-alt, var(--porto-bg));
    border: 1px solid var(--porto-border);
    border-radius: 0.5rem;
  }

  .porto-pagination__link:hover {
    border-color: var(--porto-primary);
  }

  .porto-pagination__link--next {
    grid-column: 2;
    text-align: right;
  }

  .porto-pagination__sublabel {
    color: var(--porto-text-muted);
    font-size: 0.85rem;
  }

  .porto-pagination__label {
    display: flex;
    align-items: center;
    font-size: 1.1rem;
    /* The old link inherits the anchor/primary color — golden labels
       are green. */
    color: var(--porto-primary);
  }

  .porto-pagination__link--prev .porto-pagination__label {
    justify-content: flex-start;
    text-align: left;
  }

  .porto-pagination__link--next .porto-pagination__label {
    justify-content: flex-end;
    text-align: right;
  }

  /* Stack prev/next cards full-width when the content column is narrow
     (port of the old `@container docContainer (max-width: 768px)` rule
     — the column is ~660px wide even at desktop viewports). */
  @container docContainer (max-width: 768px) {
    .porto-pagination {
      grid-template-columns: 1fr;
      gap: 0.15rem;
    }

    .porto-pagination__link--prev {
      text-align: left;
    }

    .porto-pagination__link--next {
      grid-column: 1;
      text-align: right;
    }
  }

  @media (max-width: 996px) {
    .porto-doc-sidebar,
    .porto-doc-toc {
      display: none;
    }

    .porto-doc-layout--sidebar-collapsed .porto-doc-sidebar__expand {
      display: none;
    }

    .porto-mobile-toolbar {
      position: sticky;
      top: var(--mobile-toolbar-top, 0px);
      z-index: 100;
      display: flex;
      align-items: center;
      padding: 0.35rem 0 1rem;
      background: var(--porto-bg);
    }

    .porto-pagination {
      grid-template-columns: 1fr;
      gap: 0.15rem;
    }

    .porto-pagination__link--prev {
      text-align: left;
    }

    .porto-pagination__link--next {
      grid-column: 1;
      text-align: right;
    }
  }
</style>
