---
// Navbar — built from the resolved config (replaces theme-classic's
// Navbar). Port of the navbar items the old Docusaurus config assembled
// in `themeConfig.navbar.items`:
//
//   - brand: site title + generated favicon logo
//   - search button (opens the Pagefind search modal), theme toggle,
//     then nav links — the old navbar.css reordered the right side
//     into exactly this order (search, toggle, links). The search
//     button only renders on pages under the notes/docs or blog route
//     (the old search plugin's `searchContextByPaths` +
//     `hideSearchBarWithNoSearchContext`); on mobile it collapses to
//     a magnifier icon button, the hamburger moves to the left of the
//     brand, and the theme toggle lives inside the slide-down menu
//     instead of the bar.
//   - Docs (docs mode) / About Me, Projects, Experience, Contact
//     anchors (portfolio mode, when each section is enabled)
//   - custom `theme.navigation.navbar_items` (links + dropdowns)
//   - "More" dropdown: Notes (portfolio mode), Blog, Tasks (when
//     enabled), Portosaur version link (unless disabled)
//   - mobile-only Portosaur version link at the bottom of the menu
//
// Dropdowns are vanilla <details> (keyboard accessible via <summary>).
// Hide-on-scroll and the mobile slide-down menu are vanilla scripts.
import config from "porto:config";
import Search from "./Search.astro";

interface Props {
  /** True on the portfolio home page — removes the navbar shadow and
   * hides the brand in landscape (ported from old `pages/index.jsx`). */
  isHome?: boolean;
}

const { isHome = false } = Astro.props;

const site = config.site;
const theme = config.theme;
const siteMode = config.siteMode;
const homePage = config.homePage ?? {};
const tasks = config.tasks ?? {};

// The Portosaur project's own homepage (the old config read it from the
// cli package's `homepage` field; it isn't part of PortosaurOptions).
const PORTO_HOMEPAGE = "https://soymadip.github.io/portosaur";

const base = site.baseUrl ?? "/";
const basePrefix = base === "/" ? "" : base.replace(/\/+$/, "");
const withBase = (path: string) =>
  `${basePrefix}${path.startsWith("/") ? path : `/${path}`}`;

const pathname = Astro.url.pathname;
const normalizedPath = pathname.replace(/\/+$/, "") || "/";

// Search visibility — port of the old `@easyops-cn/docusaurus-search-local`
// setup (`searchContextByPaths: [notesRoute, blogRoute]` with
// `hideSearchBarWithNoSearchContext: true`): the search button only shows on
// pages under the notes/docs route or the blog route, and is hidden on
// home, /tasks, /offline, /search, 404, and (in docs mode, where the
// notes route is "docs") the /notes NoteCards page. The plugin matches
// `uri === path || uri.startsWith(path + "/")` where uri is the pathname
// minus the base URL.
const uri = (
  pathname.startsWith(basePrefix) ? pathname.slice(basePrefix.length) : pathname
).replace(/^\/+/, "");
const inSearchContext = (route: string) =>
  uri === route || uri.startsWith(`${route}/`);
const showSearch =
  inSearchContext(site.notesRoute) || inSearchContext(site.blogRoute);

function isActivePath(href: string): boolean {
  const normalized = href.replace(/\/+$/, "") || "/";
  if (normalized === "/") {
    return normalizedPath === "/";
  }
  return (
    normalizedPath === normalized || normalizedPath.startsWith(`${normalized}/`)
  );
}

interface NavLink {
  label: string;
  href: string;
  active?: boolean;
  external?: boolean;
}

interface NavDropdown {
  label: string;
  items: NavLink[];
  className?: string;
}

type NavEntry = NavLink | NavDropdown;

function isDropdown(entry: NavEntry): entry is NavDropdown {
  return (entry as NavDropdown).items !== undefined;
}

// Anchor items never show active (the old config gave them
// `activeBasePath: "/never-match"`).
const leftEntries: NavEntry[] = [];
const rightEntries: NavEntry[] = [];

if (siteMode === "docs") {
  rightEntries.push({
    label: "Docs",
    href: withBase(`/${site.notesRoute}`),
    active: isActivePath(`/${site.notesRoute}`),
  });
} else {
  if (homePage.aboutSection?.enable) {
    rightEntries.push({ label: "About Me", href: withBase("/#about") });
  }
  if (homePage.projectShelf?.enable) {
    rightEntries.push({ label: "Projects", href: withBase("/#projects") });
  }
  if (homePage.experienceSection?.enable) {
    rightEntries.push({
      label: "Experience",
      href: withBase("/#experience"),
    });
  }
  if (homePage.socialSection?.enable) {
    rightEntries.push({ label: "Contact", href: withBase("/#contact") });
  }
}

// Custom navbar items: `{ label, to?, href?, position?, items? }`.
// `items` (an array of `{ label, to?, href? }`) renders a dropdown.
for (const item of theme.navbarItems ?? []) {
  const target = item.position === "left" ? leftEntries : rightEntries;
  const toLink = (entry: any): NavLink => ({
    label: entry.label,
    href: entry.to ? withBase(entry.to) : (entry.href ?? "#"),
    active: entry.to ? isActivePath(entry.to) : false,
    external: !entry.to && /^https?:\/\//.test(entry.href ?? ""),
  });
  if (Array.isArray(item.items) && item.items.length > 0) {
    target.push({
      label: item.label,
      items: item.items.map(toLink),
    });
  } else {
    target.push(toLink(item));
  }
}

const showProjectLink = !theme.disableProjectLink;
const versionLabel = `Portosaur v${config.portoVersion}`;

const moreItems: NavLink[] = [];
if (siteMode !== "docs") {
  moreItems.push({
    label: "Notes",
    href: withBase(`/${site.notesRoute}`),
    active: isActivePath(`/${site.notesRoute}`),
  });
}
moreItems.push({
  label: "Blog",
  href: withBase(`/${site.blogRoute}`),
  active: isActivePath(`/${site.blogRoute}`),
});
if (tasks.enable) {
  moreItems.push({
    label: "Tasks",
    href: withBase("/tasks"),
    active: isActivePath("/tasks"),
  });
}
if (showProjectLink) {
  moreItems.push({
    label: versionLabel,
    href: PORTO_HOMEPAGE,
    external: true,
  });
}

const moreDropdown: NavDropdown = {
  label: "More",
  items: moreItems,
  // Divider between the nav links and the "More" dropdown.
  className: "-ml-[7px] border-l-[1.5px] border-l-border pl-2",
};

const hideOnScroll = theme.hideNavbarOnScroll;

// Shared Tailwind class sets — the link styles repeat across the
// desktop navs, the dropdown menus, and the mobile menu. The color is
// a per-link ternary (never a base color plus an overriding active
// color) so the two never fight in the generated stylesheet.
const navLink =
  "cursor-pointer list-none rounded-md px-3 py-2 text-[0.95rem] no-underline hover:text-primary";
const navSummary =
  "cursor-pointer list-none rounded-md px-3 py-2 text-[0.95rem] text-foreground no-underline hover:text-primary after:ml-1 after:text-[0.75em] after:content-['▾'] [&::-webkit-details-marker]:hidden";
const navLinkColor = (active: boolean | undefined) =>
  active ? "font-semibold text-primary" : "text-foreground";
const dropdownMenu =
  "absolute top-[calc(100%+0.5rem)] right-0 z-[101] m-0 min-w-48 list-none rounded-lg border border-border bg-background py-2 shadow-[0_8px_24px_0_rgb(0_0_0/0.15)]";
const dropdownLink =
  "block px-4 py-2 text-[0.95rem] no-underline hover:bg-surface hover:text-primary";
---

<header
  class:list={[
    "sticky top-0 z-100 h-(--navbar-height) bg-background transition-transform duration-200 ease-[ease]",
    isHome
      ? "border-b-0 shadow-none"
      : "border-b border-b-border shadow-(--navbar-shadow)",
  ]}
  data-navbar
  data-hide-on-scroll={hideOnScroll || undefined}
>
  <div class="flex min-h-[60px] items-center gap-4 px-4">
    <button
      type="button"
      class="hidden cursor-pointer rounded-md border-0 bg-transparent p-2 text-foreground [@media(max-width:996px)]:flex"
      data-navbar-toggle
      aria-expanded="false"
      aria-controls="porto-mobile-menu"
      aria-label="Toggle navigation menu"
    >
      <svg
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <line x1="4" x2="20" y1="6" y2="6"></line>
        <line x1="4" x2="20" y1="12" y2="12"></line>
        <line x1="4" x2="20" y1="18" y2="18"></line>
      </svg>
    </button>

    <a
      class:list={[
        "flex items-center gap-2 font-bold whitespace-nowrap text-foreground no-underline",
        // Home page (portfolio mode): brand hidden in landscape —
        // ported from the old pages/index.jsx inline style.
        { "landscape:hidden": isHome },
      ]}
      href={withBase("/")}
    >
      <img
        class="size-8 object-contain"
        src={withBase("/favicon/favicon.ico")}
        alt={`${site.title} logo`}
      />
      <span>{site.title}</span>
    </a>

    {leftEntries.length > 0 && (
      <nav
        class="flex items-center gap-1 [@media(max-width:996px)]:hidden"
        aria-label="Primary"
      >
        {leftEntries.map((entry) =>
          isDropdown(entry) ? (
            <details class="porto-navbar__dropdown relative">
              <summary class={navSummary}>{entry.label}</summary>
              <ul class={dropdownMenu}>
                {entry.items.map((item) => (
                  <li>
                    <a
                      class:list={[dropdownLink, navLinkColor(item.active)]}
                      href={item.href}
                      target={item.external ? "_blank" : undefined}
                      rel={item.external ? "noopener noreferrer" : undefined}
                    >
                      {item.label}
                    </a>
                  </li>
                ))}
              </ul>
            </details>
          ) : (
            <a
              class:list={[navLink, navLinkColor(entry.active)]}
              href={entry.href}
              target={entry.external ? "_blank" : undefined}
              rel={entry.external ? "noopener noreferrer" : undefined}
            >
              {entry.label}
            </a>
          ),
        )}
      </nav>
    )}

    <div class="ml-auto flex items-center gap-2">
      {showSearch && <Search />}

      {theme.showThemeSwitch && (
        <button
          type="button"
          class="flex items-center rounded-full border-0 bg-transparent p-2 text-foreground hover:bg-surface [@media(max-width:996px)]:hidden"
          data-theme-toggle
          aria-label="Toggle dark mode"
          title="Toggle dark mode"
        >
          <svg
            class="hidden dark:inline"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z" />
          </svg>
          <svg
            class="inline dark:hidden"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <circle cx="12" cy="12" r="4" />
            <path d="M12 2v2" />
            <path d="M12 20v2" />
            <path d="m4.93 4.93 1.41 1.41" />
            <path d="m17.66 17.66 1.41 1.41" />
            <path d="M2 12h2" />
            <path d="M20 12h2" />
            <path d="m6.34 17.66-1.41 1.41" />
            <path d="m19.07 4.93-1.41 1.41" />
          </svg>
        </button>
      )}

      <nav
        class="flex items-center gap-1 [@media(max-width:996px)]:hidden"
        aria-label="Primary"
      >
        {rightEntries.map((entry) =>
          isDropdown(entry) ? (
            <details class="porto-navbar__dropdown relative">
              <summary class={navSummary}>{entry.label}</summary>
              <ul class={dropdownMenu}>
                {entry.items.map((item) => (
                  <li>
                    <a
                      class:list={[dropdownLink, navLinkColor(item.active)]}
                      href={item.href}
                      target={item.external ? "_blank" : undefined}
                      rel={item.external ? "noopener noreferrer" : undefined}
                    >
                      {item.label}
                    </a>
                  </li>
                ))}
              </ul>
            </details>
          ) : (
            <a
              class:list={[navLink, navLinkColor(entry.active)]}
              href={entry.href}
              target={entry.external ? "_blank" : undefined}
              rel={entry.external ? "noopener noreferrer" : undefined}
            >
              {entry.label}
            </a>
          ),
        )}
        <details
          class:list={[
            "porto-navbar__dropdown relative",
            moreDropdown.className,
          ]}
        >
          <summary class={navSummary}>{moreDropdown.label}</summary>
          <ul class={dropdownMenu}>
            {moreDropdown.items.map((item) => (
              <li>
                <a
                  class:list={[dropdownLink, navLinkColor(item.active)]}
                  href={item.href}
                  target={item.external ? "_blank" : undefined}
                  rel={item.external ? "noopener noreferrer" : undefined}
                >
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </details>
      </nav>
    </div>
  </div>

  {/*
    The header has a fixed height, so the open menu overflows it and
    overlays the page — like the old sidebar. It needs its own opaque
    background or the page shows through between the items.
  */}
  <div
    class="border-t border-t-border bg-background px-4 pt-2 pb-4"
    id="porto-mobile-menu"
    data-mobile-menu
    hidden
  >
    <nav aria-label="Mobile">
      {[...leftEntries, ...rightEntries].map((entry) =>
        isDropdown(entry) ? (
          <details class="porto-navbar__dropdown relative block">
            <summary class:list={[navSummary, "block"]}>{entry.label}</summary>
            <ul class="static m-0 list-none border-0 bg-background py-0 pl-4 shadow-none">
              {entry.items.map((item) => (
                <li>
                  <a
                    class:list={[dropdownLink, navLinkColor(item.active)]}
                    href={item.href}
                    target={item.external ? "_blank" : undefined}
                    rel={item.external ? "noopener noreferrer" : undefined}
                  >
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          </details>
        ) : (
          <a
            class:list={[navLink, "block", navLinkColor(entry.active)]}
            href={entry.href}
            target={entry.external ? "_blank" : undefined}
            rel={entry.external ? "noopener noreferrer" : undefined}
          >
            {entry.label}
          </a>
        ),
      )}
      <details class="porto-navbar__dropdown relative block">
        <summary class:list={[navSummary, "block"]}>
          {moreDropdown.label}
        </summary>
        <ul class="static m-0 list-none border-0 bg-background py-0 pl-4 shadow-none">
          {moreDropdown.items.map((item) => (
            <li>
              <a
                class:list={[dropdownLink, navLinkColor(item.active)]}
                href={item.href}
                target={item.external ? "_blank" : undefined}
                rel={item.external ? "noopener noreferrer" : undefined}
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </details>
    </nav>
    {theme.showThemeSwitch && (
      <button
        type="button"
        class="mt-2 flex w-full cursor-pointer items-center justify-start gap-2 rounded-md border-0 bg-transparent px-3 py-2 text-[0.95rem] text-foreground hover:bg-surface hover:text-primary"
        data-theme-toggle
        aria-label="Toggle dark mode"
        title="Toggle dark mode"
      >
        <svg
          class="hidden dark:inline"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z" />
        </svg>
        <svg
          class="inline dark:hidden"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2" />
          <path d="M12 20v2" />
          <path d="m4.93 4.93 1.41 1.41" />
          <path d="m17.66 17.66 1.41 1.41" />
          <path d="M2 12h2" />
          <path d="M20 12h2" />
          <path d="m6.34 17.66-1.41 1.41" />
          <path d="m19.07 4.93-1.41 1.41" />
        </svg>
        <span>Theme</span>
      </button>
    )}
    {showProjectLink && (
      <a
        class="mt-3 block border-t-[1.2px] border-t-background pt-3 text-center text-muted no-underline opacity-[0.64]"
        href={PORTO_HOMEPAGE}
        target="_blank"
        rel="noopener noreferrer"
      >
        {versionLabel}
      </a>
    )}
  </div>
</header>

<script>
  const navbar = document.querySelector("[data-navbar]");
  const toggle = document.querySelector("[data-navbar-toggle]");
  const mobileMenu = document.querySelector("[data-mobile-menu]");

  // Mobile slide-down menu.
  if (toggle && mobileMenu instanceof HTMLElement) {
    const closeMenu = () => {
      mobileMenu.hidden = true;
      toggle.setAttribute("aria-expanded", "false");
    };
    toggle.addEventListener("click", () => {
      const willOpen = mobileMenu.hidden;
      mobileMenu.hidden = !willOpen;
      toggle.setAttribute("aria-expanded", String(willOpen));
    });
    mobileMenu.addEventListener("click", (event) => {
      if (event.target instanceof HTMLAnchorElement) {
        closeMenu();
      }
    });
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && !mobileMenu.hidden) {
        closeMenu();
      }
    });
  }

  // Close open dropdowns on outside click / Escape (<details> doesn't
  // close itself). The toggle click itself lands inside the <details>,
  // so it isn't treated as outside.
  const closeDropdowns = () => {
    document
      .querySelectorAll("details.porto-navbar__dropdown[open]")
      .forEach((dropdown) => {
        dropdown.removeAttribute("open");
      });
  };
  document.addEventListener("click", (event) => {
    if (
      event.target instanceof Node &&
      !event.target.parentElement?.closest("details.porto-navbar__dropdown")
    ) {
      closeDropdowns();
    }
  });
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") {
      closeDropdowns();
    }
  });

  // Hide-on-scroll: slide the navbar away while scrolling down, bring
  // it back on scroll up (or at the top of the page). The transform
  // transition is what DocLayout's mobile toolbar follows.
  if (
    navbar instanceof HTMLElement &&
    navbar.hasAttribute("data-hide-on-scroll")
  ) {
    let lastScrollY = window.scrollY;
    let ticking = false;
    const update = () => {
      const y = window.scrollY;
      if (y > navbar.offsetHeight && y > lastScrollY) {
        navbar.classList.add("porto-navbar--hidden");
      } else {
        navbar.classList.remove("porto-navbar--hidden");
      }
      lastScrollY = y;
      ticking = false;
    };
    window.addEventListener(
      "scroll",
      () => {
        if (!ticking) {
          window.requestAnimationFrame(update);
          ticking = true;
        }
      },
      { passive: true },
    );
  }
</script>

<style>
  /* Hide-on-scroll: the script toggles `.porto-navbar--hidden` on the
     header via `classList` while scrolling down, so the rule stays
     plain CSS (utilities can't express a JS-toggled class). */
  .porto-navbar--hidden {
    transform: translateY(-100%);
  }
</style>
