---
// TopicList — explicit `<TopicList />` in MDX content.
//
// Renders the current sidebar category's child items as h2 cards (the
// Docusaurus `TopicCard` titles), at the position where the tag appears
// in the content. The automatic list (rendered after the content on
// index pages) is the doc route's job, not this component's.
//
// Gating mirrors the Docusaurus component: the frontmatter `topic_list`
// rule decides, and a manual list on a non-index page needs `forceRender`.
// The current page is read from `Astro.params.slug` (the doc route's
// `[...slug]` param) — the component is request-scoped, so this is the
// page being rendered.
import { getCollection } from "astro:content";
import config from "porto:config";
import sidebar from "porto:sidebar";
import {
  findCategoryItems,
  topicCardTitle,
  topicListShouldRender,
  withSlugs,
} from "../../lib/content.mjs";

const { forceRender = false, items: propItems } = Astro.props;

const slug = Astro.params.slug ?? "";
const notesRoute = config.site.notesRoute;
const href = slug ? `/${notesRoute}/${slug}` : `/${notesRoute}`;

let items = propItems;
let shouldRender = Boolean(forceRender);

if (!items) {
  const notes = await getCollection("notes");
  const resolved = withSlugs(notes);
  const current = resolved.find((item) => item.slug === slug);
  shouldRender =
    forceRender ||
    (current ? topicListShouldRender(current.entry, config) : false);
  items = shouldRender ? findCategoryItems(sidebar, href) : [];
}

const cards = (items ?? []).map((item) => ({
  title: topicCardTitle({
    label: item.label ?? item.title ?? "",
    icon: item.icon,
  }),
  href: item.href ?? item.link?.href ?? "#",
}));
---

{shouldRender && cards.length > 0 && (
  <section class="topic-list">
    {cards.map((card) => (
      <h2>
        <a href={card.href}>{card.title}</a>
      </h2>
    ))}
  </section>
)}
