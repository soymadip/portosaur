---
// DocsHomeSection — ported from the old components/DocsHomeSection/index.jsx.
//
// Docs landing: icon/title/tagline/desc, action buttons, feature cards
// (with optional links). Reads config directly from `porto:config`.
//
// The old component preloaded the hero icon via a <Head> link; head tags
// belong to the layout in the Astro port, so the preload is dropped
// (the image itself still loads eagerly).
import config from "porto:config";
import { renderDynamicIcon, withBase } from "../../lib/icons.mjs";

const docsHome = config.docsHome;

const base = config.site.baseUrl;
const icon = docsHome?.icon;
const iconSrc = icon
  ? withBase(typeof icon === "string" ? icon : icon.src, base)
  : null;
const iconFallback =
  icon && typeof icon === "object" && icon.fallback
    ? withBase(icon.fallback, base)
    : null;
---

{docsHome && (
  <div class="docsHome">
    <header class="heroSection">
      <div class="heroContainer">
        <div class="heroText">
          <h1 class="title">{docsHome.title}</h1>
          {docsHome.tagline && <p class="tagline">{docsHome.tagline}</p>}
          {docsHome.desc && <p class="description">{docsHome.desc}</p>}

          {docsHome.actions && docsHome.actions.length > 0 && (
            <div class="actions">
              {docsHome.actions.map((action, index) => (
                <a
                  href={withBase(action.link, base)}
                  class={`button ${index === 0 ? "buttonBrand" : "buttonAlt"}`}
                >
                  {action.icon && (
                    <span
                      class="actionImg"
                      set:html={renderDynamicIcon(action.icon, { base })}
                    />
                  )}
                  {action.label || action.text}
                </a>
              ))}
            </div>
          )}
        </div>

        {icon && (
          <div class="heroIcon">
            <img
              src={iconSrc}
              alt="Hero"
              loading="eager"
              fetchpriority="high"
              class="icon"
              onerror={
                iconFallback
                  ? `this.onerror=null;this.src='${iconFallback}'`
                  : undefined
              }
            />
          </div>
        )}
      </div>
    </header>

    {docsHome.features && docsHome.features.length > 0 && (
      <section class="featuresSection">
        <div class="featuresContainer">
          {docsHome.features.map((feature, index) => {
            const inner = (
              <>
                {feature.icon && (
                  <div class="featureIcon">
                    <span
                      set:html={renderDynamicIcon(feature.icon, { base })}
                    />
                  </div>
                )}
                <div class="featureContent">
                  <h2 class="featureTitle">{feature.title}</h2>
                  <p class="featureDesc">{feature.details || feature.desc}</p>
                </div>
              </>
            );
            const style = `--animation-order: ${index}`;
            return feature.link ? (
              <a
                href={withBase(feature.link, base)}
                class="featureCard"
                style={style}
              >
                {inner}
              </a>
            ) : (
              <div class="featureCard" style={style}>
                {inner}
              </div>
            );
          })}
        </div>
      </section>
    )}
  </div>
)}

<style>
  .docsHome {
    width: 100%;
    font-family:
      "Alata",
      system-ui,
      -apple-system,
      sans-serif;
    padding-bottom: 0;
  }

  @keyframes slideUpFade {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes floatIn {
    from {
      opacity: 0;
      transform: translateY(10px) scale(0.98);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  .heroSection {
    padding: 3.5rem 2rem 3rem;
    display: flex;
    justify-content: center;
  }

  .heroContainer {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    max-width: 1152px;
    gap: 2rem;
  }

  .heroText {
    flex: 1.2;
    text-align: left;
    max-width: 700px;
  }

  .title {
    font-size: 4.1rem;
    font-weight: 700;
    line-height: 1.05;
    margin-bottom: 0;
    color: var(--porto-primary);
    transition: all 0.3s ease;
    position: relative;
    display: inline-block;
    opacity: 0;
    animation: slideUpFade 0.7s cubic-bezier(0.25, 0.8, 0.25, 1) 0.1s forwards;
  }

  .title:hover {
    transform: translateY(-2px);
  }

  .title::after {
    content: "";
    position: absolute;
    width: 0;
    height: 4px;
    bottom: -2px;
    left: 0;
    background-color: var(--porto-primary);
    transition: width 0.3s ease;
  }

  .title:hover::after {
    width: 100%;
  }

  .tagline {
    font-size: 2.34rem;
    font-weight: 600;
    line-height: 1.2;
    color: var(--porto-text);
    margin-top: 0.5rem;
    margin-bottom: 1rem;
    transition: all 0.3s ease;
    position: relative;
    display: inline-block;
    opacity: 0;
    animation: slideUpFade 0.7s cubic-bezier(0.25, 0.8, 0.25, 1) 0.2s forwards;
  }

  .tagline:hover {
    transform: translateY(-2px);
    color: var(--porto-secondary);
  }

  .description {
    font-size: 1.17rem;
    line-height: 1.4;
    color: var(--porto-gray-600);
    margin-bottom: 1.5rem;
    opacity: 0;
    animation: slideUpFade 0.7s cubic-bezier(0.25, 0.8, 0.25, 1) 0.3s forwards;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    opacity: 0;
    animation: slideUpFade 0.7s cubic-bezier(0.25, 0.8, 0.25, 1) 0.4s forwards;
  }

  .button {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 1.4rem;
    font-size: 1rem;
    font-weight: 600;
    border-radius: 999px;
    text-decoration: none;
    transition:
      background-color 0.2s ease,
      border-color 0.2s ease,
      transform 0.2s ease;
  }

  .button:hover {
    text-decoration: none;
    transform: translateY(-2px);
    box-shadow: 0 5px 40px rgba(0, 0, 0, 0.15);
  }

  .buttonBrand {
    background-color: var(--porto-primary);
    color: #09090b;
  }

  .buttonBrand:hover {
    background-color: var(--porto-primary-light);
    color: #09090b;
  }

  .buttonAlt {
    background-color: var(--porto-gray-300);
    color: var(--porto-text);
  }

  .buttonAlt:hover {
    background-color: var(--porto-gray-400);
    color: var(--porto-text);
  }

  .heroIcon {
    flex: 1;
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  /* Glow behind the hero image */
  .heroIcon::before {
    content: "";
    position: absolute;
    inset: -10%;
    border-radius: 50%;
    background: radial-gradient(
      ellipse at center,
      color-mix(in srgb, var(--porto-primary) 35%, transparent) 0%,
      transparent 70%
    );
    filter: blur(40px);
    z-index: 0;
    opacity: 0;
    animation: floatIn 1s ease 0.4s forwards;
    transition: opacity 0.4s ease;
  }

  .heroIcon:hover::before {
    opacity: 1.3;
  }

  .icon {
    position: relative;
    z-index: 1;
    max-width: 100%;
    height: auto;
    max-height: 280px;
    object-fit: cover;
    border-radius: 20%;
    opacity: 0;
    animation: floatIn 0.9s cubic-bezier(0.25, 0.8, 0.25, 1) 0.5s forwards;
    transition:
      transform 0.4s cubic-bezier(0.25, 0.8, 0.25, 1),
      box-shadow 0.4s cubic-bezier(0.25, 0.8, 0.25, 1);
  }

  .icon:hover {
    transform: translateY(-6px) scale(1.02);
    box-shadow: 0 12px 28px 0 rgba(0, 0, 0, 0.2);
  }

  /* Features Grid */
  .featuresSection {
    padding: 0.7rem;
    padding-bottom: 0.4rem;
    display: flex;
    justify-content: center;
  }

  .featuresContainer {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    grid-auto-rows: minmax(205px, auto);
    gap: 1rem;
    width: 100%;
    max-width: 1152px;
  }

  .featureCard {
    background-color: var(--porto-gray-100);
    border-radius: 12px;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    opacity: 0;
    animation: slideUpFade 0.7s cubic-bezier(0.25, 0.8, 0.25, 1) forwards;
    animation-delay: calc(0.5s + var(--animation-order, 0) * 0.15s);
    transition:
      transform 0.2s ease,
      background-color 0.2s ease;
  }

  a.featureCard,
  a.featureCard:hover {
    color: inherit;
    text-decoration: none;
  }

  a.featureCard:focus-visible {
    outline: 2px solid var(--porto-primary);
    outline-offset: 3px;
  }

  .featureCard:hover {
    background-color: var(--porto-gray-300);
  }

  .featureIcon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    background-color: var(--porto-gray-200);
    border-radius: 8px;
    margin-bottom: 1rem;
    color: var(--porto-primary);
    font-size: 26px;
  }

  .featureIcon svg,
  .featureIcon div svg,
  .featureIcon span svg,
  .featureIcon img {
    width: 24px;
    height: 24px;
  }

  .featureContent {
    width: 100%;
  }

  .featureTitle {
    font-size: 1.2rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
    color: var(--porto-text);
  }

  .featureDesc {
    font-size: 0.95rem;
    color: var(--porto-gray-600);
    margin: 0;
    line-height: 1.5;
  }

  /* Responsive */
  @media (max-width: 996px) {
    .heroContainer {
      flex-direction: column-reverse;
      text-align: center;
    }

    .heroText {
      text-align: center;
      max-width: 100%;
      margin-top: 0;
    }

    .title {
      font-size: 2.7rem;
    }

    .tagline {
      font-size: 1.7rem;
    }

    .description {
      font-size: 1.1rem;
    }

    .actions {
      justify-content: center;
    }

    .heroIcon {
      width: 100%;
      margin-bottom: 0;
    }

    .icon {
      max-height: 180px;
    }

    .featureIcon {
      margin-bottom: 0.5rem;
    }

    .featuresSection {
      padding-bottom: 3.4rem;
    }
  }

  @media (max-width: 480px) {
    .title {
      font-size: 2.6rem;
    }

    .tagline {
      font-size: 1.5rem;
    }

    .description {
      margin-inline: -0.8rem;
    }

    .heroIcon {
      margin-top: 0.8rem;
    }

    .icon {
      max-height: 160px;
    }

    .button {
      flex: 0 0 auto;
      justify-content: center;
      gap: 0.35rem;
      padding: 0.6rem 0.45rem;
      font-size: 0.8rem;
      white-space: nowrap;
    }

    .actionImg {
      flex-shrink: 0;
    }

    .featuresSection {
      padding: 0.25rem 0.7rem 0.8rem;
    }

    .featuresContainer {
      grid-template-columns: minmax(0, 1fr);
      grid-auto-rows: auto;
      gap: 0.5rem;
    }

    .featureCard {
      flex-direction: row;
      align-items: center;
      gap: 0.85rem;
      padding: 0.85rem;
      border: 1px solid var(--porto-gray-200);
      border-radius: 8px;
    }

    .featureCard:hover {
      background-color: var(--porto-gray-100);
    }

    .featureIcon {
      flex: 0 0 2.5rem;
      width: 2.5rem;
      height: 2.5rem;
      margin: 0;
      font-size: 1.35rem;
    }

    .featureIcon svg,
    .featureIcon div svg,
    .featureIcon span svg,
    .featureIcon img {
      width: 1.25rem;
      height: 1.25rem;
    }

    .featureContent {
      flex: 1;
      min-width: 0;
    }

    .featureTitle {
      font-size: 1.05rem;
      line-height: 1.25;
      margin-bottom: 0.25rem;
    }

    .featureDesc {
      font-size: 0.9rem;
      line-height: 1.45;
    }
  }

  @media (max-width: 359px) {
    .actions {
      gap: 0.25rem;
    }

    .button {
      gap: 0.25rem;
      padding: 0.55rem 0.35rem;
      font-size: 0.75rem;
    }
  }
</style>
