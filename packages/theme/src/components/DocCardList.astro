---
// DocCardList — generated-index cards from sidebar category items
// (port of the old wrapper around TopicList).
//
// Items are sidebar nodes: `title`/`label`, `href` (docs) or
// `link.href` (categories), `description`, `icon` (from the index doc's
// frontmatter on categories, the doc's own frontmatter on docs).
// Icons follow the old `getIconTitleProps`: the frontmatter icon, else a
// techMap/devicon guess from the title, else `md:folder` for categories
// and `md:notebook` for docs — rendered as inline SVG via
// `renderDynamicIcon` (emoji icons render as text). The SVG is `1em`,
// sized by the h2's font-size.
import { renderDynamicIcon } from "../lib/icons.mjs";

interface Props {
  items: any[];
}

const { items } = Astro.props;
---

<div class="porto-doc-card-list">
  {items.map((item) => {
    const href = item.href ?? item.link?.href ?? "#";
    const title = item.title ?? item.label ?? "";
    const description = item.description;
    const icon = item.icon;
    // Old TopicList CardCategory prefixes the description with the
    // category item count ("3 items • desc"); plain doc links show
    // the description as-is.
    const isCategory = item.type === "category" && Array.isArray(item.items);
    const itemsCount = isCategory
      ? `${item.items.length} item${item.items.length === 1 ? "" : "s"}`
      : null;
    const iconHtml = renderDynamicIcon(icon, {
      slug: title,
      fallbackIcon: isCategory ? "md:folder" : "md:notebook",
    });
    return (
      <a class="porto-doc-card" href={href}>
        <h2 class="porto-doc-card__title" title={title}>
          <span class="porto-doc-card__icon" set:html={iconHtml} />
          <span class="porto-doc-card__title-text">{title}</span>
        </h2>
        {(itemsCount || description) && (
          <p class="porto-doc-card__desc">
            {itemsCount && <strong>{itemsCount}</strong>}
            {itemsCount && description && (
              <>
                {" "}
                <span style="opacity: 0.5">•</span> {description}
              </>
            )}
            {!itemsCount && description}
          </p>
        )}
      </a>
    );
  })}
</div>

<style>
  /* Old Docusaurus DocCardList uses `col col--6` — two columns, full
     width on small screens. */
  .porto-doc-card-list {
    display: grid;
    /* minmax(0, 1fr): the one-line truncated description is
       `white-space: nowrap`, so its min-content width is the full
       text — without the 0 minimum the tracks refuse to shrink and
       the grid overflows the content column at desktop widths. */
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin: 1.5rem 0;
  }

  @media (max-width: 768px) {
    .porto-doc-card-list {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .porto-doc-card {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    min-width: 0;
    padding: 1.5rem;
    color: var(--porto-text);
    text-decoration: none;
    background: var(--porto-bg-alt, var(--porto-bg));
    border: 1px solid var(--porto-border);
    border-radius: 0.5rem;
  }

  .porto-doc-card:hover {
    border-color: var(--porto-primary);
  }

  .porto-doc-card__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .porto-doc-card__icon:empty {
    display: none;
  }

  /* Old TopicList .cardTitle: 1.4rem, weight 750, topic color (primary by
     default), icon + truncated title inline. */
  .porto-doc-card__title {
    margin: 0 0 1.05rem;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-width: 0;
    width: 100%;
    color: var(--porto-primary);
    font-size: 1.4rem;
    font-weight: 750;
  }

  .porto-doc-card__title-text {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* Old TopicList truncates the description to one line
     (`text--truncate`). */
  .porto-doc-card__desc {
    margin: 0;
    color: var(--porto-text);
    opacity: 0.6;
    font-size: 0.8rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
</style>
