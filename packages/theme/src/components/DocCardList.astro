---
// DocCardList — generated-index cards from sidebar category items
// (port of the old wrapper around TopicList).
//
// Items are sidebar nodes: `title`/`label`, `href` (docs) or
// `link.href` (categories), `description`, `icon` (from the index doc's
// frontmatter on categories, the doc's own frontmatter on docs).
// Icons follow the old `getIconTitleProps`: the frontmatter icon, else a
// techMap/devicon guess from the title, else `md:folder` for categories
// and `md:notebook` for docs — rendered as inline SVG via
// `renderDynamicIcon` (emoji icons render as text). The SVG is `1em`,
// sized by the h2's font-size.
import { renderDynamicIcon } from "../lib/icons.ts";

interface Props {
  items: any[];
}

const { items } = Astro.props;
---

{/*
  Old Docusaurus DocCardList uses `col col--6` — two columns, full
  width on small screens. `minmax(0, 1fr)`: the one-line truncated
  description is `white-space: nowrap`, so its min-content width is
  the full text — without the 0 minimum the tracks refuse to shrink
  and the grid overflows the content column at desktop widths.
*/}
<div class="my-6 grid grid-cols-[repeat(2,minmax(0,1fr))] gap-4 [@media(max-width:768px)]:grid-cols-[minmax(0,1fr)]">
  {items.map((item) => {
    const href = item.href ?? item.link?.href ?? "#";
    const title = item.title ?? item.label ?? "";
    const description = item.description;
    const icon = item.icon;
    // Old TopicList CardCategory prefixes the description with the
    // category item count ("3 items • desc"); plain doc links show
    // the description as-is.
    const isCategory = item.type === "category" && Array.isArray(item.items);
    const itemsCount = isCategory
      ? `${item.items.length} item${item.items.length === 1 ? "" : "s"}`
      : null;
    const iconHtml = renderDynamicIcon(icon, {
      slug: title,
      fallbackIcon: isCategory ? "md:folder" : "md:notebook",
    });
    return (
      <a
        class="flex min-w-0 flex-col gap-1 rounded-lg border border-border bg-background-alt p-6 text-foreground no-underline hover:border-primary"
        href={href}
      >
        {/*
          The `!` utilities below beat the unlayered
          `overrides/markdown.css` rules (`.porto-markdown h2` /
          `.porto-markdown p`) — this list renders inside the
          `.porto-markdown` slot wrapper, and unlayered CSS beats
          layered utilities. The old scoped rules won on specificity;
          the important flag is what keeps that win.
        */}
        <h2
          class="mt-0! mb-[1.05rem]! inline-flex w-full min-w-0 items-center gap-2 text-[1.4rem]! font-[750]! text-primary"
          title={title}
        >
          <span
            class="inline-flex shrink-0 items-center justify-center empty:hidden"
            set:html={iconHtml}
          />
          <span class="truncate">{title}</span>
        </h2>
        {(itemsCount || description) && (
          <p class="m-0! truncate text-[0.8rem] text-foreground opacity-60">
            {itemsCount && <strong>{itemsCount}</strong>}
            {itemsCount && description && (
              <>
                {" "}
                <span style="opacity: 0.5">•</span> {description}
              </>
            )}
            {!itemsCount && description}
          </p>
        )}
      </a>
    );
  })}
</div>
