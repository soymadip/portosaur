---
// Blog index (`/${blogRoute}`, page 1) — Phase 2 stub.
//
// No h1: post titles render as h2s, newest first, 10 per page. When the
// blog has no posts, a single "No posts yet" heading renders instead
// (the docs site's blog has no posts — only `authors.yml`).
import { getCollection } from "astro:content";
import config from "porto:config";
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  pageTitle,
  blogSlug,
  sortPostsByDateDesc,
} from "../lib/content.mjs";

const siteTitle = config.site.title;
const blogRoute = config.site.blogRoute;
const title = pageTitle("Blog", siteTitle);

const posts = sortPostsByDateDesc(await getCollection("blog")).slice(0, 10);
---

<BaseLayout title={title}>
  {
    posts.length === 0 ? (
      <h2>No posts yet</h2>
    ) : (
      posts.map((post) => (
        <h2>
          <a href={`/${blogRoute}/${blogSlug(post)}/`}>
            {post.data.title ?? post.id}
          </a>
        </h2>
      ))
    )
  }
</BaseLayout>
