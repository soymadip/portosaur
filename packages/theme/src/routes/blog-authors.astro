---
// Blog authors index (`/${blogRoute}/authors`).
//
// One h2 per author, linked to the author page when the author has
// `page: true`, with title and URL beneath (plain text when there is
// no page). Renders nothing but the h1 when `authors.yml` is absent.
import { getCollection } from "astro:content";
import config from "porto:config";
import BaseLayout from "../layouts/BaseLayout.astro";
import { pageTitle } from "../lib/content.ts";

const siteTitle = config.site.title;
const blogRoute = config.site.blogRoute;
const title = pageTitle("Authors", siteTitle);

let authors = [];
try {
  authors = await getCollection("authors");
} catch {
  authors = [];
}
---

<BaseLayout title={title}>
  <div class="mx-auto flex w-full max-w-7xl flex-col gap-6 p-4">
    <h1 class="mb-[-0.5rem]">Authors</h1>
    {authors.length === 0 ? (
      <p class="text-muted">No authors yet.</p>
    ) : (
      authors.map((author) => {
        const name = author.data.name ?? author.id;
        const hasPage = author.data.page === true;
        return (
          <section>
            <h2 class="mb-1">
              {hasPage ? (
                <a
                  class="text-foreground no-underline hover:text-primary"
                  href={`/${blogRoute}/authors/${author.id}/`}
                >
                  {name}
                </a>
              ) : (
                name
              )}
            </h2>
            {author.data.title && (
              <p class="m-0 text-muted">{author.data.title}</p>
            )}
            {author.data.url && (
              <p class="mt-1">
                <a
                  class="text-primary no-underline hover:underline"
                  href={author.data.url}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {author.data.url}
                </a>
              </p>
            )}
          </section>
        );
      })
    )}
  </div>
</BaseLayout>
