---
// Blog author page (`/${blogRoute}/authors/[author]`).
//
// One page per author with `page: true` in `authors.yml`, listing their
// posts newest first. Authors without a page are not routed here (the
// Docusaurus rule: only `page: true` authors get a detail page). A
// post matches an author by the author key (string refs) or by the
// inline `key` property.
import { getCollection } from "astro:content";
import config from "porto:config";
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  pageTitle,
  blogSlug,
  postDate,
  sortPostsByDateDesc,
} from "../lib/content.ts";

export async function getStaticPaths() {
  let authors;
  try {
    authors = await getCollection("authors");
  } catch {
    return [];
  }
  const posts = sortPostsByDateDesc(await getCollection("blog"));
  return authors
    .filter((author) => author.data.page === true)
    .map((author) => {
      const key = author.id;
      const authorPosts = posts.filter((post) =>
        (post.data.authors ?? []).some((ref) =>
          typeof ref === "string" ? ref === key : ref?.key === key,
        ),
      );
      return {
        params: { author: key },
        props: { author, posts: authorPosts },
      };
    });
}

const { author, posts } = Astro.props;
const siteTitle = config.site.title;
const blogRoute = config.site.blogRoute;
const name = author.data.name ?? author.id;
const title = pageTitle(name, siteTitle);

function formatPostDate(date) {
  return date.toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
}
---

<BaseLayout title={title}>
  <div class="porto-blog-list">
    <header>
      <h1>{name}</h1>
      {author.data.title && (
        <p class="porto-blog-author__title">{author.data.title}</p>
      )}
      {author.data.url && (
        <p class="porto-blog-author__url">
          <a href={author.data.url} target="_blank" rel="noopener noreferrer">
            {author.data.url}
          </a>
        </p>
      )}
    </header>
    {posts.length === 0 ? (
      <p class="porto-blog-author__empty">No posts by this author yet.</p>
    ) : (
      posts.map((post) => {
        const date = postDate(post);
        return (
          <article class="porto-blog-item">
            <h2>
              <a href={`/${blogRoute}/${blogSlug(post)}/`}>
                {post.data.title ?? post.id}
              </a>
            </h2>
            <div class="porto-blog-meta">
              {date && (
                <time datetime={date.toISOString()}>
                  {formatPostDate(date)}
                </time>
              )}
            </div>
            {post.data.description && (
              <p class="porto-blog-desc">{post.data.description}</p>
            )}
          </article>
        );
      })
    )}
  </div>
</BaseLayout>

<style>
  .porto-blog-list {
    max-width: 80rem;
    width: 100%;
    margin: 0 auto;
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .porto-blog-list header {
    margin-bottom: -1rem;
  }

  .porto-blog-list header h1 {
    margin-bottom: 0.25rem;
  }

  .porto-blog-author__title {
    color: var(--porto-text-muted);
    margin: 0;
  }

  .porto-blog-author__url {
    margin: 0.25rem 0 0;
  }

  .porto-blog-author__url a {
    color: var(--porto-primary);
    text-decoration: none;
  }

  .porto-blog-author__url a:hover {
    text-decoration: underline;
  }

  .porto-blog-author__empty {
    color: var(--porto-text-muted);
  }

  .porto-blog-item h2 {
    margin: 0 0 0.5rem;
    font-size: 1.8rem;
  }

  .porto-blog-item h2 a {
    color: var(--porto-text);
    text-decoration: none;
  }

  .porto-blog-item h2 a:hover {
    color: var(--porto-primary);
  }

  .porto-blog-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    color: var(--porto-text-muted);
    font-size: 0.9rem;
    margin-bottom: 0.5rem;
  }

  .porto-blog-desc {
    color: var(--porto-text-muted);
    margin: 0 0 0.5rem;
  }
</style>
