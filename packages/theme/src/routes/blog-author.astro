---
// Blog author page (`/${blogRoute}/authors/[author]`) — Phase 2 stub.
//
// Generated only for authors with `page: true` in `authors.yml` — the
// golden builds have no author detail pages (neither site's authors set
// `page`), so generating any would add routes the snapshot does not
// expect. The author's posts render as h2s, newest first.
import { getCollection } from "astro:content";
import config from "porto:config";
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  pageTitle,
  blogSlug,
  sortPostsByDateDesc,
} from "../lib/content.mjs";

export async function getStaticPaths() {
  let authors = [];
  try {
    authors = await getCollection("authors");
  } catch {
    authors = [];
  }
  const posts = await getCollection("blog");

  return authors
    .filter((author) => author.data.page === true)
    .map((author) => {
      const own = posts.filter((post) =>
        (post.data.authors ?? []).some((ref) => {
          if (typeof ref === "string") {
            return ref === author.id;
          }
          return ref?.key === author.id || ref?.name === author.data.name;
        }),
      );
      return {
        params: { author: author.id },
        props: { author, posts: sortPostsByDateDesc(own) },
      };
    });
}

const { author, posts } = Astro.props;
const siteTitle = config.site.title;
const blogRoute = config.site.blogRoute;
const heading = author.data.name ?? author.id;
const title = pageTitle(heading, siteTitle);
---

<BaseLayout title={title}>
  <h1>{heading}</h1>
  {
    posts.map((post) => (
      <h2>
        <a href={`/${blogRoute}/${blogSlug(post)}/`}>
          {post.data.title ?? post.id}
        </a>
      </h2>
    ))
  }
</BaseLayout>
