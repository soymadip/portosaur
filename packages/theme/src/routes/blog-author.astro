---
// Blog author page (`/${blogRoute}/authors/[author]`).
//
// One page per author with `page: true` in `authors.yml`, listing their
// posts newest first. Authors without a page are not routed here (the
// Docusaurus rule: only `page: true` authors get a detail page). A
// post matches an author by the author key (string refs) or by the
// inline `key` property.
import { getCollection } from "astro:content";
import config from "porto:config";
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  pageTitle,
  blogSlug,
  postDate,
  sortPostsByDateDesc,
} from "../lib/content.ts";

export async function getStaticPaths() {
  let authors;
  try {
    authors = await getCollection("authors");
  } catch {
    return [];
  }
  const posts = sortPostsByDateDesc(await getCollection("blog"));
  return authors
    .filter((author) => author.data.page === true)
    .map((author) => {
      const key = author.id;
      const authorPosts = posts.filter((post) =>
        (post.data.authors ?? []).some((ref) =>
          typeof ref === "string" ? ref === key : ref?.key === key,
        ),
      );
      return {
        params: { author: key },
        props: { author, posts: authorPosts },
      };
    });
}

const { author, posts } = Astro.props;
const siteTitle = config.site.title;
const blogRoute = config.site.blogRoute;
const name = author.data.name ?? author.id;
const title = pageTitle(name, siteTitle);

function formatPostDate(date) {
  return date.toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
}
---

<BaseLayout title={title}>
  <div class="mx-auto flex w-full max-w-7xl flex-col gap-10 p-4">
    <header class="mb-[-1rem]">
      <h1 class="mb-1">{name}</h1>
      {author.data.title && <p class="m-0 text-muted">{author.data.title}</p>}
      {author.data.url && (
        <p class="mt-1">
          <a
            class="text-primary no-underline hover:underline"
            href={author.data.url}
            target="_blank"
            rel="noopener noreferrer"
          >
            {author.data.url}
          </a>
        </p>
      )}
    </header>
    {posts.length === 0 ? (
      <p class="text-muted">No posts by this author yet.</p>
    ) : (
      posts.map((post) => {
        const date = postDate(post);
        return (
          <article>
            <h2 class="mb-2 text-[1.8rem]">
              <a
                class="text-foreground no-underline hover:text-primary"
                href={`/${blogRoute}/${blogSlug(post)}/`}
              >
                {post.data.title ?? post.id}
              </a>
            </h2>
            <div class="mb-2 flex flex-wrap gap-x-4 gap-y-1 text-[0.9rem] text-muted">
              {date && (
                <time datetime={date.toISOString()}>
                  {formatPostDate(date)}
                </time>
              )}
            </div>
            {post.data.description && (
              <p class="mb-2 text-muted">{post.data.description}</p>
            )}
          </article>
        );
      })
    )}
  </div>
</BaseLayout>
