---
// Note/doc detail page (`/${notesRoute}/[...slug]`) — Phase 2 stub.
//
// Renders the frontmatter title as h1, the full MDX content, then the
// automatic topic list (after the content, like the Docusaurus
// `DocItem/Content` wrapper) on index pages where the topic list is
// enabled. The root index (empty slug) has no `[...slug]` page — its
// content renders at the notes index route.
import { getCollection, render } from "astro:content";
import config from "porto:config";
import sidebar from "porto:sidebar";
import BaseLayout from "../layouts/BaseLayout.astro";
import { mdxComponents } from "../components/mdx/index.mjs";
import {
  pageTitle,
  docTitle,
  withSlugs,
  topicListShouldRender,
  findCategoryItems,
  topicCardTitle,
} from "../lib/content.mjs";

export async function getStaticPaths() {
  const notes = await getCollection("notes");
  return withSlugs(notes)
    .filter((item) => item.slug !== "")
    .map((item) => ({
      params: { slug: item.slug },
      props: { entry: item.entry, slug: item.slug },
    }));
}

const { entry, slug } = Astro.props;
const { Content } = await render(entry);

const siteTitle = config.site.title;
const notesRoute = config.site.notesRoute;
const heading = docTitle(entry);
const title = pageTitle(heading, siteTitle);

const showTopicList = topicListShouldRender(entry, config);
const items = showTopicList
  ? findCategoryItems(sidebar, `/${notesRoute}/${slug}`)
  : [];
---

<BaseLayout title={title} description={entry.data.description}>
  <h1>{heading}</h1>
  <Content components={mdxComponents} />
  {
    items.length > 0 && (
      <section class="topic-list">
        {items.map((item) => (
          <h2>
            <a href={item.href ?? item.link?.href ?? "#"}>
              {topicCardTitle(item)}
            </a>
          </h2>
        ))}
      </section>
    )
  }
</BaseLayout>
