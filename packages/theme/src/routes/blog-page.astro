---
// Blog pagination (`/${blogRoute}/page/[page]`, pages 2+).
//
// Same rendering as the blog index, for the page's slice of posts.
// Docusaurus URLs are `/blog/page/N` (not Astro `paginate`'s `/blog/N`),
// so pagination is manual.
//
// Dates resolve here in `getStaticPaths` (frontmatter `date` → git
// date → mtime, the same chain as the index) so page slicing follows
// resolved dates; the resolved dates ride along as props, since
// `getStaticPaths` runs in its own module scope and cannot see the
// frontmatter helpers.
import { getCollection } from "astro:content";
import { createMarkdownProcessor } from "@astrojs/markdown-remark";
import config from "porto:config";
import BaseLayout from "../layouts/BaseLayout.astro";
import BlogSidebar from "../components/BlogSidebar.astro";
import NotifyButton from "../components/NotifyButton.astro";
import { pageTitle, blogSlug, postDate } from "../lib/content.mjs";
import { portosaurMdxOptions } from "../mdx.mjs";

const PAGE_SIZE = 10;

export async function getStaticPaths() {
  // NOTE: `getStaticPaths` runs in its own module scope — frontmatter
  // constants are not visible here, so the page size is local.
  const LOCAL_PAGE_SIZE = 10;

  const datedPosts = (await getCollection("blog"))
    .map((post) => ({ post, date: postDate(post) }))
    .sort((a, b) => {
      if (a.date && b.date) {
        return b.date.getTime() - a.date.getTime();
      }
      if (a.date) {
        return -1;
      }
      if (b.date) {
        return 1;
      }
      return a.post.id.localeCompare(b.post.id);
    });

  const pageCount = Math.ceil(datedPosts.length / LOCAL_PAGE_SIZE);
  const blogRoute = config.site.blogRoute;

  // Sidebar data is the same on every page — resolved once here.
  const sidebarPosts = datedPosts.map(({ post, date }) => ({
    url: `/${blogRoute}/${blogSlug(post)}/`,
    title: post.data.title ?? post.id,
    date: date ? date.toISOString() : null,
  }));

  const paths = [];
  for (let page = 2; page <= pageCount; page++) {
    const slice = datedPosts.slice(
      (page - 1) * LOCAL_PAGE_SIZE,
      page * LOCAL_PAGE_SIZE,
    );
    paths.push({
      params: { page: String(page) },
      props: {
        posts: slice.map(({ post }) => post),
        dates: slice.map(({ date }) => (date ? date.toISOString() : null)),
        sidebarPosts,
        page,
        pageCount,
      },
    });
  }
  return paths;
}

const {
  posts,
  dates,
  sidebarPosts: sidebarPostProps,
  page,
  pageCount,
} = Astro.props;
const siteTitle = config.site.title;
const blogRoute = config.site.blogRoute;
const title = pageTitle("Blog", siteTitle);

const showNotify = config.site.pwa?.enable && config.site.pwa?.notifications;

async function loadAuthors() {
  try {
    return await getCollection("authors");
  } catch {
    return [];
  }
}

function resolveAuthor(ref, authors) {
  if (typeof ref === "string") {
    const found = authors.find((author) => author.id === ref);
    if (found) {
      return {
        key: found.id,
        name: found.data.name ?? found.id,
        title: found.data.title,
        url: found.data.url,
        hasPage: found.data.page === true,
      };
    }
    return {
      key: ref,
      name: ref,
      title: undefined,
      url: undefined,
      hasPage: false,
    };
  }
  const key = ref?.key;
  const found = key ? authors.find((author) => author.id === key) : undefined;
  if (found) {
    return {
      key: found.id,
      name: ref.name ?? found.data.name ?? found.id,
      title: ref.title ?? found.data.title,
      url: ref.url ?? found.data.url,
      hasPage: found.data.page === true,
    };
  }
  return {
    key: key ?? ref?.name ?? "",
    name: ref?.name ?? key ?? "",
    title: ref?.title,
    url: ref?.url,
    hasPage: false,
  };
}

function formatPostDate(date) {
  return date.toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
}

// The Docusaurus truncate marker, either form (`{/* truncate */}` in
// MDX, `<!-- truncate -->` in Markdown), tolerating inner whitespace.
const TRUNCATE_PATTERN = /\{\/\*\s*truncate\s*\*\/\}|<!--\s*truncate\s*-->/;

function splitExcerpt(body) {
  const match = TRUNCATE_PATTERN.exec(body ?? "");
  if (!match) {
    return { excerpt: null, truncated: false };
  }
  return { excerpt: body.slice(0, match.index), truncated: true };
}

const authors = await loadAuthors();
const sidebarPosts = sidebarPostProps.map((post) => ({
  ...post,
  date: post.date ? new Date(post.date) : null,
}));

// Excerpts render through the site's own remark/rehype plugin list
// (same options as the integration's markdown processor, Shiki themes
// included) — but the processor is only built when some post on this
// page actually has a truncate marker. No `fileURL` is passed to
// `render`: without one, Astro's image collection stays off and
// excerpt images keep their original `src` instead of being rewritten
// into unprocessed `__ASTRO_IMAGE_` blobs. A render failure falls back
// to the description, never failing the page.
const splits = posts.map((post) => splitExcerpt(post.body));
let excerptRenderer = null;
if (splits.some((split) => split.truncated)) {
  const mdxOptions = portosaurMdxOptions({
    userVars: config.userVars ?? {},
    colorScheme: config.theme?.colorScheme,
  });
  excerptRenderer = await createMarkdownProcessor({
    remarkPlugins: mdxOptions.remarkPlugins,
    rehypePlugins: mdxOptions.rehypePlugins,
    shikiConfig: mdxOptions.shikiConfig,
  });
}

async function renderExcerpt(excerpt) {
  if (!excerptRenderer) {
    return null;
  }
  try {
    const { code } = await excerptRenderer.render(excerpt);
    return code;
  } catch {
    return null;
  }
}

const viewPosts = await Promise.all(
  posts.map(async (post, index) => {
    const split = splits[index];
    const excerptHtml = split.truncated
      ? await renderExcerpt(split.excerpt)
      : null;
    return {
      url: `/${blogRoute}/${blogSlug(post)}/`,
      title: post.data.title ?? post.id,
      date: dates[index] ? new Date(dates[index]) : null,
      description: post.data.description,
      excerptHtml,
      truncated: split.truncated,
      authors: (post.data.authors ?? []).map((ref) =>
        resolveAuthor(ref, authors),
      ),
      tags: post.data.tags ?? [],
    };
  }),
);

// The previous page of page 2 is the blog index itself.
const prevUrl =
  page === 2 ? `/${blogRoute}/` : `/${blogRoute}/page/${page - 1}/`;
const nextUrl = page < pageCount ? `/${blogRoute}/page/${page + 1}/` : null;
---

<BaseLayout title={title}>
  <div class="porto-blog-layout">
    <BlogSidebar posts={sidebarPosts} />
    <div class="porto-blog-list">
      {showNotify && <NotifyButton />}
      {viewPosts.map((post) => (
        <article class="porto-blog-item">
          <h2>
            <a href={post.url}>{post.title}</a>
          </h2>
          <div class="porto-blog-meta">
            {post.date && (
              <time datetime={post.date.toISOString()}>
                {formatPostDate(post.date)}
              </time>
            )}
            {post.authors.length > 0 && (
              <div class="porto-blog-authors">
                {post.authors.map((author) => (
                  <div class="porto-blog-author">
                    {author.hasPage ? (
                      <a href={`/${blogRoute}/authors/${author.key}/`}>
                        {author.name}
                      </a>
                    ) : author.url ? (
                      <a
                        href={author.url}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        {author.name}
                      </a>
                    ) : (
                      <span class="porto-blog-author__name">{author.name}</span>
                    )}
                    {author.title && (
                      <div class="porto-blog-author__title">{author.title}</div>
                    )}
                  </div>
                ))}
              </div>
            )}
          </div>
          {post.excerptHtml ? (
            <div class="porto-blog-excerpt" set:html={post.excerptHtml} />
          ) : post.description ? (
            <p class="porto-blog-desc">{post.description}</p>
          ) : null}
          {(post.tags.length > 0 || post.truncated) && (
            <div class="porto-blog-item__footer">
              {post.tags.length > 0 && (
                <ul class="porto-blog-tags">
                  {post.tags.map((tag) => (
                    <li>
                      <a href={`/${blogRoute}/tags/${tag}/`}>{tag}</a>
                    </li>
                  ))}
                </ul>
              )}
              {post.truncated && (
                <a class="porto-blog-read-more" href={post.url}>
                  Read more
                </a>
              )}
            </div>
          )}
        </article>
      ))}
      <nav class="porto-blog-paginator" aria-label="Blog pages">
        <a
          class="porto-blog-paginator__link porto-blog-paginator__link--prev"
          href={prevUrl}
          rel="prev"
        >
          Newer
        </a>
        {nextUrl ? (
          <a
            class="porto-blog-paginator__link porto-blog-paginator__link--next"
            href={nextUrl}
            rel="next"
          >
            Older
          </a>
        ) : (
          <span />
        )}
      </nav>
    </div>
  </div>
</BaseLayout>

<style>
  .porto-blog-layout {
    max-width: 80rem;
    width: 100%;
    margin: 0 auto;
    padding: 1rem;
    display: flex;
    gap: 2rem;
  }

  .porto-blog-list {
    flex: 1 1 0;
    min-width: 0;
    max-width: 46rem;
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .porto-blog-item h2 {
    margin: 0 0 0.5rem;
    font-size: 2rem;
  }

  .porto-blog-item h2 a {
    color: var(--porto-primary);
    text-decoration: none;
  }

  .porto-blog-item h2 a:hover {
    text-decoration: underline;
  }

  .porto-blog-meta {
    margin-bottom: 0.75rem;
  }

  .porto-blog-meta time {
    color: var(--porto-text);
    font-size: 0.9rem;
  }

  .porto-blog-meta a {
    color: var(--porto-primary);
    text-decoration: none;
  }

  .porto-blog-meta a:hover {
    text-decoration: underline;
  }

  .porto-blog-authors {
    margin-top: 0.75rem;
  }

  .porto-blog-author {
    margin-bottom: 0.25rem;
  }

  .porto-blog-author a,
  .porto-blog-author__name {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--porto-primary);
  }

  .porto-blog-author__title {
    font-size: 0.85rem;
    color: var(--porto-text-muted);
  }

  .porto-blog-desc {
    color: var(--porto-text-muted);
    margin: 0 0 0.5rem;
  }

  .porto-blog-excerpt {
    margin-bottom: 0.5rem;
  }

  .porto-blog-excerpt p,
  .porto-blog-excerpt ul,
  .porto-blog-excerpt ol,
  .porto-blog-excerpt pre {
    margin: 0 0 1rem;
  }

  .porto-blog-excerpt > *:last-child {
    margin-bottom: 0;
  }

  .porto-blog-item__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .porto-blog-read-more {
    margin-left: auto;
    color: var(--porto-primary);
    text-decoration: none;
    font-weight: bold;
    white-space: nowrap;
  }

  .porto-blog-read-more:hover {
    text-decoration: underline;
  }

  .porto-blog-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .porto-blog-tags a {
    display: inline-block;
    padding: 0.15rem 0.6rem;
    color: var(--porto-text-muted);
    text-decoration: none;
    border: 1px solid var(--porto-border);
    border-radius: 999px;
    font-size: 0.8rem;
  }

  .porto-blog-tags a:hover {
    color: var(--porto-primary);
    border-color: var(--porto-primary);
  }

  .porto-blog-paginator {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 1rem;
  }

  .porto-blog-paginator__link {
    padding: 0.6rem 1.2rem;
    color: var(--porto-text);
    text-decoration: none;
    border: 1px solid var(--porto-border);
    border-radius: 0.5rem;
  }

  .porto-blog-paginator__link:hover {
    border-color: var(--porto-primary);
    color: var(--porto-primary);
  }

  @media (max-width: 996px) {
    .porto-blog-list {
      max-width: none;
    }
  }
</style>
