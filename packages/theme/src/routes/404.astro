---
// 404 page (`/404`) — port of the old swizzled NotFound component.
// Astro emits this as `404.html`. Empty-state layout in Tailwind
// utilities (the old shared empty-state styles are inlined), crying
// emoji icon, "Go back home" link.
import config from "porto:config";
import BaseLayout from "../layouts/BaseLayout.astro";
import { pageTitle } from "../lib/content.ts";
import { renderIcon } from "../lib/icons.ts";

const title = pageTitle("Page Not Found", config.site.title);
---

<BaseLayout title={title} description="Page not found">
  <div class="flex min-h-[calc(100vh-var(--navbar-height)-100px)] flex-col items-center justify-center p-8 text-center">
    <div class="text-[4.5rem] text-muted opacity-60">
      <span set:html={renderIcon("line-md:emoji-cry", { size: "5rem" })} />
    </div>
    <h2 class="mt-[-0.8rem] mb-4 text-[2.2rem] text-foreground">
      Page Not Found
    </h2>
    <p class="max-w-[500px] text-[1.1rem] text-muted">
      The page you're looking for doesn't exist, has been moved, or is currently
      unavailable.
    </p>
    <a
      class="mt-6 inline-flex cursor-pointer items-center gap-2 rounded-full border-0 bg-primary px-[1.4rem] py-[0.6rem] text-base leading-(--line-height) font-semibold text-[#09090b] no-underline transition-[background-color_0.2s_ease,transform_0.2s_ease] hover:-translate-y-0.5 hover:bg-primary-light hover:shadow-md"
      href="/"
    >
      Go back home
    </a>
  </div>
</BaseLayout>
