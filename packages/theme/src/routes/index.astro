---
// Home page (`/`).
//
// Portfolio mode renders the hero + the enabled sections (About,
// Projects, Experience, Contact) with section ids for the title updater;
// docs mode renders the docs landing. The golden headings pin the exact
// texts and order — the hero h1 (title + comma), the profession h2, and
// one h2 per enabled section heading (docs mode: one h2 per feature).
//
// The inline script wires the shared `update-title` module (document
// title + hash follow the most-visible section) and imports the shared
// `scroll-reveal` module (auto-inits: toggles `is-visible` on the
// `data-reveal` sections). The scroll button is the full NavArrow
// component (next-section / back-to-top), ported from the old theme.
//
// The old page also hid the navbar shadow and the brand in landscape via
// Docusaurus navbar classes; those rules cannot port until the new
// navbar's classes exist, so they are dropped here.
import config from "porto:config";
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroSection from "../components/sections/HeroSection.astro";
import AboutSection from "../components/sections/AboutSection.astro";
import ProjectsSection from "../components/sections/ProjectsSection.astro";
import ExperienceSection from "../components/sections/ExperienceSection.astro";
import ContactSection from "../components/sections/ContactSection.astro";
import DocsHomeSection from "../components/sections/DocsHomeSection.astro";
import NavArrow from "../components/NavArrow.astro";
import { pageTitle } from "../lib/content.ts";

const siteTitle = config.site.title;
const isDocs = config.siteMode === "docs";

const title = pageTitle(isDocs ? "Home" : "Me", siteTitle);

const hero = config.homePage.heroSection;
const about = config.homePage.aboutSection;
const shelf = config.homePage.projectShelf;
const experience = config.homePage.experienceSection;
const social = config.homePage.socialSection;

// Section titles for the title updater (old pages/index.jsx map).
const sectionTitles = {
  me: `Home | ${siteTitle}`,
  about: `About Me | ${siteTitle}`,
  projects: `Projects | ${siteTitle}`,
  experience: `Experience | ${siteTitle}`,
  contact: `Contact | ${siteTitle}`,
};
---

<BaseLayout
  title={title}
  description={isDocs ? config.site.tagline : "My portfolio website"}
>
  {isDocs ? (
    <DocsHomeSection />
  ) : (
    <>
      <HeroSection id="me" />
      {about.enable && <AboutSection id="about" />}
      {shelf.enable && <ProjectsSection id="projects" />}
      {experience.enable && <ExperienceSection id="experience" />}
      {social.enable && <ContactSection id="contact" />}
      <NavArrow />
      <script define:vars={{ sectionTitles, defaultTitle: siteTitle }}>
        import { initUpdateTitle } from "../scripts/update-title.ts";
        // Auto-inits on import: toggles `is-visible` on [data-reveal].
        import "../scripts/scroll-reveal.ts";

        initUpdateTitle({ sections: sectionTitles, defaultTitle });
      </script>
    </>
  )}
</BaseLayout>
